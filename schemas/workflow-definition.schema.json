{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/workflow-definition.schema.json",
  "title": "Singularity Flow YAML workflow definition",
  "type": "object",
  "required": ["version", "git", "templatesRoot", "workTypes", "phases"],
  "properties": {
    "version": { "const": 2 },
    "auto": { "$ref": "#/$defs/autoPolicy" },
    "inputsMode": { "enum": ["off", "record", "enforce"], "default": "off" },
    "noModel": {
      "type": "object",
      "properties": {
        "unknownExternalCommands": { "enum": ["warn", "block"], "default": "warn" }
      },
      "additionalProperties": false
    },
    "codeDelivery": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 2 },
        "mode": { "const": "enforce" },
        "generationBoundary": {
          "type": "object",
          "properties": { "requireBegin": { "type": "boolean" }, "dirtyStart": { "enum": ["block", "allow-explicit-adoption"] } },
          "additionalProperties": false
        },
        "changeSet": {
          "type": "object",
          "properties": {
            "renameDetection": { "const": "required" },
            "includeCommitted": { "const": true }, "includeIndex": { "const": true },
            "includeWorktree": { "const": true }, "includeUntracked": { "const": true },
            "symlinks": { "enum": ["reject", "record-link-only"] }
          },
          "additionalProperties": false
        },
        "tests": {
          "type": "object",
          "properties": {
            "requireExecutableSource": { "const": true },
            "minimumDiscovered": { "type": "integer", "minimum": 1 },
            "minimumPassed": { "type": "integer", "minimum": 1 },
            "executionAssurance": { "enum": ["module", "testcase-exact"] },
            "stringCommands": { "const": "reject" },
            "unknownModelPolicy": { "const": "block" },
            "requireResultAdapter": { "const": true },
            "requireAffectedModuleCoverage": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "traceability": {
          "type": "object",
          "properties": {
            "source": { "const": "pinned-spec-index" },
            "requireNamespaceQualifiedIds": { "type": "boolean" },
            "bareIdCompatibility": { "const": "unique-only" }
          },
          "additionalProperties": false
        },
        "publication": { "type": "object", "properties": { "idempotency": { "const": "generation-intent" } }, "additionalProperties": false },
        "display": {
          "type": "object",
          "properties": {
            "source": { "const": "reference-preview" },
            "previewBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "fullDocumentMaximumBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
          },
          "additionalProperties": false
        },
        "model": { "type": "object", "properties": { "minimumAssurance": { "enum": ["unavailable", "observed", "provider-reported", "policy-selected"] } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "defaultProvider": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "providers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["copilot-cli"] },
              "executable": { "type": "string", "minLength": 1 },
              "arguments": { "type": "array", "items": { "type": "string" } },
              "model": { "type": "string", "minLength": 1 },
              "promptTransport": {
                "enum": ["auto", "acp-stdio", "attachment"],
                "default": "auto"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "harnessImports": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["off", "record", "enforce"], "default": "off" },
        "previewTextBytes": { "type": "integer", "minimum": 1, "maximum": 65536, "default": 16384 },
        "totalEnvelopeBytes": { "type": "integer", "minimum": 1024, "maximum": 65536, "default": 32768 },
        "knowledge": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean", "default": false }, "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 65536, "default": 8192 } },
          "additionalProperties": false
        },
        "conformance": {
          "type": "object",
          "properties": {
            "verbatimRelay": { "enum": ["off", "observe", "warn", "enforce"] },
            "questionPrecedesMutation": { "enum": ["off", "observe", "warn", "enforce"] },
            "maximumActions": { "enum": ["off", "observe", "warn", "enforce"] },
            "previewRespected": { "enum": ["off", "observe", "warn", "enforce"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sequenceGates": { "$ref": "#/$defs/sequenceGates" },
    "contextPolicy": { "$ref": "#/$defs/contextPolicy" },
    "defaultBaseBranch": { "type": "string", "minLength": 1 },
    "workItemRoot": { "type": "string", "minLength": 1 },
    "idPattern": { "type": "string", "minLength": 1 },
    "git": {
      "type": "object",
      "required": ["remote", "publish"],
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "publish": { "enum": ["required", "off"] }
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "branch": { "type": "string", "minLength": 1, "default": "state" },
        "publication": { "enum": ["off", "warn", "required"], "default": "warn" },
        "remote": { "type": "string", "minLength": 1, "default": "origin" },
        "behind": { "enum": ["warn", "block"], "default": "warn" },
        "enforcement": { "enum": ["shadow", "required"], "default": "shadow" },
        "signing": { "enum": ["off", "commit"], "default": "off" },
        "trustTier": { "enum": ["T0", "T1", "T2", "T3"], "default": "T0" },
        "maxRetries": { "type": "integer", "minimum": 1, "maximum": 20, "default": 4 },
        "pinTransport": { "enum": ["refs", "branches", "none"], "default": "refs" },
        "retentionDays": { "type": "integer", "minimum": 0, "maximum": 36500, "default": 2555 }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["off", "record", "enforce"], "default": "off" },
        "namespace": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$" },
        "coverage": { "enum": ["off", "record", "enforce"], "default": "off" },
        "acceptance": { "enum": ["off", "presence", "test-first", "verify"], "default": "off" },
        "compositionCache": { "enum": ["off", "local"], "default": "local" },
        "testCommands": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "excludes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "limits": {
          "type": "object",
          "properties": {
            "maxClausesPerArtifact": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxDependenciesPerClause": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maxPathsPerClaim": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxClaimBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "faultRepair": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
        "maxMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 20 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 10000000, "default": 30000 },
        "maximumInlineEvidenceBytes": { "type": "integer", "minimum": 1, "maximum": 65536, "default": 16384 },
        "maximumEvidenceBytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824, "default": 67108864 },
        "leaseMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 60 },
        "boundedAuto": { "type": "boolean", "default": false },
        "environmentCeilings": {
          "type": "object",
          "properties": {
            "local": { "enum": ["record", "diagnose", "propose", "guided", "bounded-auto"] },
            "ide": { "enum": ["record", "diagnose", "propose", "guided", "bounded-auto"] },
            "copilot": { "enum": ["record", "diagnose", "propose", "guided", "bounded-auto"] },
            "ci": { "enum": ["record", "diagnose", "propose", "guided", "bounded-auto"] },
            "integration": { "enum": ["record", "diagnose", "propose", "guided", "bounded-auto"] },
            "staging": { "enum": ["record", "diagnose", "propose", "guided", "bounded-auto"] },
            "production": { "enum": ["record", "diagnose", "propose", "guided", "bounded-auto"] }
          },
          "additionalProperties": false
        },
        "protectedPaths": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "templatesRoot": { "type": "string", "minLength": 1 },
    "planning": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "promptSource": { "type": "string", "minLength": 1 },
        "maxContextBytes": { "type": "integer", "minimum": 16384, "maximum": 10485760 }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "mode": { "const": "exact-or-unavailable" },
        "pricing": {
          "type": "object",
          "description": "Optional per-million-token prices keyed by exact provider model name. No prices are assumed by default.",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "input": { "type": "number", "minimum": 0 },
              "output": { "type": "number", "minimum": 0 },
              "cachedInput": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "tokenEconomy": { "$ref": "#/$defs/tokenEconomy" },
    "documents": {
      "type": "object",
      "properties": {
        "allowedPhases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "maxFileBytes": { "type": "integer", "minimum": 1 },
        "maxPreviewBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "collaboration": {
      "type": "object",
      "properties": {
        "assignmentMode": { "enum": ["off", "suggested", "required"] },
        "approvalReminderAfterHours": { "type": "number", "minimum": 0 },
        "notifications": { "type": "array", "uniqueItems": true, "items": { "enum": ["terminal", "teams-webhook"] } }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "workItemSelection": { "enum": ["off", "reuse", "prompt"] },
        "requireBeforeTools": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "approvalSecurity": {
      "type": "object",
      "properties": {
        "profile": { "enum": ["poc", "team", "regulated"] },
        "allowSelfApproval": { "type": "boolean" },
        "autoEnrollNewIdentities": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "approvalAuthorities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "allowAnyGitIdentity": { "type": "boolean" },
          "githubTeams": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^@[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string" },
                "githubLogin": { "type": "string" }
              },
              "anyOf": [
                { "required": ["email"] },
                { "required": ["githubLogin"] }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "workTypes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "phases"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "phases": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "intelligence": { "$ref": "#/$defs/workTypeIntelligence" },
          "auto": { "$ref": "#/$defs/autoWorkTypePolicy" },
          "plannedClaims": { "$ref": "#/$defs/plannedClaimsPolicy" },
          "templateOverrides": { "type": "object", "additionalProperties": { "type": "string" } },
          "phaseOverrides": {
            "type": "object",
            "description": "Per-profile overrides for artifact, qualityCommands, worldModel, comparison, approval, or other phase fields.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "inputs": { "$ref": "#/$defs/phaseInputs" },
                "clarification": { "$ref": "#/$defs/clarificationPolicy" }
              }
            }
          },
          "sequenceGates": { "$ref": "#/$defs/sequenceGates" },
          "designSources": { "$ref": "#/$defs/designSourcePolicy" },
          "verification": { "$ref": "#/$defs/verificationPolicy" }
        },
        "additionalProperties": true
      }
    },
    "phases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "writeScope": { "enum": ["artifact-only", "source-and-artifact"] },
          "sourceBoundary": { "enum": ["unrestricted", "test-automation"] },
          "artifact": { "$ref": "#/$defs/artifactContract" },
          "inputs": { "$ref": "#/$defs/phaseInputs" },
          "clarification": { "$ref": "#/$defs/clarificationPolicy" },
          "generation": { "$ref": "#/$defs/generationPolicy" },
          "mcp": { "$ref": "#/$defs/phaseMcpPolicy" },
          "repairBudget": { "$ref": "#/$defs/repairBudget" },
          "qualityCommands": {
            "type": "array",
            "items": { "$ref": "#/$defs/qualityCommand" }
          },
          "approval": { "$ref": "#/$defs/approvalPolicy" }
        }
      }
    },
    "governance": { "type": "object" },
    "mcpServers": {
      "type": "object",
      "description": "Governed references to MCP servers configured by the Copilot or VS Code host. Credentials and transport details never belong here.",
      "additionalProperties": { "$ref": "#/$defs/mcpServer" }
    },
    "ast": {
      "type": "object",
      "description": "Optional bounded structural intelligence. Compiler adapters are external to the kernel.",
      "properties": {
        "mode": { "enum": ["auto", "off"], "default": "auto" },
        "fallback": { "enum": ["host-and-text", "text-only"], "default": "host-and-text" },
        "evidence": {
          "type": "object",
          "description": "Durability and logical content-addressed store for recorded structural context and gates.",
          "properties": {
            "mode": { "enum": ["replayable", "identified", "off"], "default": "identified" },
            "store": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "default": "local-directory" }
          },
          "additionalProperties": false
        },
        "generatedRoots": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRoot" }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "maxFiles": { "type": "integer", "minimum": 1, "default": 500 },
            "maxBytes": { "type": "integer", "minimum": 1, "default": 20971520 },
            "maxFileBytes": { "type": "integer", "minimum": 1, "default": 2097152 }
          },
          "additionalProperties": false
        },
        "languages": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["auto", "off"], "default": "auto" },
              "minimumAssurance": { "enum": ["text", "syntax", "semantic"], "default": "text" }
            },
            "additionalProperties": false
          }
        },
        "predicates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["required", "advisory"], "default": "advisory" },
              "type": { "enum": ["path-exists", "symbol-exists"] },
              "path": { "type": "string" },
              "symbol": { "type": "string" },
              "minimumAssurance": { "enum": ["text", "syntax", "semantic"], "default": "text" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "worldModel": {
      "type": "object",
      "properties": {
        "format": { "enum": ["legacy-v3", "registered-v4"], "default": "legacy-v3", "description": "registered-v4 uses deterministic registered facts and kernel-owned provenance; legacy-v3 remains readable only for compatibility." },
        "views": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?:@[1-9][0-9]*)?$" } },
        "sourceRoots": {
          "type": "array",
          "description": "Repository-relative directory prefixes included in this repository's world model. Empty means the whole application tree.",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRoot" }
        },
        "sharedRoots": {
          "type": "array",
          "description": "Repository-relative shared directories included alongside sourceRoots.",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRoot" }
        },
        "excludedRoots": {
          "type": "array",
          "description": "Repository-relative prefixes that cannot contribute WMB v4 evidence or facts.",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRoot" }
        },
        "allowedSubjects": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["symbol", "file", "contract", "dependency-edge", "test", "configuration", "rule", "runtime-observation"] }
        },
        "maximumTraversalDepth": { "type": "integer", "minimum": 0, "maximum": 128, "default": 8 },
        "v4": {
          "type": "object",
          "properties": {
            "composer": { "enum": ["deterministic", "model-optional", "model-required"], "default": "deterministic" },
            "consumer": { "enum": ["developer", "architect", "tester", "business", "operations", "security", "release"], "default": "developer" },
            "cachePolicy": { "enum": ["reuse-valid", "rebuild"], "default": "reuse-valid" },
            "candidateSnapshots": { "enum": ["allow", "deny"], "default": "allow", "description": "Controls explicit immutable Candidate Snapshot capture/use. Ordinary builds still require a clean committed source." },
            "totalMaximumOutputTokens": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 5600 }
          },
          "additionalProperties": false
        },
        "stateBranch": { "type": "string", "minLength": 1, "description": "Optional World-Model state branch override. The normalized ledger remains the publication authority." },
        "remote": { "type": "string", "minLength": 1, "description": "State-authority remote used only when ledger.remote is not explicitly authored." },
        "outputDir": { "type": "string", "minLength": 1 },
        "promptSource": { "type": "string", "minLength": 1 },
        "stateFetchTimeoutMs": { "type": "integer", "minimum": 250, "maximum": 60000, "default": 10000 },
        "generation": {
          "type": "object",
          "properties": {
            "parallel": { "type": "boolean", "default": true },
            "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4 },
            "strategy": { "enum": ["view"], "default": "view" },
            "maximumDiscoveryPacketBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576, "default": 24576 },
            "maximumSynthesisInputTokens": { "type": "integer", "minimum": 2048, "maximum": 1000000, "default": 24000 },
            "synthesisOverflow": { "enum": ["summarize-or-refuse"], "default": "summarize-or-refuse" }
          },
          "additionalProperties": false
        },
        "materialization": {
          "type": "object",
          "description": "Controls how missing exact grounding tiers are materialized. Read-only commands never invoke a provider regardless of this policy.",
          "properties": {
            "mode": { "enum": ["explicit", "on-demand", "disabled"], "default": "explicit" },
            "publish": { "enum": ["governed", "local"], "default": "governed" },
            "lookahead": { "enum": ["none", "next-phase"], "default": "none" },
            "depth": { "enum": ["light", "phase"], "default": "phase", "description": "light uses the deterministic zero-model-token builder; phase uses the phase's configured grounding depth and may invoke a model." },
            "confirmation": { "enum": ["prompt", "automatic"], "default": "prompt", "description": "automatic is valid only with depth light." }
          },
          "additionalProperties": false
        },
        "grounding": { "enum": ["off", "warn", "enforce"], "default": "off" },
        "staleness": { "enum": ["warn", "fail", "ignore"] },
        "injection": {
          "type": "object",
          "properties": {
            "placeholder": { "type": "string", "minLength": 1 },
            "mode": { "enum": ["replace", "append", "off"] },
            "maxBytes": { "type": "integer", "minimum": 1 },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["include"],
                "properties": {
                  "when": {
                    "type": "object",
                    "properties": {
                      "agent": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                      "phase": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                      "workType": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                      "changedPaths": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                      "labels": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] }
                    },
                    "additionalProperties": false
                  },
                  "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
                  "evidence": { "type": "boolean" },
                  "depth": { "enum": ["light", "quick", "standard", "deep"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tokenEconomy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "mode": { "enum": ["off", "observe", "assist", "enforce"], "default": "observe" },
        "profile": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "default": "standard" },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/tokenEconomyProfile" }
        },
        "observationFirewall": { "type": "boolean", "default": true },
        "progressiveRetrieval": { "type": "boolean", "default": true },
        "historicalMemory": { "type": "boolean", "default": false },
        "cacheStableComposition": { "type": "boolean", "default": true },
        "providerTelemetry": { "enum": ["off", "optional", "required"], "default": "optional" },
        "ast": { "enum": ["off", "optional", "required"], "default": "optional" }
      },
      "additionalProperties": false
    },
    "tokenEconomyProfile": {
      "type": "object",
      "properties": {
        "maximumEstimatedPromptTokens": { "type": "integer", "minimum": 1024, "maximum": 1000000, "default": 18000 },
        "maxInputTokens": { "type": "integer", "minimum": 1024, "maximum": 1000000 },
        "reservedOutputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 6000 },
        "maxExpansionTokens": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 8000 },
        "observationCapsuleTokens": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 3000 },
        "policyOnBudgetBreach": { "enum": ["refuse", "partial"], "default": "refuse" }
      },
      "additionalProperties": false
    },
    "autoCeilings": {
      "type": "object",
      "properties": {
        "maximumPhases": { "type": "integer", "minimum": 1 },
        "maximumAuthoringAttemptsPerPhase": { "type": "integer", "minimum": 1 },
        "maximumModelInvocations": { "type": "integer", "minimum": 1 },
        "maximumActiveMinutes": { "type": "integer", "minimum": 1 },
        "maximumElapsedMinutes": { "type": "integer", "minimum": 1 },
        "maximumTouchedPaths": { "type": "integer", "minimum": 1 },
        "maximumTouchedChanges": { "type": "integer", "minimum": 1 },
        "tokenBudget": {
          "type": "object",
          "properties": {
            "maximum": { "type": "integer", "minimum": 1 },
            "assurance": { "enum": ["exact-required", "best-available"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "autoPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "profile": {
          "type": "object",
          "properties": {
            "default": { "enum": ["story", "sgos", "auto-select"] },
            "allowed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["story", "sgos"] } }
          },
          "additionalProperties": false
        },
        "defaultPace": { "type": "string", "pattern": "^(step|continuous|phase|interval|interval:[1-9][0-9]*(m|h))$" },
        "defaultUntil": { "type": "string", "minLength": 1 },
        "workIdAllocator": { "enum": ["require-explicit", "workspace-sequence", "ulid", "jira-or-workspace"] },
        "planTtlMinutes": { "type": "integer", "minimum": 1 },
        "concurrency": {
          "type": "object",
          "properties": {
            "maximumPerCapability": { "type": "integer", "minimum": 1 },
            "maximumPerWorkspace": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "properties": {
            "allowedHosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "requireManagedWorktree": { "const": true },
            "automaticResume": { "const": false },
            "allowPolicyWaivers": { "const": false },
            "allowClarificationAnswers": { "const": false },
            "allowSequenceOverrides": { "const": false },
            "allowScopeExpansion": { "const": false }
          },
          "additionalProperties": false
        },
        "ceilings": { "$ref": "#/$defs/autoCeilings" },
        "repair": {
          "type": "object",
          "properties": {
            "policy": { "enum": ["never", "ask"], "default": "ask" },
            "maximumAttempts": { "type": "integer", "minimum": 0, "maximum": 1, "default": 1 }
          },
          "additionalProperties": false
        },
        "reporting": {
          "type": "object",
          "properties": {
            "checkpoint": { "const": "governed-when-publishing" },
            "final": { "const": "required" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "autoWorkTypePolicy": {
      "type": "object",
      "properties": {
        "eligibility": { "enum": ["disabled", "plan-only", "bounded"] },
        "allowedPaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["step", "continuous", "phase", "interval"] } },
        "defaultUntil": { "type": "string", "minLength": 1 },
        "ceilings": { "$ref": "#/$defs/autoCeilings" }
      },
      "additionalProperties": false
    },
    "sourceRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}]).+$"
    },
    "verificationPolicy": {
      "type": "object",
      "properties": {
        "coverage": { "enum": ["warn", "enforce"] },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "label", "width", "height", "deviceScaleFactor"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "label": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "height": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 }
            },
            "additionalProperties": false
          }
        },
        "comparison": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["off", "warn", "enforce"] },
            "channelTolerance": { "type": "integer", "minimum": 0, "maximum": 255 },
            "maxDifferingPixelRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "maxDifferingPixels": { "type": ["integer", "null"], "minimum": 0 },
            "maxPixels": { "type": "integer", "minimum": 1, "maximum": 100000000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "designSourcePolicy": {
      "type": "object",
      "properties": {
        "capturePhase": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "consumeIn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "staleness": { "enum": ["ignore", "warn", "fail"] },
        "requireApprovedSet": { "type": "boolean" },
        "inventoryDigest": { "enum": ["off", "optional", "required"] }
      },
      "additionalProperties": false
    },
    "mcpServer": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "hostReference": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "agents": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "phases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "tools": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" } },
        "required": { "type": "boolean", "default": false },
        "approval": { "enum": ["confirm", "host"], "default": "confirm" },
        "evidence": {
          "type": "object",
          "properties": {
            "captureToolCalls": { "type": "boolean", "default": true },
            "captureResults": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "phaseMcpPolicy": {
      "type": "object",
      "properties": {
        "requiredServers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "requireSmoke": { "type": "boolean", "default": false },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["server", "tool"],
            "properties": {
              "server": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "tool": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "minimum": { "type": "integer", "minimum": 1, "maximum": 100 },
              "outputRequired": { "type": "boolean", "default": true }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "repairBudget": {
      "type": "object",
      "required": ["maxAttempts"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "resetOnPhase": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "additionalProperties": false
    },
    "clarificationPolicy": {
      "oneOf": [
        { "enum": ["off", "when-needed", "required"] },
        {
          "type": "object",
          "properties": {
            "mode": { "enum": ["off", "when-needed", "required"] },
            "maxQuestions": { "type": "integer", "minimum": 1, "maximum": 10 },
            "topics": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sequenceGates": {
      "type": "object",
      "properties": {
        "default": { "enum": ["hard", "soft"] },
        "completion": { "enum": ["hard", "soft"] },
        "currentPhase": { "enum": ["hard", "soft"] },
        "phaseStatus": { "enum": ["hard", "soft"] },
        "freshGeneration": { "enum": ["hard", "soft"] },
        "generationCommit": { "enum": ["hard", "soft"] },
        "remoteGeneration": { "enum": ["hard", "soft"] },
        "publicationPending": { "enum": ["hard", "soft"] },
        "documentPhase": { "enum": ["hard", "soft"] },
        "binding": { "enum": ["hard", "soft"] }
      },
      "additionalProperties": false
    },
    "contextPolicy": {
      "type": "object",
      "properties": {
        "phaseBoundary": { "enum": ["keep", "compact", "new"] },
        "onApproval": { "enum": ["keep", "compact", "new"] },
        "onRejection": { "enum": ["keep", "compact", "new"] },
        "phaseOverrides": {
          "type": "object",
          "additionalProperties": { "enum": ["keep", "compact", "new"] }
        }
      },
      "additionalProperties": false
    },
    "workTypeIntelligence": {
      "type": "object",
      "description": "Story-pinned context strategy. Existing work types inherit repository behavior; explicit benchmark arms may require or disable individual intelligence layers.",
      "properties": {
        "worldModel": { "enum": ["inherit", "required", "off"], "default": "inherit" },
        "ast": { "enum": ["inherit", "required-context", "off"], "default": "inherit" },
        "agentBriefs": { "enum": ["inherit", "required", "off"], "default": "inherit" }
      },
      "additionalProperties": false
    },
    "plannedClaimsPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "const": "required" },
            "clausePhases": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
            },
            "owners": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "additionalProperties": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "reason"],
          "properties": {
            "mode": { "const": "opt-out" },
            "reason": { "type": "string", "minLength": 20, "maxLength": 1000 }
          },
          "additionalProperties": false
        }
      ]
    },
    "phaseInputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          {
            "type": "object",
            "required": ["phase"],
            "properties": {
              "phase": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "optional": { "type": "boolean" },
              "maxBytes": { "type": "integer", "minimum": 1 },
              "projection": { "enum": ["full", "approved-summary"] },
              "preserve": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "maximumSummaryBytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
              "expansion": { "const": "hash-bound-reference" },
              "fallback": { "enum": ["whole", "block"] },
              "selector": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "const": "clauses" },
                  "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                  "claims": { "enum": ["planned", "observed"] },
                  "includeDependencies": { "type": "boolean" },
                  "fallback": { "enum": ["whole", "empty"] }
                },
                "additionalProperties": false
              }
            },
            "allOf": [
              {
                "if": { "properties": { "projection": { "const": "approved-summary" } }, "required": ["projection"] },
                "then": { "not": { "anyOf": [{ "required": ["maxBytes"] }, { "required": ["selector"] }] } }
              },
              {
                "if": { "not": { "properties": { "projection": { "const": "approved-summary" } }, "required": ["projection"] } },
                "then": { "not": { "anyOf": [{ "required": ["preserve"] }, { "required": ["maximumSummaryBytes"] }, { "required": ["expansion"] }, { "required": ["fallback"] }] } }
              }
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "generationPolicy": {
      "oneOf": [
        { "enum": ["required", "optional", "none"] },
        {
          "type": "object",
          "properties": {
            "requirement": { "enum": ["required", "optional", "none"] },
            "producer": { "enum": ["agent", "deterministic", "manual"] },
            "defaultProducer": { "enum": ["human", "governed-agent", "deterministic", "external-tool"] },
            "task": { "enum": ["relay", "clarify", "reason", "code", "analyze", "summarize"] },
            "allowedProducers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["human", "governed-agent", "deterministic", "external-tool"] }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "qualityCommand": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["id", "modelPolicy"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "modelPolicy": { "enum": ["never", "required", "unknown"] },
            "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 7200000 },
            "kind": { "enum": ["test", "compile", "lint", "format", "static-analysis", "security", "other"] },
            "workingDirectory": { "type": "string", "minLength": 1 },
            "affectedRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "result": {
              "type": "object",
              "required": ["adapter", "path"],
              "properties": {
                "adapter": { "enum": ["junit-xml", "jest-json", "vitest-json", "playwright-json", "go-test-json", "node-tap", "dotnet-trx", "cargo-json", "sflow-test-result-v1"] },
                "path": { "type": "string", "minLength": 1 },
                "minimumDiscovered": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "oneOf": [
            { "required": ["command"], "not": { "required": ["argv"] } },
            { "required": ["argv"], "not": { "required": ["command"] } }
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifactContract": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "minimumBytes": { "type": "integer", "minimum": 1 },
        "maximumBytes": { "type": "integer", "minimum": 1 },
        "allowedExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
        },
        "allowedMediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$" }
        },
        "validation": {
          "type": "object",
          "properties": {
            "requiredHeadings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "forbiddenPlaceholders": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "approvalPolicy": {
      "oneOf": [
      { "const": "none" },
      { "type": "object",
      "properties": {
        "mode": { "enum": ["required", "none", "policy"] },
        "policy": { "type": "string", "minLength": 1 },
        "maximumChangedPaths": { "type": "integer", "minimum": 1 },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "requiredAuthorities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "minimum": { "type": "integer", "minimum": 1 },
        "rejectTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "changeRequests": {
          "type": "object",
          "properties": {
            "commentRequired": { "type": "boolean" },
            "reopenCompleted": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false }
      ]
    }
  }
}
