{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/gdp-nondeterminism-profile.schema.json",
  "title": "GDP Nondeterminism Profile v1", "type": "object",
  "required": ["schemaVersion", "kind", "proofSubjectSha256", "witnessSha256", "attempts", "outcomes", "status", "gaps", "nondeterminismSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "nondeterminism-profile" },
    "proofSubjectSha256": { "$ref": "#/$defs/digest" }, "witnessSha256": { "$ref": "#/$defs/digest" },
    "attempts": { "type": "integer", "minimum": 0, "maximum": 100 },
    "outcomes": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/outcome" } },
    "status": { "enum": ["stable", "conflicting", "unavailable"] },
    "gaps": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nondeterminismSha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false, "x-sflow-selfHash": "nondeterminismSha256",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outcome": { "type": "object", "required": ["attempt", "resultSha256", "outcome"], "properties": { "attempt": { "type": "integer", "minimum": 1, "maximum": 100 }, "resultSha256": { "$ref": "#/$defs/digest" }, "outcome": { "enum": ["passed", "failed", "skipped", "unavailable"] } }, "additionalProperties": false }
  }
}
