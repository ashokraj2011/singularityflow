{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/revision-browser-run-key.schema.json",
  "title": "Singularity Flow immutable browser run key v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "candidateId", "candidateSha256", "candidateRefSha256", "candidateTree", "materializationSha256", "workId", "phaseId", "phaseGeneration", "loopId", "intervalId", "runId", "configSha256", "workflowSha256", "proofProfileSha256", "testManifestSha256", "checkId", "checkDefinitionSha256", "argvSha256", "timeoutMs", "environmentName", "environmentSha256", "baselineManifestSha256", "adapterSha256", "runKeySha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "revision-browser-run-key" },
    "candidateId": { "$ref": "revision-contract-definitions.schema.json#/$defs/candidateId" },
    "candidateSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "candidateRefSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "candidateTree": { "$ref": "revision-contract-definitions.schema.json#/$defs/gitObject" },
    "materializationSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "workId": { "$ref": "revision-contract-definitions.schema.json#/$defs/identifier" },
    "phaseId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "phaseGeneration": { "type": "integer", "minimum": 1 },
    "loopId": { "$ref": "revision-contract-definitions.schema.json#/$defs/identifier" },
    "intervalId": { "$ref": "revision-contract-definitions.schema.json#/$defs/identifier" },
    "runId": { "type": "string", "pattern": "^BRL-[a-f0-9]{12}$" },
    "configSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "workflowSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "proofProfileSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "testManifestSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "checkId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "checkDefinitionSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "argvSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 7200000 },
    "environmentName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "environmentSha256": { "oneOf": [{ "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }, { "type": "null" }] },
    "baselineManifestSha256": { "oneOf": [{ "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }, { "type": "null" }] },
    "adapterSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "runKeySha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }
  },
  "additionalProperties": false
}
