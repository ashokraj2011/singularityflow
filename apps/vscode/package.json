        },
        {
          "command": "singularityFlow.openDeveloperHome",
          "when": "false"
        },
        {
          "command": "singularityFlow.openArtifact",
          "when": "false"
        },
        {
          "command": "singularityFlow.runAction",
          "when": "false"
        },
        {
          "command": "singularityFlow.approve",
          "when": "false"
        }
