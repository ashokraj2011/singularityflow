{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/repository-onboarding-result.schema.json",
  "title": "Singularity Flow repository onboarding result v1",
  "description": "Confirmed repository setup result bound to one repository-onboarding-plan/v1 digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "planId",
    "mode",
    "status",
    "primaryAction",
    "applied",
    "changed",
    "effects",
    "preserved",
    "availableModes",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "repository-onboarding-result/v1" },
    "planId": { "$ref": "#/$defs/digest" },
    "mode": { "enum": ["auto", "migrate", "recreate", "reset-local"] },
    "status": {
      "enum": [
        "ready",
        "ready-to-restore",
        "update-available",
        "linked-to-team-configuration",
        "sflow-repository-capability-not-mapped",
        "not-set-up",
        "state-branch-not-recognized",
        "could-not-check-git",
        "needs-a-choice",
        "newer-version-required",
        "ready-state-refresh-pending",
        "configuration-review-required",
        "local-registration-pending"
      ]
    },
    "primaryAction": {
      "enum": [
        "continue",
        "restore-and-continue",
        "migrate-and-continue",
        "map-capability",
        "set-up-sflow",
        "choose-another-state-branch",
        "retry",
        "review-choices",
        "install-newer-version",
        "recreate-configuration",
        "reset-local-registration"
      ]
    },
    "applied": { "const": true },
    "changed": { "type": "boolean" },
    "effects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/effect" }
    },
    "preserved": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "application-head",
          "application-working-tree",
          "application-branches",
          "lifecycle-events",
          "non-configuration-state",
          "configuration-proposal-refs"
        ]
      }
    },
    "localCleanupWarnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "availableModes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["migrate", "recreate", "reset-local"] }
    },
    "routing": { "$ref": "#/$defs/routing" },
    "configuration": { "$ref": "#/$defs/publishedConfiguration" },
    "stateRefresh": {
      "anyOf": [
        { "$ref": "#/$defs/stateRefresh" },
        { "type": "null" }
      ]
    },
    "proposal": { "$ref": "#/$defs/proposal" },
    "review": { "$ref": "#/$defs/review" },
    "localRegistration": { "$ref": "#/$defs/localRegistration" },
    "restored": {
      "anyOf": [
        { "$ref": "#/$defs/publishedConfiguration" },
        { "type": "null" }
      ]
    },
    "omitted": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "localReset": { "$ref": "#/$defs/localReset" },
    "receipt": {
      "anyOf": [
        { "$ref": "#/$defs/recoveryReceipt" },
        { "$ref": "#/$defs/migrationReceipt" },
        { "$ref": "#/$defs/proposalReceipt" },
        { "type": "null" }
      ]
    },
    "nextActions": { "$ref": "#/$defs/nextActions" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!refs/)(?![-.])(?!@$)(?!.*(?:^|/)\\.)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*(?:\\.\\.|//|@\\{|[\\u0000-\\u0020\\u007f~^:?*\\[\\\\]))(?!.*(?:/|\\.)$).+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000\\r\\n]).+$"
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "action"],
      "properties": {
        "kind": {
          "enum": [
            "configuration-migration",
            "configuration-restore",
            "configuration-recreate",
            "state-projection",
            "local-registration",
            "local-cache"
          ]
        },
        "target": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "action": { "enum": ["propose", "create", "refresh", "remember", "forget", "delete"] }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leadUrl", "capabilityIds", "verified"],
      "properties": {
        "leadUrl": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "capabilityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "verified": { "type": "boolean" },
        "repositoryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "configurationCommit": { "$ref": "#/$defs/commit" },
        "validationCode": { "type": "string", "minLength": 1 },
        "validationError": { "type": "string", "minLength": 1 }
      }
    },
    "publishedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "reconciled"],
      "properties": {
        "branch": { "const": "sflow/config" },
        "commit": { "$ref": "#/$defs/commit" },
        "reconciled": { "type": "boolean" },
        "created": { "const": true },
        "importedFrom": { "$ref": "#/$defs/branch" },
        "method": { "enum": ["retained-history", "verified-mirror-reconstruction"] },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "receipt": {
          "anyOf": [
            { "$ref": "#/$defs/recoveryReceipt" },
            { "type": "null" }
          ]
        }
      }
    },
    "stateRefresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pending"],
      "properties": {
        "status": { "enum": ["current", "updated", "not-applicable", "policy-disabled", "failed", "pending"] },
        "pending": { "type": "boolean" },
        "baseBranch": { "const": "sflow/config" },
        "published": { "type": "boolean" },
        "branch": { "$ref": "#/$defs/branch" },
        "commit": { "$ref": "#/$defs/commit" },
        "reason": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "portability": { "$ref": "#/$defs/deferredPortability" },
        "retry": { "$ref": "#/$defs/nextActions" }
      }
    },
    "deferredPortability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "published", "reason"],
      "properties": {
        "status": { "const": "deferred" },
        "published": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed", "branch", "commit", "files", "reviewRequired"],
      "properties": {
        "changed": { "type": "boolean" },
        "branch": {
          "anyOf": [
            { "$ref": "#/$defs/branch" },
            { "type": "null" }
          ]
        },
        "commit": { "$ref": "#/$defs/commit" },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "reviewRequired": { "type": "boolean" },
        "existing": { "type": "boolean" },
        "reconciled": { "type": "boolean" },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "published": { "type": "boolean" },
        "conflict": { "type": "boolean" },
        "migration": { "$ref": "#/$defs/migration" },
        "omitted": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "configurationReady",
        "sourceBranch",
        "targetBranch",
        "proposalCommit",
        "candidateCommit",
        "published",
        "existing",
        "conflict",
        "recovery"
      ],
      "properties": {
        "status": { "enum": ["review-required", "proposal-conflict"] },
        "configurationReady": { "const": false },
        "sourceBranch": { "$ref": "#/$defs/branch" },
        "targetBranch": { "const": "sflow/config" },
        "proposalCommit": { "$ref": "#/$defs/commit" },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "published": { "type": "boolean" },
        "existing": { "type": "boolean" },
        "conflict": { "type": "boolean" },
        "recovery": { "$ref": "#/$defs/reviewRecovery" }
      }
    },
    "reviewRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "sourceBranch", "targetBranch", "proposalCommit", "afterMerge"],
      "properties": {
        "action": { "enum": ["merge-proposal", "resolve-proposal-conflict"] },
        "sourceBranch": { "$ref": "#/$defs/branch" },
        "targetBranch": { "const": "sflow/config" },
        "proposalCommit": { "$ref": "#/$defs/commit" },
        "afterMerge": { "type": "string", "minLength": 1 }
      }
    },
    "localRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "remembered", "target", "code", "reason", "retry"],
      "properties": {
        "status": { "const": "pending" },
        "remembered": { "const": false },
        "target": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "code": { "const": "CAPABILITY_LEAD_REGISTRY_WRITE_FAILED" },
        "causeCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "reason": { "type": "string", "minLength": 1 },
        "retry": { "$ref": "#/$defs/nextActions" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedChanges"],
      "properties": {
        "seedChanges": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "recoveryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "mode", "planId", "repositoryIdentity", "state", "sourceDigest"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "repository-configuration-recovery" },
        "mode": { "enum": ["auto", "migrate", "recreate"] },
        "planId": { "$ref": "#/$defs/digest" },
        "repositoryIdentity": { "$ref": "#/$defs/digest" },
        "state": { "$ref": "#/$defs/receiptState" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "sourceBranch": { "$ref": "#/$defs/branch" },
        "sourceCommit": { "$ref": "#/$defs/commit" }
      }
    },
    "receiptState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "sourceCommit"],
      "properties": {
        "branch": { "$ref": "#/$defs/branch" },
        "commit": {
          "anyOf": [
            { "$ref": "#/$defs/commit" },
            { "type": "null" }
          ]
        },
        "sourceCommit": {
          "anyOf": [
            { "$ref": "#/$defs/commit" },
            { "type": "null" }
          ]
        }
      }
    },
    "migrationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restored", "proposal"],
      "properties": {
        "restored": {
          "anyOf": [
            { "$ref": "#/$defs/publishedConfiguration" },
            { "type": "null" }
          ]
        },
        "proposal": { "$ref": "#/$defs/proposal" }
      }
    },
    "proposalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal"],
      "properties": {
        "proposal": { "$ref": "#/$defs/proposal" }
      }
    },
    "localReset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "leadRegistrationsRemoved", "organisationCachesRemoved", "remoteChanged"],
      "properties": {
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
        },
        "leadRegistrationsRemoved": { "type": "integer", "minimum": 0 },
        "organisationCachesRemoved": { "type": "integer", "minimum": 0 },
        "remoteChanged": { "const": false }
      }
    },
    "nextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "copilot"],
      "properties": {
        "shell": { "type": "string", "minLength": 1 },
        "copilot": { "const": "/sf-capability-map" }
      }
    }
  }
}
