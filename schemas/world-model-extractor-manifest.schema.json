{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-extractor-manifest.schema.json",
  "title": "WMB v4 extractor manifest", "type": "object",
  "required": ["schemaVersion", "kind", "id", "version", "producer", "languages", "evidenceKinds", "factTypes", "inputs", "outputs", "failure", "permissions", "tests", "manifestSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-extractor-manifest" }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }, "version": { "$ref": "#/$defs/semver" },
    "producer": { "type": "object", "required": ["kind", "implementationSha256", "parser"], "properties": { "kind": { "const": "deterministic-module" }, "implementationSha256": { "$ref": "#/$defs/hash" }, "parser": { "type": "object", "required": ["id", "version", "grammarSha256"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }, "version": { "$ref": "#/$defs/semver" }, "grammarSha256": { "$ref": "#/$defs/hash" } }, "additionalProperties": false } }, "additionalProperties": false },
    "languages": { "$ref": "#/$defs/strings" }, "evidenceKinds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceKind" } }, "factTypes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/factType" } },
    "inputs": { "type": "object", "required": ["sourceManifest", "scopeManifest"], "properties": { "sourceManifest": { "const": "required" }, "scopeManifest": { "const": "required" } }, "additionalProperties": false },
    "outputs": { "type": "object", "required": ["evidenceCatalogEntries", "derivationRecords", "factLedgerEntries"], "properties": { "evidenceCatalogEntries": { "const": true }, "derivationRecords": { "const": true }, "factLedgerEntries": { "const": true } }, "additionalProperties": false },
    "failure": { "type": "object", "required": ["unsupportedLanguage", "parseFailure", "internalError"], "properties": { "unsupportedLanguage": { "enum": ["unavailable", "not-applicable"] }, "parseFailure": { "enum": ["partial-or-unavailable", "not-applicable"] }, "internalError": { "const": "refuse" } }, "additionalProperties": false },
    "permissions": { "type": "object", "required": ["network", "model", "writes"], "properties": { "network": { "const": "none" }, "model": { "const": "never" }, "writes": { "const": "derived-store-only" } }, "additionalProperties": false },
    "tests": { "type": "object", "required": ["conformanceReceiptSha256"], "properties": { "conformanceReceiptSha256": { "$ref": "#/$defs/hash" } }, "additionalProperties": false }, "manifestSha256": { "$ref": "#/$defs/hash" }
  }, "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "evidenceKind": { "enum": ["file", "directory", "symbol", "signature", "export", "import", "dependency-edge", "call-edge", "reference-edge", "interface-implementation", "configuration-object", "rule-object", "condition-expression", "test-identity", "test-symbol-binding", "clause-binding", "decision-record", "runtime-observation", "human-confirmed-record", "unavailability-observation"] },
    "factType": { "enum": ["file-exists", "language-detected", "symbol-exists", "symbol-index", "signature", "export", "import-dependency", "dependency-edge", "dependency-analysis", "configuration-object", "changed-symbol", "contract-change", "test-impact", "structural-impact", "runtime-frequency", "interface", "implementation", "consumer-dependency", "schema-contract", "protocol-field", "runtime-guarantee", "change-frequency", "dependency-degree", "complexity-metric", "incident-mapping", "ownership-concentration", "rule-definition", "condition-expression", "clause-binding", "test-identity", "maintainer-record", "business-glossary", "business-meaning"] }
  }, "additionalProperties": false
}
