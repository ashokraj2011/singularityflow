{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-read-consumer.schema.json",
  "title": "FWM read consumer contract",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "consumerClass", "owner", "viewRefs", "required", "maximumBytes", "fallback", "consumerSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-read-consumer" },
    "id": { "$ref": "#/$defs/lower" },
    "consumerClass": { "$ref": "#/$defs/lower" },
    "owner": { "$ref": "#/$defs/lower" },
    "viewRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/exactView" } },
    "required": { "type": "boolean" },
    "maximumBytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
    "fallback": { "enum": ["unavailable", "ordinary-files"] },
    "consumerSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "lower": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "exactView": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+@[1-9][0-9]*$" }
  },
  "additionalProperties": false
}
