{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/gdp-proof-predicate-specification.schema.json",
  "title": "GDP Proof Predicate Specification v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "predicate", "acceptedInputs", "algorithm", "profiles", "reasonCodes", "limits", "invalidationDependencies", "acceptanceCriteria", "specificationSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "proof-predicate-specification" },
    "predicate": { "$ref": "#/$defs/predicate" },
    "acceptedInputs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/acceptedInput" } },
    "algorithm": { "enum": ["exact-digest-equality", "required-input-present", "exact-not-applicable"] },
    "profiles": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/profile" } },
    "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/reason" } },
    "limits": { "$ref": "#/$defs/limits" },
    "invalidationDependencies": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "acceptanceCriteria": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "specificationSha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "x-sflow-selfHash": "specificationSha256",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reason": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" },
    "profile": { "enum": ["standard", "high-assurance", "regulated", "custom-registered"] },
    "predicate": {
      "type": "object",
      "required": ["id", "version", "implementationSha256"],
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^pfc\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "implementationSha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "acceptedInput": {
      "type": "object",
      "required": ["kind", "required", "maximumOccurrences"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "maximumOccurrences": { "type": "integer", "minimum": 1, "maximum": 256 }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["maximumInputs", "maximumInputBytes", "maximumFuel", "deadlineMilliseconds", "maximumOutputBytes"],
      "properties": {
        "maximumInputs": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maximumInputBytes": { "type": "integer", "minimum": 128, "maximum": 1048576 },
        "maximumFuel": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "deadlineMilliseconds": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maximumOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 65536 }
      },
      "additionalProperties": false
    }
  }
}
