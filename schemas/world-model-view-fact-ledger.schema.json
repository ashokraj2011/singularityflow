{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-view-fact-ledger.schema.json",
  "title": "WMB v4 view-scoped fact ledger", "type": "object",
  "required": ["schemaVersion", "kind", "viewId", "viewVersion", "viewSpecSha256", "sourceLedgerSha256", "facts", "requiredFactIds", "requiredUnavailableFactIds", "materialContradictionFactIds", "selectionPolicySha256", "ledgerSha256"],
