{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/workflow-definition.schema.json",
  "title": "Singularity Flow YAML workflow definition",
  "type": "object",
  "required": ["version", "git", "templatesRoot", "personaPromptsRoot", "personas", "workTypes", "phases"],
  "properties": {
    "version": { "const": 1 },
    "inputsMode": { "enum": ["off", "record", "enforce"], "default": "off" },
    "sequenceGates": { "$ref": "#/$defs/sequenceGates" },
    "contextPolicy": { "$ref": "#/$defs/contextPolicy" },
    "defaultBaseBranch": { "type": "string", "minLength": 1 },
    "workItemRoot": { "type": "string", "minLength": 1 },
    "idPattern": { "type": "string", "minLength": 1 },
    "git": {
      "type": "object",
      "required": ["remote", "publish"],
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "publish": { "enum": ["required", "off"] }
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "branch": { "type": "string", "minLength": 1, "default": "singularity/ledger" },
        "remote": { "type": "string", "minLength": 1, "default": "origin" },
        "behind": { "enum": ["warn", "block"], "default": "warn" },
        "enforcement": { "enum": ["shadow", "required"], "default": "shadow" },
        "signing": { "enum": ["off", "commit"], "default": "off" },
        "trustTier": { "enum": ["T0", "T1", "T2", "T3"], "default": "T0" },
        "maxRetries": { "type": "integer", "minimum": 1, "maximum": 20, "default": 4 },
        "pinTransport": { "enum": ["refs", "branches", "none"], "default": "refs" },
        "retentionDays": { "type": "integer", "minimum": 0, "maximum": 36500, "default": 2555 }
      },
      "additionalProperties": false
    },
    "templatesRoot": { "type": "string", "minLength": 1 },
    "personaPromptsRoot": { "type": "string", "minLength": 1 },
    "planning": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "promptSource": { "type": "string", "minLength": 1 },
        "maxContextBytes": { "type": "integer", "minimum": 16384, "maximum": 10485760 }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "mode": { "const": "exact-or-unavailable" },
        "pricing": {
          "type": "object",
          "description": "Optional per-million-token prices keyed by exact provider model name. No prices are assumed by default.",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "input": { "type": "number", "minimum": 0 },
              "output": { "type": "number", "minimum": 0 },
              "cachedInput": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "object",
      "properties": {
        "allowedPhases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "maxFileBytes": { "type": "integer", "minimum": 1 },
        "maxPreviewBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "collaboration": {
      "type": "object",
      "properties": {
        "assignmentMode": { "enum": ["off", "suggested", "required"] },
        "approvalReminderAfterHours": { "type": "number", "minimum": 0 },
        "notifications": { "type": "array", "uniqueItems": true, "items": { "enum": ["terminal"] } }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "workItemSelection": { "enum": ["off", "reuse", "prompt"] },
        "personaSelection": { "enum": ["off", "reuse", "prompt"] },
        "promptOnNewSession": { "type": "boolean" },
        "promptOnResume": { "type": "boolean" },
        "requireBeforeTools": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "approvalAuthorities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "allowAnyGitIdentity": { "type": "boolean" },
          "githubTeams": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^@[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string" },
                "githubLogin": { "type": "string" }
              },
              "anyOf": [
                { "required": ["email"] },
                { "required": ["githubLogin"] }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "personas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "prompt"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "suggestedPhases": { "type": "array", "items": { "type": "string" } },
          "worldModelViews": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "workTypes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "phases"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "phases": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "templateOverrides": { "type": "object", "additionalProperties": { "type": "string" } },
          "phaseOverrides": {
            "type": "object",
            "description": "Per-profile overrides for artifact, qualityCommands, worldModel, comparison, approval, or other phase fields.",
            "additionalProperties": {
              "type": "object",
              "properties": { "inputs": { "$ref": "#/$defs/phaseInputs" } }
            }
          },
          "sequenceGates": { "$ref": "#/$defs/sequenceGates" }
        },
        "additionalProperties": true
      }
    },
    "phases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "writeScope": { "enum": ["artifact-only", "source-and-artifact"] },
          "inputs": { "$ref": "#/$defs/phaseInputs" },
          "approval": { "$ref": "#/$defs/approvalPolicy" }
        }
      }
    },
    "governance": { "type": "object" },
    "worldModel": {
      "type": "object",
      "properties": {
        "views": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "outputDir": { "type": "string", "minLength": 1 },
        "promptSource": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "generation": {
          "type": "object",
          "properties": {
            "parallel": { "type": "boolean", "default": true },
            "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4 },
            "strategy": { "enum": ["view"], "default": "view" }
          },
          "additionalProperties": false
        },
        "grounding": { "enum": ["off", "warn", "enforce"], "default": "off" },
        "staleness": { "enum": ["warn", "fail", "ignore"] },
        "injection": {
          "type": "object",
          "properties": {
            "placeholder": { "type": "string", "minLength": 1 },
            "mode": { "enum": ["replace", "append", "off"] },
            "maxBytes": { "type": "integer", "minimum": 1 },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["include"],
                "properties": {
                  "when": {
                    "type": "object",
                    "properties": {
                      "persona": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                      "phase": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                      "workType": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                      "changedPaths": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
                      "labels": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] }
                    },
                    "additionalProperties": false
                  },
                  "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
                  "evidence": { "type": "boolean" },
                  "depth": { "enum": ["quick", "standard", "deep"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sequenceGates": {
      "type": "object",
      "properties": {
        "default": { "enum": ["hard", "soft"] },
        "completion": { "enum": ["hard", "soft"] },
        "currentPhase": { "enum": ["hard", "soft"] },
        "phaseStatus": { "enum": ["hard", "soft"] },
        "freshGeneration": { "enum": ["hard", "soft"] },
        "generationCommit": { "enum": ["hard", "soft"] },
        "remoteGeneration": { "enum": ["hard", "soft"] },
        "publicationPending": { "enum": ["hard", "soft"] },
        "documentPhase": { "enum": ["hard", "soft"] },
        "binding": { "enum": ["hard", "soft"] }
      },
      "additionalProperties": false
    },
    "contextPolicy": {
      "type": "object",
      "properties": {
        "phaseBoundary": { "enum": ["keep", "compact", "new"] },
        "onApproval": { "enum": ["keep", "compact", "new"] },
        "onRejection": { "enum": ["keep", "compact", "new"] },
        "phaseOverrides": {
          "type": "object",
          "additionalProperties": { "enum": ["keep", "compact", "new"] }
        }
      },
      "additionalProperties": false
    },
    "phaseInputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          {
            "type": "object",
            "required": ["phase"],
            "properties": {
              "phase": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "optional": { "type": "boolean" },
              "maxBytes": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "approvalPolicy": {
      "type": "object",
      "required": ["authorities"],
      "properties": {
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "minimum": { "type": "integer", "minimum": 1 },
        "rejectTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
