{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.local/schemas/release-platform-evidence.schema.json",
  "title": "Reviewed physical release evidence for one platform and Node runtime",
  "type": "object",
  "required": [
    "schemaVersion",
    "reviewedAt",
    "reviewerIdentity",
    "platform",
    "nodeVersion",
    "commit",
    "tree",
    "packageSha256",
    "vsixSha256",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewerIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "platform": { "enum": ["darwin", "linux", "win32"] },
    "nodeVersion": {
      "type": "string",
      "pattern": "^(?:20|22)\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "commit": { "$ref": "#/$defs/gitObjectId" },
    "tree": { "$ref": "#/$defs/gitObjectId" },
    "packageSha256": { "$ref": "#/$defs/sha256" },
    "vsixSha256": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "object",
      "required": [
        "installedVsixActivation",
        "stagedInstallerRecovery",
        "windowsNpmNpxRoundTrip",
        "exactPackageLocalStart",
        "authenticatedPlaywrightSmoke"
      ],
      "properties": {
        "installedVsixActivation": { "$ref": "#/$defs/passedEvidence" },
        "stagedInstallerRecovery": { "$ref": "#/$defs/passedEvidence" },
        "windowsNpmNpxRoundTrip": {
          "type": "object",
          "required": ["outcome", "evidenceSha256", "reasonCode"],
          "properties": {
            "outcome": { "enum": ["passed", "not-applicable"] },
            "evidenceSha256": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "reasonCode": {
              "enum": [null, "non-windows-platform"]
            }
          },
          "additionalProperties": false
        },
        "exactPackageLocalStart": {
          "type": "object",
          "required": [
            "outcome",
            "evidenceSha256",
            "networkIsolationMechanism",
            "packageName",
            "packageVersion",
            "packageClosureSha256"
          ],
          "properties": {
            "outcome": { "const": "passed" },
            "evidenceSha256": { "$ref": "#/$defs/sha256" },
            "networkIsolationMechanism": { "$ref": "#/$defs/mechanism" },
            "packageName": { "const": "@playwright/mcp" },
            "packageVersion": { "const": "0.0.79" },
            "packageClosureSha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "authenticatedPlaywrightSmoke": {
          "type": "object",
          "required": [
            "outcome",
            "evidenceSha256",
            "authenticationMechanism",
            "authenticationProfileSha256"
          ],
          "properties": {
            "outcome": { "const": "passed" },
            "evidenceSha256": { "$ref": "#/$defs/sha256" },
            "authenticationMechanism": { "$ref": "#/$defs/mechanism" },
            "authenticationProfileSha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "sgosEndToEnd": {
          "type": "object",
          "required": [
            "softwareConversionJourney",
            "hypothesisAnalysisJourney",
            "interruptionRecovery",
            "counterfeitAuthorityRefusal",
            "crossMachineAuthorityRoundTrip",
            "performanceBudget"
          ],
          "properties": {
            "softwareConversionJourney": { "$ref": "#/$defs/passedEvidence" },
            "hypothesisAnalysisJourney": { "$ref": "#/$defs/passedEvidence" },
            "interruptionRecovery": { "$ref": "#/$defs/passedEvidence" },
            "counterfeitAuthorityRefusal": { "$ref": "#/$defs/passedEvidence" },
            "crossMachineAuthorityRoundTrip": { "$ref": "#/$defs/passedEvidence" },
            "performanceBudget": {
              "type": "object",
              "required": ["outcome", "evidenceSha256", "budgetProfileSha256"],
              "properties": {
                "outcome": { "const": "passed" },
                "evidenceSha256": { "$ref": "#/$defs/sha256" },
                "budgetProfileSha256": { "$ref": "#/$defs/sha256" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } } },
      "then": {
        "properties": {
          "checks": { "not": { "required": ["sgosEndToEnd"] } }
        }
      },
      "else": {
        "properties": {
          "checks": { "required": ["sgosEndToEnd"] }
        }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "win32" } } },
      "then": {
        "properties": {
          "checks": {
            "properties": {
              "windowsNpmNpxRoundTrip": {
                "properties": {
                  "outcome": { "const": "passed" },
                  "evidenceSha256": { "$ref": "#/$defs/sha256" },
                  "reasonCode": { "type": "null" }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "properties": {
              "windowsNpmNpxRoundTrip": {
                "properties": {
                  "outcome": { "const": "not-applicable" },
                  "evidenceSha256": { "type": "null" },
                  "reasonCode": { "const": "non-windows-platform" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "mechanism": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "passedEvidence": {
      "type": "object",
      "required": ["outcome", "evidenceSha256"],
      "properties": {
        "outcome": { "const": "passed" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
