{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@flow/*": [
        "src/shared/*"
      ],
      "@shared/*": [
        "../../vendor/event-horizon/src/shared/*"
      ],
      "@renderer/*": [
        "../../vendor/event-horizon/src/renderer/src/*"
      ],
      "event-horizon/renderer": [
        "../../vendor/event-horizon/src/renderer/src/index.ts"
      ]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "../../vendor/event-horizon/src/renderer/src/**/*",
    "../../vendor/event-horizon/src/shared/**/*"
  ]
}
