{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-context-manifest.schema.json",
  "title": "WMB v4 context manifest", "type": "object",
  "required": ["schemaVersion", "kind", "viewId", "promptSha256", "regions", "manifestSha256"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-context-manifest" }, "viewId": { "type": "string" }, "promptSha256": { "$ref": "#/$defs/hash" }, "regions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "sha256", "bytes", "estimatedTokens", "cacheClass"], "properties": { "id": { "type": "string" }, "sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 0 }, "estimatedTokens": { "type": "integer", "minimum": 0 }, "cacheClass": { "enum": ["stable-prefix", "stable-view", "task", "dynamic"] } }, "additionalProperties": false } }, "manifestSha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }, "additionalProperties": false
}
