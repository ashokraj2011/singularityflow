{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-manifest.schema.json",
  "title": "WMB v4 aggregate manifest", "type": "object",
  "required": ["schemaVersion", "kind", "format", "subject", "sourceManifestSha256", "scopeManifestSha256", "policySnapshotSha256", "viewRegistrySha256", "extractorRegistrySha256", "evidenceCatalogSha256", "derivationCatalogSha256", "factLedgerSha256", "views", "completeness", "manifestSha256"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-manifest" }, "format": { "const": "wmb-v4" }, "subject": { "type": "object", "required": ["kind", "id"], "properties": { "kind": { "const": "repository" }, "id": { "type": "string" } }, "additionalProperties": false }, "sourceManifestSha256": { "$ref": "#/$defs/hash" }, "scopeManifestSha256": { "$ref": "#/$defs/hash" }, "policySnapshotSha256": { "$ref": "#/$defs/hash" }, "viewRegistrySha256": { "$ref": "#/$defs/hash" }, "extractorRegistrySha256": { "$ref": "#/$defs/hash" }, "evidenceCatalogSha256": { "$ref": "#/$defs/hash" }, "derivationCatalogSha256": { "$ref": "#/$defs/hash" }, "factLedgerSha256": { "$ref": "#/$defs/hash" },
    "views": { "type": "array", "items": { "type": "object", "required": ["viewId", "viewVersion", "required", "status", "path", "viewSha256", "validationReceiptSha256", "executionSha256", "cache"], "properties": { "viewId": { "type": "string" }, "viewVersion": { "type": "integer", "minimum": 1 }, "required": { "type": "boolean" }, "status": { "enum": ["available", "unavailable"] }, "path": { "type": ["string", "null"] }, "viewSha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "validationReceiptSha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "executionSha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "cache": { "enum": ["hit", "miss"] } }, "additionalProperties": false } },
    "completeness": { "type": "object", "required": ["requiredViews", "availableRequiredViews", "optionalViews", "unavailableOptionalViews"], "properties": { "requiredViews": { "type": "integer", "minimum": 0 }, "availableRequiredViews": { "type": "integer", "minimum": 0 }, "optionalViews": { "type": "integer", "minimum": 0 }, "unavailableOptionalViews": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "manifestSha256": { "$ref": "#/$defs/hash" }
  }, "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }, "additionalProperties": false
}
