{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/token-reduction-ordering-rules.schema.json",
  "title": "TKR v1 ordering rules",
  "type": "object",
  "required": ["schemaVersion", "kind", "owner", "contractId", "version", "stableOrder", "dynamicOrder", "dependencyPolicy", "rolePolicy", "setOrdering", "contractSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "tkr/ordering-rules" },
    "owner": { "$ref": "#/$defs/id" },
    "contractId": { "$ref": "#/$defs/id" },
    "version": { "const": 1 },
    "stableOrder": { "const": "declared-section-order" },
    "dynamicOrder": { "const": "purpose-rule-qualified-subject" },
    "dependencyPolicy": { "const": "preserve" },
    "rolePolicy": { "const": "preserve" },
    "setOrdering": { "const": "unicode-code-point" },
    "contractSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
