{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/architecture-intent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "workId", "phase", "generation", "base", "clauses", "intentSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "architecture-intent" },
    "workId": { "type": "string", "minLength": 1 }, "phase": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 1 }, "base": { "type": "object" },
    "clauses": { "type": "array", "minItems": 1 },
    "intentSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
