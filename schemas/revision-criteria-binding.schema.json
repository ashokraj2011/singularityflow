{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/revision-criteria-binding.schema.json",
  "title": "Singularity Flow immutable revision criteria binding v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "subject", "feedbackSha256", "mode", "criteria", "binder", "producer", "bindingSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "revision-criteria-binding" },
    "subject": { "$ref": "revision-contract-definitions.schema.json#/$defs/subject" },
    "feedbackSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "mode": { "enum": ["explicit", "exact-id", "exact-phrase", "structural-reference", "unscoped", "ambiguous"] },
    "criteria": { "type": "array", "maxItems": 128, "items": {
      "type": "object", "required": ["clauseId", "clauseSha256"],
      "properties": {
        "clauseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "clauseSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }
      }, "additionalProperties": false
    } },
    "binder": { "type": "object", "required": ["id", "version", "implementationSha256"],
      "properties": {
        "id": { "$ref": "revision-contract-definitions.schema.json#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "implementationSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }
      }, "additionalProperties": false
    },
    "producer": { "$ref": "revision-contract-definitions.schema.json#/$defs/producer" },
    "bindingSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }
  }, "additionalProperties": false
}
