{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://singularity-flow.dev/schemas/gdp-effect-policy.schema.json",
  "title": "GDP Effect Policy v1", "type": "object",
  "required": ["schemaVersion", "kind", "workId", "allowedEffects", "forbiddenEffects", "externalEffects", "protectedPaths", "credentialUse", "effectPolicySha256"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "effect-policy" }, "workId": { "$ref": "#/$defs/id" }, "allowedEffects": { "$ref": "#/$defs/texts" }, "forbiddenEffects": { "$ref": "#/$defs/texts" }, "externalEffects": { "const": "forbidden" }, "protectedPaths": { "const": "promote" }, "credentialUse": { "const": "forbidden" }, "effectPolicySha256": { "$ref": "#/$defs/digest" } },
  "additionalProperties": false, "x-sflow-selfHash": "effectPolicySha256",
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "texts": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } } }
}
