{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-runtime-observation.schema.json",
  "title": "WMB v4 sealed runtime observation",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "metric", "subjectId", "count", "windowStart", "windowEnd", "producerId", "producerVersion", "receiptSha256", "recordSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-runtime-observation" },
    "id": { "$ref": "#/$defs/id" },
    "metric": { "const": "frequency" },
    "subjectId": { "$ref": "#/$defs/id" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "windowStart": { "$ref": "#/$defs/timestamp" },
    "windowEnd": { "$ref": "#/$defs/timestamp" },
    "producerId": { "$ref": "#/$defs/id" },
    "producerVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "receiptSha256": { "$ref": "#/$defs/hash" },
    "recordSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  },
  "additionalProperties": false
}
