{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://singularity-flow.dev/schemas/gdp-agent-steering-decision.schema.json",
  "title": "GDP Agent Steering Decision v1", "type": "object",
  "required": ["schemaVersion", "kind", "workId", "bindingSha256", "processId", "priorCheckpointSha256", "action", "sourceControlEventSha256", "requestedBy", "reasonSha256", "status", "steeringDecisionSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "agent-steering-decision" }, "workId": { "$ref": "#/$defs/id" }, "bindingSha256": { "$ref": "#/$defs/digest" }, "processId": { "$ref": "#/$defs/id" }, "priorCheckpointSha256": { "$ref": "#/$defs/digest" }, "action": { "enum": ["pause", "halt", "narrow"] }, "sourceControlEventSha256": { "$ref": "#/$defs/digest" }, "requestedBy": { "$ref": "#/$defs/actor" }, "reasonSha256": { "$ref": "#/$defs/digest" }, "status": { "const": "recorded" }, "steeringDecisionSha256": { "$ref": "#/$defs/digest" }
  }, "additionalProperties": false, "x-sflow-selfHash": "steeringDecisionSha256",
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "nullableDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "actor": { "type": "object", "required": ["kind", "identity", "authoritySha256"], "properties": { "kind": { "enum": ["human", "policy"] }, "identity": { "type": ["string", "null"], "maxLength": 160 }, "authoritySha256": { "$ref": "#/$defs/nullableDigest" } }, "additionalProperties": false } }
}
