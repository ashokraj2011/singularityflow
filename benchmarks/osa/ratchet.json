    {
      "module": "step-decision.mjs",
      "family": "predicateCalls",
      "stage0": 0,
      "ceiling": 1,
      "kind": "normalizer",
      "final": true,
      "owner": "final owner set: the kernel's record adapter (stepSnapshotOf, OSA:REQ-040)",
      "deletion": "none: permanent while the Story record names its producers; the adapter classifies who builds the step, as the kernel's `kind` fact",
      "why": "phaseKernelOwned classifies the step's execution owner from its configuration, the one place a surface's snapshot is built"
    },
    {
      "module": "action-command-map.mjs",
      "family": "skillChooserCalls",
      "stage0": 0,
      "ceiling": 1,
      "kind": "renderer",
      "final": true,
      "owner": "final owner set: the one action-to-command map (OSA:REQ-021, plan section 7 'Mappings')",
      "deletion": "none: permanent; the map names the step's work command from its configured author, the one chooser call left",
      "why": "workCommandOf reads the step's configured author (generationSkillForPhase) for every route the map renders"
    },
    {
      "module": "action-command-map.mjs",
      "family": "skillLiterals",
      "stage0": 0,
      "ceiling": 1,
      "kind": "renderer",
      "final": true,
      "owner": "final owner set: the one action-to-command map (OSA:REQ-021)",
      "deletion": "none: permanent; /sf-recover is the map's fixed Copilot command for positive damage, written once",
      "why": "ACTION_SKILLS.recover: the only place the recovery skill is named for a step route"
    },
    {
      "module": "command-skills.mjs",
      "family": "skillLiterals",
      "stage0": 0,
      "ceiling": 2,
      "kind": "renderer",
      "final": true,
      "owner": "final owner set: the one list of the work command's names (D1, OSA:REQ-024)",
      "deletion": "none: permanent as the one list of the work command's names; a copy of the two names anywhere else is a new competing route",
      "why": "WORK_COMMANDS names /sf-code and /sf-phase once; the validator and the map read it"
    }
