{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/gdp-proof-signal-observation.schema.json",
  "title": "GDP Proof Signal Observation v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "proofSubjectSha256", "signalId", "inputs", "value", "unit", "assurance", "authority", "gateEligible", "observationSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "proof-signal-observation" },
    "proofSubjectSha256": { "$ref": "#/$defs/digest" }, "signalId": { "$ref": "#/$defs/id" },
    "inputs": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/input" } },
    "value": { "type": ["string", "number", "boolean"], "maxLength": 256 },
    "unit": { "$ref": "#/$defs/id" }, "assurance": { "$ref": "#/$defs/id" },
    "authority": { "const": "none" }, "gateEligible": { "const": false },
    "observationSha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false, "x-sflow-selfHash": "observationSha256",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "input": { "type": "object", "required": ["kind", "sha256"], "properties": { "kind": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }
  }
}
