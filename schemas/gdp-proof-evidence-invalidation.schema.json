{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/gdp-proof-evidence-invalidation.schema.json",
  "title": "GDP Proof Evidence Invalidation v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "proofSubjectSha256", "changedInputs", "invalidatedResults", "invalidatedSummaries", "reasonCode", "invalidationSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "proof-evidence-invalidation" },
    "proofSubjectSha256": { "$ref": "#/$defs/digest" },
    "changedInputs": { "$ref": "#/$defs/digestSet" }, "invalidatedResults": { "$ref": "#/$defs/digestSet" }, "invalidatedSummaries": { "$ref": "#/$defs/digestSet" },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" },
    "invalidationSha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false, "x-sflow-selfHash": "invalidationSha256",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "digestSet": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
  }
}
