{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-repository-domain.schema.json",
  "title": "WMP portable repository domain",
  "type": "object",
  "required": ["schemaVersion", "kind", "repositoryId", "repositoryIdentitySha256", "repositoryDomainSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-repository-domain" },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
    "repositoryIdentitySha256": { "$ref": "#/$defs/hash" },
    "repositoryDomainSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
  "additionalProperties": false
}
