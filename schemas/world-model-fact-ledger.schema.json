{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-fact-ledger.schema.json",
  "title": "WMB v4 fact ledger", "type": "object",
  "required": ["schemaVersion", "kind", "sourceManifestSha256", "scopeManifestSha256", "extractorRegistrySha256", "facts", "ledgerSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-fact-ledger" }, "sourceManifestSha256": { "$ref": "#/$defs/hash" }, "scopeManifestSha256": { "$ref": "#/$defs/hash" }, "extractorRegistrySha256": { "$ref": "#/$defs/hash" },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }, "ledgerSha256": { "$ref": "#/$defs/hash" }
  }, "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "fact": { "type": "object", "required": ["id", "factType", "subject", "claim", "claimSha256", "status", "assurance", "evidenceIds", "derivationId", "conflictsWith", "scopeStatus", "factSha256"], "properties": {
      "id": { "type": "string", "pattern": "^FACT-[a-f0-9]{16,64}$" }, "factType": { "$ref": "#/$defs/factType" },
      "subject": { "type": "object", "required": ["kind", "id"], "properties": { "kind": { "enum": ["repository", "file", "directory", "symbol", "contract", "dependency-edge", "test", "rule", "configuration", "analysis", "runtime-observation", "human-record"] }, "id": { "type": "string", "minLength": 1 } }, "additionalProperties": false }, "claim": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }, "claimSha256": { "$ref": "#/$defs/hash" },
      "status": { "enum": ["available", "partial", "unavailable", "contradicted", "stale"] }, "assurance": { "enum": ["source-exact", "structurally-derived", "deterministically-derived", "human-confirmed", "runtime-observed", "heuristic", "model-advisory", "not-applicable"] },
      "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EV-[a-f0-9]{16,64}$" } }, "derivationId": { "type": "string", "pattern": "^DRV-[a-f0-9]{16,64}$" }, "conflictsWith": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^FACT-[a-f0-9]{16,64}$" } }, "scopeStatus": { "const": "inside" },
      "reason": { "type": "object", "required": ["code", "detail", "attemptedProducer"], "properties": { "code": { "enum": ["UNSUPPORTED_LANGUAGE", "INVALID_UTF8", "PARSE_FAILURE", "FILE_UNREADABLE", "NO_BASELINE", "NO_RUNTIME_EVIDENCE", "NO_REGISTERED_PRODUCER", "OUT_OF_SCOPE", "ANALYSIS_NOT_REQUESTED"] }, "detail": { "type": "string", "minLength": 1 }, "attemptedProducer": { "type": "string", "minLength": 1 } }, "additionalProperties": false }, "factSha256": { "$ref": "#/$defs/hash" }
    }, "additionalProperties": false },
    "factType": { "enum": ["file-exists", "language-detected", "symbol-exists", "symbol-index", "signature", "export", "import-dependency", "dependency-edge", "dependency-analysis", "configuration-object", "changed-symbol", "contract-change", "test-impact", "structural-impact", "runtime-frequency", "interface", "implementation", "consumer-dependency", "schema-contract", "protocol-field", "runtime-guarantee", "change-frequency", "dependency-degree", "complexity-metric", "incident-mapping", "ownership-concentration", "rule-definition", "condition-expression", "clause-binding", "test-identity", "maintainer-record", "business-glossary", "business-meaning"] }
  }, "additionalProperties": false
}
