{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/gdp-environment-profile.schema.json",
  "title": "GDP Environment Profile v1", "type": "object",
  "required": ["schemaVersion", "kind", "proofSubjectSha256", "platform", "architecture", "runtime", "toolchainSha256", "dependencyLockSha256", "localePolicy", "clockPolicy", "profileSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "environment-profile" },
    "proofSubjectSha256": { "$ref": "#/$defs/digest" }, "platform": { "$ref": "#/$defs/id" },
    "architecture": { "$ref": "#/$defs/id" }, "runtime": { "$ref": "#/$defs/id" },
    "toolchainSha256": { "$ref": "#/$defs/nullableDigest" }, "dependencyLockSha256": { "$ref": "#/$defs/nullableDigest" },
    "localePolicy": { "$ref": "#/$defs/id" }, "clockPolicy": { "$ref": "#/$defs/id" },
    "profileSha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false, "x-sflow-selfHash": "profileSha256",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
  }
}
