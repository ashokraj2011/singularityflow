{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/agent-mappings.schema.json",
  "title": "Singularity Flow Copilot agent mappings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mappings"],
  "properties": {
    "version": { "const": 1 },
    "mappings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
