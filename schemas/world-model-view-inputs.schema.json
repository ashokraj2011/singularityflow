{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-view-inputs.schema.json",
  "title": "WMP immutable captured view inputs",
  "type": "object",
  "required": ["schemaVersion", "kind", "modelPayloadSha256", "captures", "viewContractRef", "consumerProfileRef", "selection", "comparisonRef", "evidenceCutRef", "inputManifestSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-view-inputs" },
    "modelPayloadSha256": { "$ref": "#/$defs/hash" },
    "captures": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/capture" } },
    "viewContractRef": { "$ref": "#/$defs/objectRef" },
    "consumerProfileRef": { "$ref": "#/$defs/objectRef" },
    "selection": { "$ref": "#/$defs/selection" },
    "comparisonRef": { "oneOf": [{ "$ref": "#/$defs/objectRef" }, { "type": "null" }] },
    "evidenceCutRef": { "oneOf": [{ "$ref": "#/$defs/objectRef" }, { "type": "null" }] },
    "inputManifestSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "factId": { "type": "string", "pattern": "^FACT-[a-f0-9]{16,64}$" },
    "typeId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 256 },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$", "maxLength": 128 },
    "objectRef": {
      "type": "object",
      "required": ["role", "family", "mediaType", "sha256", "bytes"],
      "properties": {
        "role": { "$ref": "#/$defs/typeId" },
        "family": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
        "mediaType": { "enum": ["application/json", "text/markdown"] },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 }
      },
      "additionalProperties": false
    },
    "captureReason": {
      "type": "object",
      "required": ["code", "observationBoundarySha256", "applicabilitySha256"],
      "properties": {
        "code": { "$ref": "#/$defs/reasonCode" },
        "observationBoundarySha256": { "$ref": "#/$defs/hash" },
        "applicabilitySha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": ["role", "subject", "status", "objectRef", "reason"],
      "properties": {
        "role": { "$ref": "#/$defs/typeId" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "enum": ["available", "unavailable", "not-applicable"] },
        "objectRef": { "oneOf": [{ "$ref": "#/$defs/objectRef" }, { "type": "null" }] },
        "reason": { "oneOf": [{ "$ref": "#/$defs/captureReason" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["kind", "version", "storyScopeSha256", "querySha256", "factIds", "traversal"],
      "properties": {
        "kind": { "const": "wmp/view-selection" },
        "version": { "const": 1 },
        "storyScopeSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "querySha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "factIds": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/factId" } },
        "traversal": {
          "type": "object",
          "required": ["maximumFacts", "maximumEdges", "maximumDepth"],
          "properties": {
            "maximumFacts": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "maximumEdges": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "maximumDepth": { "type": "integer", "minimum": 1, "maximum": 32 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
