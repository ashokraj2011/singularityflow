{
  "name": "singularity-flow-vscode",
  "displayName": "Singularity Flow",
  "version": "0.9.0",
  "private": true,
  "description": "Run the Product Development Lifecycle from the editor: initiatives, stage gates, artifact packs, Stories, and reconciliation.",
  "author": "Singularity Flow",
  "license": "MIT",
  "type": "module",
  "publisher": "singularityflow",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:singularityFlow.navigation",
    "workspaceContains:singularity/workflow.yml"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "singularity-flow.sflow",
        "name": "sflow",
        "fullName": "Singularity Flow",
        "description": "Ask about Singularity Flow workflows, blockers, recovery, commands, AST, and workspaces.",
        "isSticky": true,
        "commands": [
          { "name": "help", "description": "Answer from reviewed Singularity Flow documentation" },
          { "name": "why", "description": "Explain a blocker or refusal" },
          { "name": "how", "description": "Show the reviewed procedure for a task" },
          { "name": "recover", "description": "Find the safe recovery path for a failure" },
          { "name": "topics", "description": "List reviewed offline help topics" }
        ]
      }
    ],
    "configuration": {
      "title": "Singularity Flow",
      "properties": {
        "singularityFlow.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the singularity-flow CLI entry point. Leave empty to use the bundled CLI, then the one on PATH."
        },
        "singularityFlow.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node executable used to run the CLI. Leave empty to use the Node running the extension host."
        },
        "singularityFlow.modelMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "disabled"
          ],
          "enumDescriptions": [
            "Allow operations whose declared policy permits or requires a model.",
            "Disable all kernel-owned model invocation; model-required operations fail before their handler loads."
          ],
          "description": "Controls kernel-owned model invocation for every Singularity Flow command launched by this VS Code window."
        },
        "singularityFlow.userName": {
          "type": "string",
          "default": "",
          "description": "Display name used for local guidance. Governed decisions continue to use Git and provider identities."
        },
        "singularityFlow.role": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "product-owner",
            "business-analyst",
            "product-designer",
            "architect",
            "developer",
            "qa",
            "security",
            "delivery-manager",
            "operations",
            "admin",
            "other"
          ],
          "description": "Machine-local menu persona used to order navigation and suggestions. The active governed agent and approval authority are selected independently by the workflow and identity records."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "singularityFlow.gettingStarted",
        "title": "Get started with Singularity Flow",
        "description": "Map a capability, create its workspace, and start the first governed work item.",
        "steps": [
          {
            "id": "profile",
            "title": "Set your name and role",
            "description": "Choose the local guidance appropriate for your work.",
            "media": {
              "markdown": "media/walkthrough/profile.md"
            },
            "completionEvents": [
              "onCommand:singularityFlow.configureProfile"
            ]
          },
          {
            "id": "jira",
            "title": "Connect Jira securely",
            "description": "Store the token in the operating-system keychain through VS Code SecretStorage.",
            "media": {
              "markdown": "media/walkthrough/jira.md"
            },
            "completionEvents": [
              "onCommand:singularityFlow.connectJira"
            ]
          },
          {
            "id": "workspace",
            "title": "Run the guided start",
            "description": "Move through capability mapping, workspace creation, and first work intake without losing context.",
            "media": {
              "markdown": "media/walkthrough/workspace.md"
            },
            "completionEvents": [
              "onCommand:singularityFlow.startWizard",
              "onCommand:singularityFlow.switchWorkspace",
              "onCommand:singularityFlow.createWorkspace"
            ]
          },
          {
            "id": "intake",
            "title": "Start intake",
            "description": "Choose the work shape and workflow, then hand governed context to native Copilot.",
            "media": {
              "markdown": "media/walkthrough/intake.md"
            },
            "completionEvents": [
              "onCommand:singularityFlow.startWork"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "singularityFlowNavigator",
          "title": "SINGULARITY FLOW",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "singularityFlowNavigator": [
        {
          "id": "singularityFlow.navigation",
          "name": "Navigator",
          "type": "webview"
        }
      ]
    },
