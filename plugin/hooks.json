{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      { "type": "command", "bash": "singularity-flow hook boundary-turn", "powershell": "singularity-flow hook boundary-turn", "timeoutSec": 10 }
    ],
    "preToolUse": [
      { "type": "command", "matcher": "bash|powershell|run_in_terminal|execute|grep|rg|glob|search_code_subagent", "bash": "singularity-flow hook boundary-guard", "powershell": "singularity-flow hook boundary-guard", "timeoutSec": 10 }
    ],
    "sessionEnd": [
      { "type": "command", "bash": "singularity-flow hook boundary-end", "powershell": "singularity-flow hook boundary-end", "timeoutSec": 10 }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "singularity-flow hook agent-start",
        "powershell": "singularity-flow hook agent-start",
        "timeoutSec": 10
      }
    ]
  }
}
