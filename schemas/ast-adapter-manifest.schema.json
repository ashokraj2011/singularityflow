{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/ast-adapter-manifest.schema.json",
  "title": "Singularity Flow AST adapter manifest",
  "type": "object",
  "required": ["protocolVersion", "id", "languages", "assurance", "argv", "extractorVersion"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "assurance": { "enum": ["syntax", "semantic"] },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "extractorVersion": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
