{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/world-model-projection-refusal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "projectionId", "code", "message", "preserved", "refusalSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-projection-refusal" },
    "projectionId": { "const": "arch.calm" }, "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "preserved": { "type": "object" }, "refusalSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
