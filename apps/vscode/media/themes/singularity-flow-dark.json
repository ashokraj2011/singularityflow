{
  "$schema": "vscode://schemas/color-theme",
  "name": "Singularity Flow Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#3d8e10",
    "foreground": "#e4ebe6",
    "descriptionForeground": "#8b978f",
    "disabledForeground": "#5e6a63",
    "widget.shadow": "#00000080",
    "selection.background": "#3d8e1059",
    "sash.hoverBorder": "#3d8e10",
    "textLink.foreground": "#6ea8ff",
    "textLink.activeForeground": "#9cc3ff",
    "textPreformat.foreground": "#e4ebe6",
    "textCodeBlock.background": "#090c0a",
    "textBlockQuote.background": "#141a16",
    "textBlockQuote.border": "#3d8e10a6",

    "titleBar.activeBackground": "#090c0a",
    "titleBar.activeForeground": "#e4ebe6",
    "titleBar.inactiveBackground": "#090c0a",
    "titleBar.inactiveForeground": "#8b978f",
    "titleBar.border": "#1e2822",
    "commandCenter.background": "#0f1411",
    "commandCenter.border": "#2f3b33",
    "commandCenter.activeBorder": "#3d8e10",

    "activityBar.background": "#090c0a",
    "activityBar.foreground": "#e4ebe6",
    "activityBar.inactiveForeground": "#5e6a63",
    "activityBar.activeBorder": "#3d8e10",
    "activityBar.border": "#1e2822",
    "activityBarBadge.background": "#3d8e10",
    "activityBarBadge.foreground": "#031005",

    "sideBar.background": "#0d110e",
    "sideBar.foreground": "#dfe7e1",
    "sideBar.border": "#1e2822",
    "sideBarTitle.foreground": "#e4ebe6",
    "sideBarSectionHeader.background": "#0d110e",
    "sideBarSectionHeader.foreground": "#e4ebe6",
    "sideBarSectionHeader.border": "#1e2822",

    "editor.background": "#0b0e0c",
    "editor.foreground": "#e4ebe6",
    "editor.lineHighlightBackground": "#111712",
    "editor.selectionBackground": "#3d8e1047",
    "editor.inactiveSelectionBackground": "#3d8e1026",
    "editor.findMatchBackground": "#3d8e1066",
    "editor.findMatchHighlightBackground": "#3d8e1033",
    "editorCursor.foreground": "#3d8e10",
    "editorLineNumber.foreground": "#3a463e",
    "editorLineNumber.activeForeground": "#8b978f",
    "editorIndentGuide.background1": "#1a221d",
    "editorIndentGuide.activeBackground1": "#2f3b33",
    "editorGutter.background": "#0b0e0c",
    "editorWidget.background": "#0f1411",
    "editorWidget.border": "#212a24",
    "editorHoverWidget.background": "#0f1411",
    "editorHoverWidget.border": "#212a24",
    "editorSuggestWidget.background": "#0f1411",
    "editorSuggestWidget.border": "#212a24",
    "editorSuggestWidget.selectedBackground": "#16240f",
    "editorSuggestWidget.highlightForeground": "#3d8e10",
    "breadcrumb.background": "#0b0e0c",
    "breadcrumb.foreground": "#8b978f",
    "breadcrumb.focusForeground": "#e4ebe6",

    "editorGroupHeader.tabsBackground": "#090c0a",
    "editorGroupHeader.tabsBorder": "#1e2822",
    "editorGroup.border": "#1e2822",
    "tab.activeBackground": "#0b0e0c",
    "tab.activeForeground": "#e4ebe6",
    "tab.activeBorderTop": "#3d8e10",
    "tab.inactiveBackground": "#090c0a",
    "tab.inactiveForeground": "#8b978f",
    "tab.hoverBackground": "#111712",
    "tab.border": "#1e2822",

    "panel.background": "#0b0e0c",
    "panel.border": "#1e2822",
    "panelTitle.activeBorder": "#3d8e10",
    "panelTitle.activeForeground": "#e4ebe6",
    "panelTitle.inactiveForeground": "#8b978f",
    "terminal.background": "#0b0e0c",
    "terminal.foreground": "#e4ebe6",
    "terminalCursor.foreground": "#3d8e10",
    "terminal.ansiGreen": "#3d8e10",
    "terminal.ansiBrightGreen": "#5fb32a",

    "statusBar.background": "#090c0a",
    "statusBar.foreground": "#8b978f",
    "statusBar.border": "#1e2822",
    "statusBar.noFolderBackground": "#090c0a",
    "statusBar.debuggingBackground": "#3d8e10",
    "statusBar.debuggingForeground": "#031005",
    "statusBarItem.hoverBackground": "#141a16",
    "statusBarItem.remoteBackground": "#3d8e10",
    "statusBarItem.remoteForeground": "#031005",
    "statusBarItem.prominentBackground": "#3d8e10",
    "statusBarItem.prominentForeground": "#031005",

    "button.background": "#3d8e10",
    "button.foreground": "#031005",
    "button.hoverBackground": "#357c0e",
    "button.secondaryBackground": "#141a16",
    "button.secondaryForeground": "#e4ebe6",
    "button.secondaryHoverBackground": "#1a2a14",
    "badge.background": "#3d8e10",
    "badge.foreground": "#031005",
    "progressBar.background": "#3d8e10",
    "checkbox.background": "#090c0a",
    "checkbox.border": "#2f3b33",
    "input.background": "#090c0a",
    "input.foreground": "#e4ebe6",
    "input.border": "#2f3b33",
    "input.placeholderForeground": "#5e6a63",
    "inputOption.activeBorder": "#3d8e10",
    "dropdown.background": "#090c0a",
    "dropdown.border": "#2f3b33",

    "list.activeSelectionBackground": "#16240f",
    "list.activeSelectionForeground": "#e4ebe6",
    "list.inactiveSelectionBackground": "#141a16",
    "list.hoverBackground": "#141a16",
    "list.focusOutline": "#3d8e10",
    "list.highlightForeground": "#3d8e10",
    "quickInput.background": "#0f1411",
    "quickInputList.focusBackground": "#16240f",
    "menu.background": "#0f1411",
    "menu.border": "#212a24",
    "menu.selectionBackground": "#16240f",
    "notifications.background": "#0f1411",
    "notifications.border": "#212a24",
    "scrollbarSlider.background": "#2f3b3380",
    "scrollbarSlider.hoverBackground": "#2f3b33c0",
    "scrollbarSlider.activeBackground": "#3d8e1080"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5e6a63", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#3d8e10" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#f0c674" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#e4ebe6" } },
    { "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#3d8e10" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f0c674" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#3d8e10", "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#5fb32a" } },
    { "scope": ["markup.deleted", "invalid"], "settings": { "foreground": "#f87171" } }
  ]
}
