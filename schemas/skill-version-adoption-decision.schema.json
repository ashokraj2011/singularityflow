{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/skill-version-adoption-decision.schema.json",
  "title": "Immutable approved Story skill-version adoption decision",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "id", "workId", "status", "proposedBy",
    "proposalSha256", "impactSha256", "approvedAt", "approvals", "from", "to"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "skill-version-adoption-decision" },
    "id": { "type": "string", "pattern": "^SAM-[0-9]{3,6}$" },
    "workId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "const": "approved" },
    "proposedBy": { "$ref": "#/$defs/actor" },
    "proposalSha256": { "$ref": "#/$defs/sha256" },
    "impactSha256": { "$ref": "#/$defs/sha256" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "approvals": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["actor", "authorityGroup", "identityAssurance", "at"],
        "properties": {
          "actor": { "$ref": "#/$defs/actor" },
          "authorityGroup": { "$ref": "#/$defs/kebabId" },
          "identityAssurance": { "enum": ["configured-local", "github-authenticated"] },
          "at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "from": {
      "type": "object",
      "required": ["revision", "snapshotHash", "policySha256"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "snapshotHash": { "$ref": "#/$defs/sha256" },
        "policySha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "to": {
      "type": "object",
      "required": ["revision", "policySha256", "configurationCommit", "skillId", "packageSha256", "phaseBindings"],
      "properties": {
        "revision": { "type": "integer", "minimum": 2 },
        "policySha256": { "$ref": "#/$defs/sha256" },
        "configurationCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "skillId": { "$ref": "#/$defs/kebabId" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "phaseBindings": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["phaseId", "contractSha256", "compilationSha256", "parserProfile", "bindingRefsSha256"],
            "properties": {
              "phaseId": { "$ref": "#/$defs/kebabId" },
              "contractSha256": { "$ref": "#/$defs/sha256" },
              "compilationSha256": { "$ref": "#/$defs/sha256" },
              "parserProfile": { "const": "skp-skill-text/v1" },
              "bindingRefsSha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "kebabId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "actor": {
      "type": "object",
      "anyOf": [
        { "required": ["email"], "properties": { "email": { "type": "string", "minLength": 3 } } },
        { "required": ["login"], "properties": { "login": { "type": "string", "minLength": 1 } } }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
