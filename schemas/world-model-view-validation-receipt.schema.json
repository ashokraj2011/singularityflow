{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-view-validation-receipt.schema.json",
  "title": "WMB v4 view validation receipt", "type": "object",
  "required": ["schemaVersion", "kind", "viewId", "viewVersion", "candidateSha256", "candidateSchemaSha256", "viewSpecSha256", "factLedgerSha256", "scopeSha256", "checks", "status", "validatorSha256", "receiptSha256"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-view-validation-receipt" }, "viewId": { "type": "string" }, "viewVersion": { "type": "integer", "minimum": 1 }, "candidateSha256": { "$ref": "#/$defs/hash" }, "candidateSchemaSha256": { "$ref": "#/$defs/hash" }, "viewSpecSha256": { "$ref": "#/$defs/hash" }, "factLedgerSha256": { "$ref": "#/$defs/hash" }, "scopeSha256": { "$ref": "#/$defs/hash" }, "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string" }, "status": { "enum": ["pass", "fail"] }, "detail": { "type": "string" } }, "additionalProperties": false } }, "status": { "enum": ["passed", "failed"] }, "validatorSha256": { "$ref": "#/$defs/hash" }, "receiptSha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }, "additionalProperties": false
}
