{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-read-activation.schema.json",
  "title": "FWM registry activation",
  "type": "object",
  "required": ["schemaVersion", "kind", "registrySha256", "activeViews", "aliases", "consumers", "status", "activationSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-read-activation" },
    "registrySha256": { "$ref": "#/$defs/hash" },
    "activeViews": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/exactView" } },
    "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "object", "required": ["name", "viewRef"], "properties": { "name": { "$ref": "#/$defs/view" }, "viewRef": { "$ref": "#/$defs/exactView" } }, "additionalProperties": false } },
    "consumers": { "type": "array", "minItems": 1, "items": { "$ref": "world-model-read-consumer.schema.json" } },
    "status": { "const": "active" },
    "activationSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "view": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "exactView": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+@[1-9][0-9]*$" }
  },
  "additionalProperties": false
}
