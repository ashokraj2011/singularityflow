{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/world-model-projection-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "projectionId", "projectionVersion", "inputs", "mapper", "output", "validation", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-projection-receipt" },
    "projectionId": { "const": "arch.calm" }, "projectionVersion": { "const": 1 },
    "inputs": { "type": "object" }, "mapper": { "type": "object" },
    "output": { "type": "object" }, "validation": { "type": "object" },
    "receiptSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
