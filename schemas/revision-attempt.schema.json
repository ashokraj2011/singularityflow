{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/revision-attempt.schema.json",
  "title": "Singularity Flow immutable revision attempt v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "attemptId", "intervalId", "sequence", "subject", "parentCandidate", "provider", "status", "reasonCode", "effectSetSha256", "resultCandidate", "restorationReceiptSha256", "startedAt", "endedAt", "producer", "attemptSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "revision-attempt" },
    "attemptId": { "type": "string", "pattern": "^REVATT-[A-Za-z0-9._:-]{4,127}$" },
    "intervalId": { "type": "string", "pattern": "^REV-[A-Za-z0-9._:-]{4,127}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 64 },
    "subject": { "$ref": "revision-contract-definitions.schema.json#/$defs/subject" },
    "parentCandidate": { "$ref": "revision-contract-definitions.schema.json#/$defs/candidate" },
    "provider": { "$ref": "revision-contract-definitions.schema.json#/$defs/producer" },
    "status": { "enum": ["started", "refused-restored", "failed-restored", "cancelled-restored", "candidate-frozen", "recovery-required"] },
    "reasonCode": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "effectSetSha256": { "oneOf": [{ "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }, { "type": "null" }] },
    "resultCandidate": { "oneOf": [{ "$ref": "revision-contract-definitions.schema.json#/$defs/publishedCandidate" }, { "type": "null" }] },
    "restorationReceiptSha256": { "oneOf": [{ "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }, { "type": "null" }] },
    "startedAt": { "$ref": "revision-contract-definitions.schema.json#/$defs/timestamp" },
    "endedAt": { "oneOf": [{ "$ref": "revision-contract-definitions.schema.json#/$defs/timestamp" }, { "type": "null" }] },
    "producer": { "$ref": "revision-contract-definitions.schema.json#/$defs/producer" },
    "attemptSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }
  }, "additionalProperties": false
}
