{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/sgos-contract.schema.json",
  "title": "SingularityFlow SGOS durable contracts",
  "oneOf": [
    { "$ref": "#/$defs/intentEnvelope" },
    { "$ref": "#/$defs/intentIr" },
    { "$ref": "#/$defs/workflowIr" },
    { "$ref": "#/$defs/workflowRatification" },
    { "$ref": "#/$defs/policySnapshot" },
    { "$ref": "#/$defs/candidateSnapshot" },
    { "$ref": "#/$defs/resourceLease" },
    { "$ref": "#/$defs/joinReceipt" },
    { "$ref": "#/$defs/fanoutExpansionReceipt" },
    { "$ref": "#/$defs/sgosReplayPlan" },
    { "$ref": "#/$defs/processBinding" },
    { "$ref": "#/$defs/gvmProgram" },
    { "$ref": "#/$defs/gvmProcess" },
    { "$ref": "#/$defs/sgosRecordIndex" },
    { "$ref": "#/$defs/sgosControlEvent" },
    { "$ref": "#/$defs/sgosControlSuccessor" },
    { "$ref": "#/$defs/sgosTransitionIntent" },
    { "$ref": "#/$defs/gvmTaskAttempt" },
    { "$ref": "#/$defs/gvmTaskReceipt" },
    { "$ref": "#/$defs/gvmCheckpoint" },
    { "$ref": "#/$defs/humanRequest" },
    { "$ref": "#/$defs/humanResponse" },
    { "$ref": "#/$defs/agentProposal" },
    { "$ref": "#/$defs/actionEvidence" },
    { "$ref": "#/$defs/workObject" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "principal": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "service", "agent", "system", "external"] },
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "authoritySha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "configurationAuthority": {
      "type": "object",
      "required": ["kind", "ref", "commit", "workflowBlobSha256"],
      "properties": {
        "kind": { "enum": ["approved-configuration-ref", "verified-state-mirror"] },
        "ref": { "type": "string", "pattern": "^refs/(?:heads|remotes)/[A-Za-z0-9._/-]+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "workflowBlobSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "storySubjectAuthority": {
      "type": "object",
      "required": ["kind", "subjectId", "revision", "path", "blobSha256", "stateSha256"],
      "properties": {
                "kind": { "enum": ["governed-story-baseline"] },
        "subjectId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
                "path": { "type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).+[^/]$" },
        "blobSha256": { "$ref": "#/$defs/sha256" },
        "stateSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "executionAdmissionSource": {
      "type": "object",
      "required": ["kind", "ref", "commit", "sourceCommit", "path", "blobSha256", "configurationAuthority"],
      "properties": {
        "kind": { "enum": ["approved-configuration-ref", "verified-state-mirror"] },
        "ref": { "type": "string", "pattern": "^refs/(?:heads|remotes)/[A-Za-z0-9._/-]+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "path": { "type": "string", "minLength": 1 },
        "blobSha256": { "$ref": "#/$defs/sha256" },
        "configurationAuthority": { "$ref": "#/$defs/configurationAuthority" }
      },
      "additionalProperties": false
    },
    "executionAdmission": {
      "type": "object",
      "required": ["admitted", "programId", "programSha256", "provenance", "safety"],
      "properties": {
        "admitted": { "const": true },
        "programId": { "type": "string", "pattern": "^PRG-" },
        "programSha256": { "$ref": "#/$defs/sha256" },
        "provenance": {
          "type": "object",
          "required": ["method", "programSha256", "ratificationSha256", "source"],
          "properties": {
            "method": { "enum": ["approved-program-authority", "approved-authority+deterministic-recompilation"] },
            "programSha256": { "$ref": "#/$defs/sha256" },
            "intentIrSha256": { "$ref": "#/$defs/sha256" },
            "workflowSha256": { "$ref": "#/$defs/sha256" },
            "ratificationSha256": { "$ref": "#/$defs/sha256" },
            "source": { "$ref": "#/$defs/executionAdmissionSource" }
          },
          "additionalProperties": false
        },
        "safety": {
          "type": "object",
          "required": ["safe", "programId", "programSha256", "compiler", "graph", "registry"],
          "properties": {
            "safe": { "const": true },
            "programId": { "type": "string", "pattern": "^PRG-" },
            "programSha256": { "$ref": "#/$defs/sha256" },
            "compiler": {
              "type": "object",
              "required": ["id", "version"],
              "properties": {
                "id": { "type": "string" },
                "version": { "type": "string" },
                "sourceSha256": { "$ref": "#/$defs/sha256" }
              },
              "additionalProperties": false
            },
            "graph": {
              "type": "object",
              "required": ["taskCount", "edgeCount", "roots", "terminalTaskIds", "topologicalOrder"],
              "properties": {
                "taskCount": { "type": "integer", "minimum": 0 },
                "edgeCount": { "type": "integer", "minimum": 0 },
                "roots": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                "terminalTaskIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                "topologicalOrder": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              },
              "additionalProperties": false
            },
            "registry": {
              "type": "object",
              "required": ["verified", "registrySnapshotSha256"],
              "properties": {
                "verified": { "type": "boolean" },
                "registrySnapshotSha256": { "$ref": "#/$defs/sha256" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "humanAuthorityRequirement": {
      "type": "object",
      "required": ["kind", "id", "minimumAssurance", "authoritySha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "minimumAssurance": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "authoritySha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "processAuthorityBinding": {
      "type": "object",
      "required": ["kind", "subjectId", "subjectAuthority", "branch", "baselineRevision", "baselineSnapshotSha256", "authority", "configurationAuthority", "humanAuthorityRequirements", "executionAdmission"],
      "properties": {
        "kind": { "enum": ["story", "repository"] },
        "subjectId": { "type": "string", "minLength": 1 },
        "subjectAuthority": { "oneOf": [{ "$ref": "#/$defs/storySubjectAuthority" }, { "type": "null" }] },
        "branch": { "type": "string", "minLength": 1 },
        "baselineRevision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "baselineSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "authority": { "enum": ["existing-story-lifecycle", "existing-repository-baseline"] },
        "configurationAuthority": { "$ref": "#/$defs/configurationAuthority" },
        "humanAuthorityRequirements": { "type": "array", "items": { "$ref": "#/$defs/humanAuthorityRequirement" } },
        "executionAdmission": { "$ref": "#/$defs/executionAdmission" }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "story" },
            "subjectAuthority": { "$ref": "#/$defs/storySubjectAuthority" },
            "authority": { "const": "existing-story-lifecycle" }
          }
        },
        {
          "properties": {
            "kind": { "const": "repository" },
            "subjectAuthority": { "type": "null" },
            "authority": { "const": "existing-repository-baseline" }
          }
        }
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["passed", "failed", "unavailable"] },
        "checksSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "intentEnvelope": {
      "type": "object",
      "required": ["schemaVersion", "kind", "intentId", "generation", "principal", "source", "rawRef", "rawSha256", "attachments", "capturedAt", "envelopeSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "intent-envelope" },
        "intentId": { "type": "string", "pattern": "^INT-" },
        "generation": { "type": "integer", "minimum": 1 },
        "principal": { "$ref": "#/$defs/principal" },
        "source": {
          "type": "object",
          "required": ["kind", "revision"],
          "properties": {
            "kind": { "enum": ["natural-language", "structured-api", "jira-issue", "document", "goal", "incident-event", "policy-change", "existing-adhoc-work", "scheduled-trigger", "external-system-signal"] },
            "revision": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "rawRef": { "type": "string", "minLength": 1 },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "attachments": { "type": "array", "items": { "type": "object" } },
        "capturedAt": { "$ref": "#/$defs/timestamp" },
        "envelopeSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "intentIr": {
      "type": "object",
      "required": ["schemaVersion", "kind", "intentId", "generation", "objective", "outcomes", "successCriteria", "constraints", "invariants", "preferences", "nonGoals", "assumptions", "unknowns", "contradictions", "risks", "subjects", "evidenceExpectations", "authorityRequirements", "budgets", "domainCandidates", "workTypeCandidates", "intentIrSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "intent-ir" },
        "intentId": { "type": "string", "pattern": "^INT-" },
        "generation": { "type": "integer", "minimum": 1 },
        "objective": { "type": "object" },
        "outcomes": { "type": "array" },
        "successCriteria": { "type": "array" },
        "constraints": { "type": "array" },
        "invariants": { "type": "array" },
        "preferences": { "type": "array" },
        "nonGoals": { "type": "array" },
        "assumptions": { "type": "array" },
        "unknowns": { "type": "array" },
        "contradictions": { "type": "array" },
        "risks": { "type": "array" },
        "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
        "evidenceExpectations": { "type": "array" },
        "authorityRequirements": { "type": "array" },
        "budgets": { "type": "array" },
        "domainCandidates": { "type": "array" },
        "workTypeCandidates": { "type": "array" },
        "intentIrSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "workflowIr": {
      "type": "object",
      "required": ["schemaVersion", "kind", "apiVersion", "workflowId", "version", "intentIrSha256", "policySnapshotSha256", "metadata", "spec", "workflowSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "workflow-ir" },
        "apiVersion": { "const": "sflow/v1" },
        "workflowId": { "type": "string", "pattern": "^WFL-" },
        "version": { "type": "string", "minLength": 1 },
        "intentIrSha256": { "$ref": "#/$defs/sha256" },
        "policySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "metadata": { "type": "object" },
        "spec": { "type": "object" },
        "workflowSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "workflowRatification": {
      "type": "object",
      "required": ["schemaVersion", "kind", "ratificationId", "intentIrSha256", "workflowSha256", "policySnapshotSha256", "registrySnapshotSha256", "storageProfileSha256", "packetSha256", "decision", "principal", "decidedAt", "ratificationSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "workflow-ratification" },
        "ratificationId": { "type": "string", "pattern": "^RAT-" },
        "intentIrSha256": { "$ref": "#/$defs/sha256" },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "policySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "registrySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "storageProfileSha256": { "$ref": "#/$defs/sha256" },
        "packetSha256": { "$ref": "#/$defs/sha256" },
        "decision": { "enum": ["ratified", "approved", "rejected", "changes-requested"] },
        "principal": { "$ref": "#/$defs/principal" },
        "intentWorkflowMap": { "type": "object" },
        "coverage": { "type": "object" },
        "decidedAt": { "$ref": "#/$defs/timestamp" },
        "ratificationSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "policySnapshot": {
      "type": "object",
      "required": ["schemaVersion", "kind", "policyId", "authorityRevision", "lawSha256", "registrySha256", "executionUnitPolicySha256", "devicePolicySha256", "storagePolicySha256", "memoryPolicySha256", "humanAuthoritySha256", "governedRootsSha256", "verificationPolicySha256", "publicationPolicySha256", "snapshotSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "policy-snapshot" },
        "policyId": { "type": "string", "pattern": "^POL-" },
        "authorityRevision": { "type": "string", "minLength": 1 },
        "lawSha256": { "$ref": "#/$defs/sha256" },
        "registrySha256": { "$ref": "#/$defs/sha256" },
        "executionUnitPolicySha256": { "$ref": "#/$defs/sha256" },
        "devicePolicySha256": { "$ref": "#/$defs/sha256" },
        "storagePolicySha256": { "$ref": "#/$defs/sha256" },
        "memoryPolicySha256": { "$ref": "#/$defs/sha256" },
        "humanAuthoritySha256": { "$ref": "#/$defs/sha256" },
        "governedRootsSha256": { "$ref": "#/$defs/sha256" },
        "verificationPolicySha256": { "$ref": "#/$defs/sha256" },
        "publicationPolicySha256": { "$ref": "#/$defs/sha256" },
        "snapshotSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "candidateResource": {
      "type": "object",
      "required": ["path", "type", "mode", "contentSha256", "operation", "renameFrom", "renameTo", "deletion"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "enum": ["file", "symlink", "directory"] },
        "mode": { "enum": ["100644", "100755", "120000", "040000", null] },
        "contentSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "operation": { "enum": ["added", "modified", "deleted", "renamed", "copied", "type-changed"] },
        "renameFrom": { "type": ["string", "null"] },
        "renameTo": { "type": ["string", "null"] },
        "deletion": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "candidateSnapshot": {
      "type": "object",
      "required": ["schemaVersion", "kind", "candidateId", "subject", "baseline", "candidate", "resources", "createdBy", "createdAt", "candidateSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "candidate-snapshot" },
        "candidateId": { "type": "string", "pattern": "^CAN-" },
        "subject": { "$ref": "#/$defs/subject" },
        "baseline": {
          "type": "object",
          "required": ["revision", "snapshotSha256"],
          "properties": { "revision": { "type": "string" }, "snapshotSha256": { "$ref": "#/$defs/sha256" } },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": ["snapshotSha256", "manifestSha256"],
          "properties": { "snapshotSha256": { "$ref": "#/$defs/sha256" }, "manifestSha256": { "$ref": "#/$defs/sha256" } },
          "additionalProperties": false
        },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/candidateResource" } },
        "createdBy": { "$ref": "#/$defs/principal" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "candidateSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "resourceLease": {
      "type": "object",
      "required": ["schemaVersion", "kind", "leaseId", "processId", "taskInstanceId", "attemptId", "resources", "acquiredAt", "expiresAt", "leaseSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "resource-lease" },
        "leaseId": { "type": "string", "pattern": "^RLS-" },
        "processId": { "type": "string", "pattern": "^PROC-" },
        "taskInstanceId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "pattern": "^ATT-" },
        "resources": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {
            "type": "object", "required": ["key", "mode"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["read", "write", "device", "external-effect"] }
            },
            "additionalProperties": false
          }
        },
        "acquiredAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "leaseSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "joinReceipt": {
      "type": "object",
      "required": ["schemaVersion", "kind", "joinReceiptId", "processId", "taskInstanceId", "attemptId", "joinId", "policy", "predecessors", "outputRefs", "completedAt", "joinReceiptSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "join-receipt" },
        "joinReceiptId": { "type": "string", "pattern": "^JNR-" },
        "processId": { "type": "string", "pattern": "^PROC-" },
        "taskInstanceId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "pattern": "^ATT-" },
        "joinId": { "type": "string", "minLength": 1 },
        "policy": { "enum": ["all-success", "all-terminal"] },
        "predecessors": {
          "type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["taskInstanceId", "state", "receiptSha256", "attemptId"],
            "properties": {
              "taskInstanceId": { "type": "string", "minLength": 1 },
              "state": { "enum": ["succeeded", "failed", "blocked", "cancelled", "skipped"] },
              "receiptSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
              "attemptId": { "oneOf": [{ "type": "string", "pattern": "^ATT-" }, { "type": "null" }] }
            },
            "additionalProperties": false
          }
        },
        "outputRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "joinReceiptSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "fanoutExpansionReceipt": {
      "type": "object",
      "required": ["schemaVersion", "kind", "expansionId", "processId", "parentTaskTemplateId", "collectionSha256", "maximumItems", "maximumParallel", "items", "createdAt", "expansionSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "fanout-expansion-receipt" },
        "expansionId": { "type": "string", "pattern": "^FOX-" },
        "processId": { "type": "string", "pattern": "^PROC-" },
        "parentTaskTemplateId": { "type": "string", "minLength": 1 },
        "collectionSha256": { "$ref": "#/$defs/sha256" },
        "maximumItems": { "type": "integer", "minimum": 0, "maximum": 256 },
        "maximumParallel": { "type": "integer", "minimum": 1, "maximum": 8 },
        "items": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["itemKey", "itemSha256", "taskTemplateId", "taskInstanceId"],
            "properties": {
              "itemKey": { "type": "string", "minLength": 1 },
              "itemSha256": { "$ref": "#/$defs/sha256" },
              "taskTemplateId": { "type": "string", "minLength": 1 },
              "taskInstanceId": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "expansionSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "sgosReplayPlanPriorTask": {
      "type": "object",
      "required": ["taskInstanceId", "taskTemplateId", "state", "revision", "inputRefs", "attemptIds", "receiptSha256", "outputRefs", "invalidatedBy"],
      "properties": {
        "taskInstanceId": { "type": "string", "minLength": 1 },
        "taskTemplateId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["planned", "waiting", "ready", "leased", "running", "waiting-human", "verifying", "succeeded", "failed", "blocked", "cancelled", "invalidated", "recovery-required", "skipped"] },
        "revision": { "type": "integer", "minimum": 1 },
        "inputRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "attemptIds": { "type": "array", "items": { "type": "string", "pattern": "^ATT-" }, "uniqueItems": true },
        "receiptSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "outputRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "invalidatedBy": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "sgosReplayPlan": {
      "type": "object",
      "required": ["schemaVersion", "kind", "replayPlanId", "processId", "expectedProcessRevision", "expectedProcessSha256", "programSha256", "policySnapshotSha256", "processBindingSha256", "fromCheckpointSha256", "taskInstanceIds", "priorTasks", "createdAt", "replayPlanSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sgos-replay-plan" },
        "replayPlanId": { "type": "string", "pattern": "^RPL-[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$" },
