{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-shared-cache-bundle.schema.json",
  "title": "WMB v4 shared Derived-Memory cache bundle",
  "type": "object",
  "required": ["schemaVersion", "kind", "cacheKeySha256", "components", "view", "candidate", "validationReceipt", "createdAt", "bundleSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-shared-cache-bundle" },
    "cacheKeySha256": { "$ref": "#/$defs/hash" },
    "components": { "type": "object" },
    "view": { "type": "string", "minLength": 1 },
    "candidate": { "type": "object" },
    "validationReceipt": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "bundleSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
  "additionalProperties": false
}
