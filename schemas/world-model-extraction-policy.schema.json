{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-extraction-policy.schema.json",
  "title": "WMP exact extraction policy",
  "type": "object",
  "required": ["schemaVersion", "kind", "policySnapshotSha256", "allowedExtractors", "factSemantics", "permissions", "extractionPolicySha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-extraction-policy" },
    "policySnapshotSha256": { "$ref": "#/$defs/hash" },
    "allowedExtractors": { "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/$defs/extractor" } },
    "factSemantics": {
      "type": "object",
      "required": ["allowedFactTypes", "requiredFactTypes", "optionalFactTypes", "requiredUnavailableSubjects", "coverageExtractorRefs"],
      "properties": {
        "allowedFactTypes": { "$ref": "#/$defs/types" },
        "requiredFactTypes": { "$ref": "#/$defs/types" },
        "optionalFactTypes": { "$ref": "#/$defs/types" },
        "requiredUnavailableSubjects": { "$ref": "#/$defs/types" },
        "coverageExtractorRefs": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" } }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["source", "externalInputs", "network", "model"],
      "properties": { "source": { "const": "exact-captured" }, "externalInputs": { "const": "captured-only" }, "network": { "const": "none" }, "model": { "const": "never" } },
      "additionalProperties": false
    },
    "extractionPolicySha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" },
    "types": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" } },
    "extractor": {
      "type": "object", "required": ["id", "version", "implementationSha256", "manifestSha256", "coverage"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }, "version": { "$ref": "#/$defs/semver" }, "implementationSha256": { "$ref": "#/$defs/hash" }, "manifestSha256": { "$ref": "#/$defs/hash" }, "coverage": { "enum": ["path", "global"] } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
