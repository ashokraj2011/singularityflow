{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/world-model-projection-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "contracts", "registrySha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-projection-registry" },
    "contracts": { "type": "array", "minItems": 1 }, "registrySha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
