{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-read-view-descriptor.schema.json",
  "title": "FWM immutable read-view descriptor",
  "type": "object",
  "required": ["schemaVersion", "kind", "name", "revision", "title", "handlerRef", "implementationSha256", "queryProfileRef", "parameterSchemaRef", "resultSchemaRef", "inputKinds", "requiredDomains", "requiredCapabilities", "consumerClasses", "freshnessPolicyRef", "admissibilityProfileRef", "coverageContractRef", "orderingProfileRef", "budgetProfileRef", "renderProfileRef", "dependencyViews", "validationProfileRef", "outputUse", "permissions", "lifecycle", "descriptorSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-read-view-descriptor" },
    "name": { "$ref": "#/$defs/view" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "handlerRef": { "$ref": "#/$defs/ref" },
    "implementationSha256": { "$ref": "#/$defs/hash" },
    "queryProfileRef": { "$ref": "#/$defs/ref" },
    "parameterSchemaRef": { "$ref": "#/$defs/ref" },
    "resultSchemaRef": { "$ref": "#/$defs/ref" },
    "inputKinds": { "$ref": "#/$defs/lowers" },
    "requiredDomains": { "$ref": "#/$defs/lowers" },
    "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" } },
    "consumerClasses": { "$ref": "#/$defs/lowers" },
    "freshnessPolicyRef": { "$ref": "#/$defs/ref" },
    "admissibilityProfileRef": { "$ref": "#/$defs/ref" },
    "coverageContractRef": { "$ref": "#/$defs/ref" },
    "orderingProfileRef": { "$ref": "#/$defs/ref" },
    "budgetProfileRef": { "$ref": "#/$defs/ref" },
    "renderProfileRef": { "$ref": "#/$defs/ref" },
    "dependencyViews": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/exactView" } },
    "validationProfileRef": { "$ref": "#/$defs/ref" },
    "outputUse": { "enum": ["advisory", "explanatory", "verifier-input"] },
    "permissions": { "type": "object", "required": ["model", "network", "sourceWrites", "domainWrites", "derivedCacheWrites"], "properties": { "model": { "const": "never" }, "network": { "const": "none" }, "sourceWrites": { "const": false }, "domainWrites": { "const": false }, "derivedCacheWrites": { "const": true } }, "additionalProperties": false },
    "lifecycle": { "enum": ["active", "draft", "deprecated", "retired-for-new-use", "archived"] },
    "descriptorSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "view": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "exactView": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+@[1-9][0-9]*$" },
    "lower": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "lowers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lower" } },
    "ref": { "type": "string", "pattern": "^(?:handler|profile|schema|freshness|admissibility|coverage|order|budget|render|validation):[a-z0-9][a-z0-9.-]*@[1-9][0-9]*$" }
  },
  "additionalProperties": false
}
