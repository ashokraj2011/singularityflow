{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/gdp-contract-freeze.schema.json",
  "title": "GDP M0 design-only contract freeze",
  "$comment": "These closed shapes are not registered runtime schemas and authorize no governed writer.",
  "oneOf": [
    { "$ref": "#/$defs/proofSubject" },
    { "$ref": "#/$defs/deliverySelection" },
    { "$ref": "#/$defs/proofPredicateResult" },
    { "$ref": "#/$defs/proofSummary" },
    { "$ref": "#/$defs/changePassport" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "boundedId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "worldModelBinding": {
      "type": "object",
      "required": ["status", "baselineSha256", "candidateDeltaSha256", "reasonCode"],
      "properties": {
        "status": {
          "enum": ["ready", "unavailable", "not-required"]
        },
        "baselineSha256": { "$ref": "#/$defs/nullableDigest" },
        "candidateDeltaSha256": { "$ref": "#/$defs/nullableDigest" },
        "reasonCode": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "proofSubject": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "workId",
        "candidateSha256",
        "completionContractSha256",
        "effectPolicySha256",
        "proofPolicySha256",
        "proofProfile",
        "worldModel",
        "proofSubjectSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "proof-subject" },
        "workId": { "$ref": "#/$defs/boundedId" },
        "candidateSha256": { "$ref": "#/$defs/digest" },
        "completionContractSha256": { "$ref": "#/$defs/digest" },
        "effectPolicySha256": { "$ref": "#/$defs/digest" },
        "proofPolicySha256": { "$ref": "#/$defs/digest" },
        "proofProfile": { "enum": ["standard", "high-assurance", "regulated", "custom-registered"] },
        "worldModel": { "$ref": "#/$defs/worldModelBinding" },
        "proofSubjectSha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false,
      "x-sflow-selfHash": "proofSubjectSha256",
      "x-sflow-semanticFields": [
        "schemaVersion",
        "kind",
        "workId",
        "candidateSha256",
        "completionContractSha256",
        "effectPolicySha256",
        "proofPolicySha256",
        "proofProfile",
        "worldModel"
      ]
    },
    "selectedBy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "identity", "authoritySha256"],
          "properties": {
            "kind": { "const": "human" },
            "identity": { "type": "string", "minLength": 1, "maxLength": 320 },
            "authoritySha256": { "type": "null" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "identity", "authoritySha256"],
          "properties": {
            "kind": { "const": "policy" },
            "identity": { "type": "null" },
            "authoritySha256": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        }
      ]
    },
    "deliverySelection": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "workId",
        "selectionStrategy",
        "deliveryMode",
        "workflowProfile",
        "executionProvider",
        "executionPace",
        "autonomyCeiling",
        "proofProfile",
        "proofPolicySha256",
        "policySnapshotSha256",
        "selectedBy",
        "selectionReason",
        "selectionSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "delivery-selection" },
        "workId": { "$ref": "#/$defs/boundedId" },
        "selectionStrategy": { "enum": ["recommend", "fixed", "human-choice"] },
        "deliveryMode": { "enum": ["workflow", "outcome"] },
        "workflowProfile": {
          "oneOf": [
            { "$ref": "#/$defs/boundedId" },
            { "type": "null" }
          ]
        },
        "executionProvider": { "$ref": "#/$defs/boundedId" },
        "executionPace": { "enum": ["manual", "assisted", "auto"] },
        "autonomyCeiling": { "enum": ["A0", "A1", "A2", "A3"] },
        "proofProfile": { "enum": ["standard", "high-assurance", "regulated", "custom-registered"] },
        "proofPolicySha256": { "$ref": "#/$defs/digest" },
        "policySnapshotSha256": { "$ref": "#/$defs/digest" },
        "selectedBy": { "$ref": "#/$defs/selectedBy" },
        "selectionReason": { "$ref": "#/$defs/boundedId" },
        "selectionSha256": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "deliveryMode": { "const": "workflow" } },
            "required": ["deliveryMode"]
          },
          "then": {
            "properties": { "workflowProfile": { "$ref": "#/$defs/boundedId" } }
          },
          "else": {
            "properties": { "workflowProfile": { "type": "null" } }
          }
        }
      ],
      "additionalProperties": false,
      "x-sflow-selfHash": "selectionSha256",
      "x-sflow-semanticFields": [
        "schemaVersion",
        "kind",
        "workId",
        "selectionStrategy",
        "deliveryMode",
        "workflowProfile",
        "executionProvider",
        "executionPace",
        "autonomyCeiling",
        "proofProfile",
        "proofPolicySha256",
        "policySnapshotSha256",
        "selectedBy",
        "selectionReason"
      ]
    },
    "predicateIdentity": {
      "type": "object",
      "required": ["id", "version", "implementationSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^pfc\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "implementationSha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "proofInput": {
      "type": "object",
      "required": ["kind", "sha256"],
      "properties": {
        "kind": { "$ref": "#/$defs/boundedId" },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "fuel": {
      "type": "object",
      "required": ["maximumSteps", "consumedSteps"],
      "properties": {
        "maximumSteps": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "consumedSteps": { "type": "integer", "minimum": 0, "maximum": 10000000 }
      },
      "additionalProperties": false
    },
    "proofPredicateResult": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "predicate",
        "proofSubjectSha256",
        "proofProfile",
        "inputs",
        "verdict",
        "reasonCode",
        "findings",
        "fuel",
        "resultSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "proof-predicate-result" },
        "predicate": { "$ref": "#/$defs/predicateIdentity" },
        "proofSubjectSha256": { "$ref": "#/$defs/digest" },
        "proofProfile": { "enum": ["standard", "high-assurance", "regulated", "custom-registered"] },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/proofInput" },
          "minItems": 1,
          "maxItems": 256
        },
        "verdict": { "enum": ["pass", "fail", "unavailable", "not-applicable"] },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" },
        "findings": {
          "type": "array",
          "items": { "type": "string", "maxLength": 512 },
          "maxItems": 256
        },
        "fuel": { "$ref": "#/$defs/fuel" },
        "resultSha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false,
      "x-sflow-selfHash": "resultSha256",
      "x-sflow-semanticFields": [
        "schemaVersion",
        "kind",
        "predicate",
        "proofSubjectSha256",
        "proofProfile",
        "inputs",
        "verdict",
        "reasonCode",
        "findings",
        "fuel"
      ]
    },
    "predicateResultSets": {
      "type": "object",
      "required": ["passed", "failed", "unavailable", "notApplicable"],
      "properties": {
        "passed": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 1024, "uniqueItems": true },
        "failed": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 1024, "uniqueItems": true },
        "unavailable": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 1024, "uniqueItems": true },
        "notApplicable": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 1024, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "proofSummary": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "proofSubjectSha256",
        "proofProfile",
        "predicateResults",
        "signals",
        "gapRegisterSha256",
        "gapDecisionRefs",
        "verdict",
        "summarySha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "proof-summary" },
        "proofSubjectSha256": { "$ref": "#/$defs/digest" },
        "proofProfile": { "enum": ["standard", "high-assurance", "regulated", "custom-registered"] },
        "predicateResults": { "$ref": "#/$defs/predicateResultSets" },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 1024, "uniqueItems": true },
        "gapRegisterSha256": { "$ref": "#/$defs/nullableDigest" },
        "gapDecisionRefs": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 256, "uniqueItems": true },
        "verdict": {
          "enum": [
            "proof-satisfied",
            "proof-satisfied-with-authorized-gaps",
            "proof-failed",
            "proof-unavailable",
            "proof-stale",
            "proof-decision-required"
          ]
        },
        "summarySha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false,
      "x-sflow-selfHash": "summarySha256",
      "x-sflow-semanticFields": [
        "schemaVersion",
        "kind",
        "proofSubjectSha256",
        "proofProfile",
        "predicateResults",
        "signals",
        "gapRegisterSha256",
        "gapDecisionRefs",
        "verdict"
      ]
    },
    "passportSubject": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["story", "outcome", "initiative"] },
        "id": { "$ref": "#/$defs/boundedId" }
      },
      "additionalProperties": false
    },
    "changePassport": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "passportId",
        "revision",
        "priorPassportSha256",
        "subject",
        "selectionSha256",
        "candidateSha256",
        "proofSubjectSha256",
        "proofSummarySha256",
        "decisionRefs",
        "publicationRefs",
        "status",
        "passportSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "change-passport" },
        "passportId": { "$ref": "#/$defs/boundedId" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "priorPassportSha256": { "$ref": "#/$defs/nullableDigest" },
        "subject": { "$ref": "#/$defs/passportSubject" },
        "selectionSha256": { "$ref": "#/$defs/digest" },
        "candidateSha256": { "$ref": "#/$defs/digest" },
        "proofSubjectSha256": { "$ref": "#/$defs/digest" },
        "proofSummarySha256": { "$ref": "#/$defs/nullableDigest" },
        "decisionRefs": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 256, "uniqueItems": true },
        "publicationRefs": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 256, "uniqueItems": true },
        "status": {
          "enum": [
            "draft",
            "contracted",
            "ready-to-execute",
            "executing",
            "candidate-ready",
            "evidence-required",
            "decision-required",
            "rejected",
            "admitted",
            "publication-pending",
            "published",
            "production-observation-required",
            "closed",
            "rolled-back",
            "cancelled",
            "recovery-required"
          ]
        },
        "passportSha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false,
      "x-sflow-selfHash": "passportSha256",
      "x-sflow-semanticFields": [
        "schemaVersion",
        "kind",
        "passportId",
        "revision",
        "priorPassportSha256",
        "subject",
        "selectionSha256",
        "candidateSha256",
        "proofSubjectSha256",
        "proofSummarySha256",
        "decisionRefs",
        "publicationRefs",
        "status"
      ]
    }
  }
}
