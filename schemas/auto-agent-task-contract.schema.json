{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/auto-agent-task-contract.schema.json",
  "title": "Singularity Flow Auto Agent Task Contract v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "mode", "taskContractId", "flightId", "attemptId", "phase", "objective", "acceptanceClauses", "readScope", "writeScope", "protectedScope", "forbiddenScope", "allowedTools", "requiredOutputs", "requiredEvidence", "budgets", "stopConditions", "createdAt", "contractSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "auto-agent-task-contract" }, "mode": { "const": "auto" },
    "taskContractId": { "type": "string", "pattern": "^ATC-[A-F0-9]{26}$" },
    "flightId": { "$ref": "#/$defs/flightId" }, "attemptId": { "$ref": "#/$defs/attemptId" },
    "phase": { "$ref": "#/$defs/nonempty" }, "objective": { "$ref": "#/$defs/nonempty" },
    "acceptanceClauses": { "$ref": "#/$defs/stringSet" }, "readScope": { "$ref": "#/$defs/nonemptyRelativeScopeSet" },
    "writeScope": { "$ref": "#/$defs/nonemptyRelativeScopeSet" }, "protectedScope": { "$ref": "#/$defs/relativeScopeSet" },
    "forbiddenScope": { "$ref": "#/$defs/nonemptyRelativeScopeSet" }, "allowedTools": { "$ref": "#/$defs/nonemptyStringSet" },
    "requiredOutputs": { "$ref": "#/$defs/nonemptyStringSet" }, "requiredEvidence": { "$ref": "#/$defs/stringSet" },
    "budgets": { "$ref": "#/$defs/budgets" }, "stopConditions": { "$ref": "#/$defs/nonemptyStringSet" },
    "createdAt": { "type": "string", "format": "date-time" }, "contractSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "flightId": { "type": "string", "pattern": "^AFL-[A-F0-9]{26}$" }, "attemptId": { "type": "string", "pattern": "^AAT-[A-F0-9]{26}$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "nonempty": { "type": "string", "minLength": 1 },
    "relativeScope": { "type": "string", "minLength": 1, "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "nonemptyStringSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "relativeScopeSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativeScope" } },
    "nonemptyRelativeScopeSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/relativeScope" } },
    "budgets": {
      "type": "object",
      "required": ["maximumTouchedPaths", "maximumTouchedChanges", "maximumModelInvocations", "maximumTotalTokens", "tokenAssurance"],
      "properties": {
        "maximumTouchedPaths": { "type": "integer", "minimum": 1 }, "maximumTouchedChanges": { "type": "integer", "minimum": 1 },
        "maximumModelInvocations": { "type": "integer", "minimum": 1 }, "maximumTotalTokens": { "type": "integer", "minimum": 1 },
        "tokenAssurance": { "enum": ["exact-required", "best-available"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
