{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-extractor-registry.schema.json",
  "title": "WMB v4 extractor registry",
  "type": "object",
  "required": ["schemaVersion", "kind", "manifests", "registrySha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-extractor-registry" },
    "manifests": { "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "world-model-extractor-manifest.schema.json" } },
    "registrySha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
