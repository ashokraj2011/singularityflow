{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/workflow-snapshot.schema.json",
  "title": "Immutable Story workflow snapshot",
  "type": "object",
  "required": ["schemaVersion", "kind", "story", "revision", "parentSnapshotHash", "policy", "assets", "executionDependencies", "provenance", "semantics", "configFoldHash", "createdAt", "limits", "snapshotHash"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "kind": { "const": "workflow-snapshot" },
    "story": {
      "type": "object",
      "required": ["repositoryId", "workId"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/sha256" },
        "workId": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "revision": { "type": "integer", "minimum": 1 },
    "parentSnapshotHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "policy": { "$ref": "#/$defs/blob" },
    "assets": { "type": "array", "maxItems": 8192, "items": { "$ref": "#/$defs/asset" } },
    "executionDependencies": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/executionDependency" } },
    "skillPackages": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/skillPackage" } },
    "provenance": { "type": "object" },
    "semantics": { "type": "object" },
    "configFoldHash": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "format": "date-time" },
    "limits": {
      "type": "object",
      "required": ["assets", "bytes"],
      "properties": {
        "assets": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 83886080 }
      },
      "additionalProperties": false
    },
    "snapshotHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } }, "required": ["schemaVersion"] },
      "then": {
        "properties": {
          "assets": { "maxItems": 2048 },
          "limits": {
            "properties": {
              "assets": { "maximum": 2048 },
              "bytes": { "maximum": 16777216 }
            }
          }
        },
        "not": { "required": ["skillPackages"] }
      },
      "else": { "required": ["skillPackages"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "skillPackage": {
      "type": "object",
      "required": ["skillId", "manifest", "phaseBindings", "files"],
      "properties": {
        "skillId": { "$ref": "#/$defs/kebabId" },
        "manifest": { "type": "object" },
        "phaseBindings": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["phaseId", "contractSha256", "compilationSha256", "parserProfile", "bindingRefsSha256"],
            "properties": {
              "phaseId": { "$ref": "#/$defs/kebabId" },
              "contractSha256": { "$ref": "#/$defs/sha256" },
              "compilationSha256": { "$ref": "#/$defs/sha256" },
              "parserProfile": { "const": "skp-skill-text/v1" },
              "bindingRefsSha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        },
        "files": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["path", "assetLogicalId"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "assetLogicalId": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "blob": {
      "type": "object",
      "required": ["sha256", "bytes", "mediaType", "path"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["logicalId", "purpose", "dependencies", "blob", "source"],
      "properties": {
        "logicalId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dependencies": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
        "blob": { "$ref": "#/$defs/blob" },
        "source": { "type": "object" }
      },
      "additionalProperties": false
    },
    "executionDependency": {
      "oneOf": [
        { "$ref": "#/$defs/currentExecutionDependency" },
        { "$ref": "#/$defs/legacyExecutionDependency" }
      ]
    },
    "currentExecutionDependency": {
      "type": "object",
      "required": ["id", "agentId", "dependencyId", "kind", "optional", "availability", "inclusion", "assetLogicalId", "referenceSha256", "contentSha256", "executable"],
      "properties": {
        "id": { "type": "string", "pattern": "^agent:[a-z0-9]+(?:-[a-z0-9]+)*:(?:skill|template|generated):[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 256 },
        "agentId": { "$ref": "#/$defs/kebabId" },
        "dependencyId": { "$ref": "#/$defs/kebabId" },
        "kind": { "$ref": "#/$defs/dependencyKind" },
        "optional": { "type": "boolean" },
        "availability": { "$ref": "#/$defs/dependencyAvailability" },
        "inclusion": { "enum": ["included", "omitted", "external-requirement"] },
        "assetLogicalId": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] },
        "referenceSha256": { "$ref": "#/$defs/sha256" },
        "contentSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "executable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "legacyExecutionDependency": {
      "type": "object",
      "required": ["id", "kind", "availability", "referenceSha256", "contentSha256", "executable"],
      "properties": {
        "id": { "type": "string", "pattern": "^agent:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 256 },
        "kind": { "$ref": "#/$defs/dependencyKind" },
        "availability": { "$ref": "#/$defs/dependencyAvailability" },
        "referenceSha256": { "$ref": "#/$defs/sha256" },
        "contentSha256": { "type": "null" },
        "executable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "dependencyKind": { "enum": ["skill", "template", "generated"] },
    "dependencyAvailability": { "enum": ["remote-optional", "remote-required"] },
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
