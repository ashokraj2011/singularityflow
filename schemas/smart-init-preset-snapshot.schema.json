{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/smart-init-preset-snapshot.schema.json",
  "title": "Pinned smart initialization preset",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "version", "policy", "presetSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "smart-init-preset-snapshot" },
    "id": { "const": "sflow.outcome-standard" },
    "version": { "type": "integer", "minimum": 1 },
    "policy": { "$ref": "smart-init-policy.schema.json" },
    "presetSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
