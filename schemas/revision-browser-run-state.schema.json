{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/revision-browser-run-state.schema.json",
  "title": "Singularity Flow immutable browser run state transition v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "runKeySha256", "state", "sequence", "previousStateSha256", "reasonCode", "at", "stateSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "revision-browser-run-state" },
    "runKeySha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" },
    "state": { "enum": ["planned", "running", "completed", "infrastructure-failed", "cancelled", "timed-out", "unavailable", "recovery-required"] },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 32 },
    "previousStateSha256": { "oneOf": [{ "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }, { "type": "null" }] },
    "reasonCode": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "at": { "$ref": "revision-contract-definitions.schema.json#/$defs/timestamp" },
    "stateSha256": { "$ref": "revision-contract-definitions.schema.json#/$defs/hash" }
  },
  "additionalProperties": false
}
