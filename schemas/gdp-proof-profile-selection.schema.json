{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/gdp-proof-profile-selection.schema.json",
  "title": "GDP Proof Profile Selection v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "workId", "proofProfile", "policyRefs", "status", "selectionSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "proof-profile-selection" },
    "workId": { "$ref": "#/$defs/id" },
    "proofProfile": { "$ref": "#/$defs/profile" },
    "policyRefs": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 256, "uniqueItems": true },
    "status": { "enum": ["shadow", "resolved"] },
    "selectionSha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "x-sflow-selfHash": "selectionSha256",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "profile": { "enum": ["standard", "high-assurance", "regulated", "custom-registered"] }
  }
}
