{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/auto-flight-state.schema.json",
  "title": "Singularity Flow local Auto flight state v2",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "mode", "flightId", "planId", "planSha256",
    "capabilityId", "status", "story", "worktree", "scopePrediction",
    "configuration", "repositories", "operations", "evidence", "candidate",
    "worldModelReference", "comprehensionReference",
    "phaseContracts", "boundaryCheckpoints", "boundaryCheckpoint",
    "lastSuccessfulStoryRevision", "position", "execution", "counters",
    "stopRequested", "checkpointSequence", "checkpointSha256", "stopReason",
    "nextAction", "createdAt", "updatedAt", "recordSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "auto-flight-state" },
    "mode": { "const": "auto" },
    "flightId": { "$ref": "#/$defs/flightId" },
    "planId": { "$ref": "#/$defs/planId" },
    "planSha256": { "$ref": "#/$defs/hash" },
    "capabilityId": { "type": ["string", "null"] },
    "status": { "enum": ["running", "paused", "waiting-human", "manual-takeover", "recovery-required", "halted", "completed", "discarded"] },
    "story": {
      "type": "object",
      "required": ["workId", "branch", "phase"],
      "properties": {
        "workId": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "worktree": { "type": "string", "minLength": 1 },
    "scopePrediction": { "type": "array", "items": { "type": "string" } },
    "configuration": { "type": ["object", "null"] },
    "repositories": { "type": "array", "items": { "type": "object" } },
    "operations": { "type": "array", "items": { "type": "object" } },
    "evidence": { "type": "object" },
    "candidate": { "$ref": "#/$defs/nullableCandidate" },
    "worldModelReference": { "type": ["object", "null"] },
    "comprehensionReference": { "type": ["object", "null"] },
    "phaseContracts": { "type": "object" },
    "boundaryCheckpoints": { "type": "array", "items": { "$ref": "#/$defs/boundaryPointer" } },
    "boundaryCheckpoint": { "oneOf": [{ "$ref": "#/$defs/boundaryPointer" }, { "type": "null" }] },
    "lastSuccessfulStoryRevision": { "type": ["string", "null"] },
    "position": { "type": "string", "minLength": 1 },
    "execution": { "type": "object" },
    "counters": { "type": "object" },
    "stopRequested": { "type": ["object", "null"] },
    "checkpointSequence": { "type": "integer", "minimum": 1 },
    "checkpointSha256": { "$ref": "#/$defs/hash" },
    "stopReason": { "type": "string" },
    "nextAction": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lastInvocationId": { "type": ["string", "null"] },
    "token": { "type": "object" },
    "observedPaths": { "type": "array", "items": { "type": "string" } },
    "touchedPaths": { "type": "array", "items": { "type": "string" } },
    "ceiling": { "type": "object" },
    "commits": { "type": "object" },
    "quality": { "type": "array", "items": { "type": "object" } },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "lastError": { "type": ["object", "null"] },
    "finalReportSha256": { "$ref": "#/$defs/hash" },
    "activePhaseRunId": { "type": ["string", "null"], "pattern": "^APR-[A-F0-9]{26}$" },
    "activeAttemptId": { "type": ["string", "null"], "pattern": "^AAT-[A-F0-9]{26}$" },
    "activeRefusalId": { "type": ["string", "null"], "pattern": "^ARF-[A-F0-9]{26}$" },
    "activeRepairPlanId": { "type": ["string", "null"], "pattern": "^ARP-[A-F0-9]{26}$" },
    "activeRepair": { "type": ["object", "null"] },
    "phaseRunIds": { "type": "array", "items": { "type": "string", "pattern": "^APR-[A-F0-9]{26}$" } },
    "attemptIds": { "type": "array", "items": { "type": "string", "pattern": "^AAT-[A-F0-9]{26}$" } },
    "refusalIds": { "type": "array", "items": { "type": "string", "pattern": "^ARF-[A-F0-9]{26}$" } },
    "repairAttempts": { "type": "array", "items": { "type": "object" } },
    "failureComparison": { "type": ["object", "null"] },
    "openHumanRequestIds": { "type": "array", "items": { "type": "string", "pattern": "^AHR-[A-F0-9]{26}$" } },
    "humanRequestDecisions": { "type": "array", "items": { "type": "object" } },
    "executionUnit": { "type": ["object", "null"] },
    "executionUnitSwitches": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "flightId": { "type": "string", "pattern": "^AFL-[A-F0-9]{26}$" },
    "planId": { "type": "string", "pattern": "^APL-[A-F0-9]{26}$" },
    "candidate": {
      "type": "object",
      "required": ["candidateId", "candidateSha256", "bindingSha256", "attemptId", "applicationChangeSetDigest", "applicationResourceDigest"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^CAN-[A-F0-9]{26}$" },
        "candidateSha256": { "$ref": "#/$defs/hash" },
        "bindingSha256": { "$ref": "#/$defs/hash" },
        "attemptId": { "type": "string", "pattern": "^AAT-[A-F0-9]{26}$" },
        "applicationChangeSetDigest": { "$ref": "#/$defs/hash" },
        "applicationResourceDigest": { "$ref": "#/$defs/hash" },
        "verificationReceiptSha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "nullableCandidate": { "oneOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
    "boundaryPointer": {
      "type": "object",
      "required": ["checkpointClass", "path", "checkpointSha256", "commit", "eventId", "phase", "position", "createdAt"],
      "properties": {
        "checkpointClass": { "enum": ["phase-boundary", "human-boundary", "publication-boundary", "recovery", "completion"] },
        "path": { "type": "string", "minLength": 1 },
        "checkpointSha256": { "$ref": "#/$defs/hash" },
        "commit": { "type": "string", "minLength": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "position": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
