{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/sgos-contract.schema.json",
  "title": "SingularityFlow SGOS durable contracts v1",
  "oneOf": [
    { "$ref": "#/$defs/intentEnvelope" },
    { "$ref": "#/$defs/intentIr" },
    { "$ref": "#/$defs/workflowIr" },
    { "$ref": "#/$defs/workflowRatification" },
    { "$ref": "#/$defs/policySnapshot" },
    { "$ref": "#/$defs/candidateSnapshot" },
    { "$ref": "#/$defs/processBinding" },
    { "$ref": "#/$defs/gvmProgram" },
    { "$ref": "#/$defs/gvmProcess" },
    { "$ref": "#/$defs/gvmTaskAttempt" },
    { "$ref": "#/$defs/gvmTaskReceipt" },
    { "$ref": "#/$defs/gvmCheckpoint" },
    { "$ref": "#/$defs/humanRequest" },
    { "$ref": "#/$defs/humanResponse" },
    { "$ref": "#/$defs/actionEvidence" },
    { "$ref": "#/$defs/workObject" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "principal": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "service", "agent", "system", "external"] },
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "authoritySha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["passed", "failed", "unavailable"] },
        "checksSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "intentEnvelope": {
      "type": "object",
      "required": ["schemaVersion", "kind", "intentId", "generation", "principal", "source", "rawRef", "rawSha256", "attachments", "capturedAt", "envelopeSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "intent-envelope" },
        "intentId": { "type": "string", "pattern": "^INT-" },
        "generation": { "type": "integer", "minimum": 1 },
        "principal": { "$ref": "#/$defs/principal" },
        "source": {
          "type": "object",
          "required": ["kind", "revision"],
          "properties": {
            "kind": { "enum": ["natural-language", "structured-api", "jira-issue", "document", "goal", "incident-event", "policy-change", "existing-adhoc-work", "scheduled-trigger", "external-system-signal"] },
            "revision": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "rawRef": { "type": "string", "minLength": 1 },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "attachments": { "type": "array", "items": { "type": "object" } },
        "capturedAt": { "$ref": "#/$defs/timestamp" },
        "envelopeSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "intentIr": {
      "type": "object",
      "required": ["schemaVersion", "kind", "intentId", "generation", "objective", "outcomes", "successCriteria", "constraints", "invariants", "preferences", "nonGoals", "assumptions", "unknowns", "contradictions", "risks", "subjects", "evidenceExpectations", "authorityRequirements", "budgets", "domainCandidates", "workTypeCandidates", "intentIrSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "intent-ir" },
        "intentId": { "type": "string", "pattern": "^INT-" },
        "generation": { "type": "integer", "minimum": 1 },
        "objective": { "type": "object" },
        "outcomes": { "type": "array" },
        "successCriteria": { "type": "array" },
        "constraints": { "type": "array" },
        "invariants": { "type": "array" },
        "preferences": { "type": "array" },
        "nonGoals": { "type": "array" },
        "assumptions": { "type": "array" },
        "unknowns": { "type": "array" },
        "contradictions": { "type": "array" },
        "risks": { "type": "array" },
        "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
        "evidenceExpectations": { "type": "array" },
        "authorityRequirements": { "type": "array" },
        "budgets": { "type": "array" },
        "domainCandidates": { "type": "array" },
        "workTypeCandidates": { "type": "array" },
        "intentIrSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "workflowIr": {
      "type": "object",
      "required": ["schemaVersion", "kind", "apiVersion", "workflowId", "version", "intentIrSha256", "policySnapshotSha256", "metadata", "spec", "workflowSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "workflow-ir" },
        "apiVersion": { "const": "sflow/v1" },
        "workflowId": { "type": "string", "pattern": "^WFL-" },
        "version": { "type": "string", "minLength": 1 },
        "intentIrSha256": { "$ref": "#/$defs/sha256" },
        "policySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "metadata": { "type": "object" },
        "spec": { "type": "object" },
        "workflowSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "workflowRatification": {
      "type": "object",
      "required": ["schemaVersion", "kind", "ratificationId", "intentIrSha256", "workflowSha256", "policySnapshotSha256", "registrySnapshotSha256", "storageProfileSha256", "packetSha256", "decision", "principal", "decidedAt", "ratificationSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "workflow-ratification" },
        "ratificationId": { "type": "string", "pattern": "^RAT-" },
        "intentIrSha256": { "$ref": "#/$defs/sha256" },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "policySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "registrySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "storageProfileSha256": { "$ref": "#/$defs/sha256" },
        "packetSha256": { "$ref": "#/$defs/sha256" },
        "decision": { "enum": ["ratified", "approved", "rejected", "changes-requested"] },
        "principal": { "$ref": "#/$defs/principal" },
        "intentWorkflowMap": { "type": "object" },
        "coverage": { "type": "object" },
        "decidedAt": { "$ref": "#/$defs/timestamp" },
        "ratificationSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "policySnapshot": {
      "type": "object",
      "required": ["schemaVersion", "kind", "policyId", "authorityRevision", "lawSha256", "registrySha256", "executionUnitPolicySha256", "devicePolicySha256", "storagePolicySha256", "memoryPolicySha256", "humanAuthoritySha256", "governedRootsSha256", "verificationPolicySha256", "publicationPolicySha256", "snapshotSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "policy-snapshot" },
        "policyId": { "type": "string", "pattern": "^POL-" },
        "authorityRevision": { "type": "string", "minLength": 1 },
        "lawSha256": { "$ref": "#/$defs/sha256" },
        "registrySha256": { "$ref": "#/$defs/sha256" },
        "executionUnitPolicySha256": { "$ref": "#/$defs/sha256" },
        "devicePolicySha256": { "$ref": "#/$defs/sha256" },
        "storagePolicySha256": { "$ref": "#/$defs/sha256" },
        "memoryPolicySha256": { "$ref": "#/$defs/sha256" },
        "humanAuthoritySha256": { "$ref": "#/$defs/sha256" },
        "governedRootsSha256": { "$ref": "#/$defs/sha256" },
        "verificationPolicySha256": { "$ref": "#/$defs/sha256" },
        "publicationPolicySha256": { "$ref": "#/$defs/sha256" },
        "snapshotSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "candidateResource": {
      "type": "object",
      "required": ["path", "type", "mode", "contentSha256", "operation", "renameFrom", "renameTo", "deletion"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "enum": ["file", "symlink", "directory"] },
        "mode": { "enum": ["100644", "100755", "120000", "040000", null] },
        "contentSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "operation": { "enum": ["added", "modified", "deleted", "renamed", "copied", "type-changed"] },
        "renameFrom": { "type": ["string", "null"] },
        "renameTo": { "type": ["string", "null"] },
        "deletion": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "candidateSnapshot": {
      "type": "object",
      "required": ["schemaVersion", "kind", "candidateId", "subject", "baseline", "candidate", "resources", "createdBy", "createdAt", "candidateSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "candidate-snapshot" },
        "candidateId": { "type": "string", "pattern": "^CAN-" },
        "subject": { "$ref": "#/$defs/subject" },
        "baseline": {
          "type": "object",
          "required": ["revision", "snapshotSha256"],
          "properties": { "revision": { "type": "string" }, "snapshotSha256": { "$ref": "#/$defs/sha256" } },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": ["snapshotSha256", "manifestSha256"],
          "properties": { "snapshotSha256": { "$ref": "#/$defs/sha256" }, "manifestSha256": { "$ref": "#/$defs/sha256" } },
          "additionalProperties": false
        },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/candidateResource" } },
        "createdBy": { "$ref": "#/$defs/principal" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "candidateSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "processBinding": {
      "type": "object",
      "required": ["schemaVersion", "kind", "processId", "subjectId", "repositoryIdentity", "gitCommonDirectory", "worktreeGitDirectory", "canonicalWorktreeRoot", "branch", "baselineRevision", "expectedProcessRevision", "bindingSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "process-binding" },
        "processId": { "type": "string", "pattern": "^PROC-" }, "subjectId": { "type": "string" },
        "repositoryIdentity": { "type": "string" }, "gitCommonDirectory": { "type": "string" },
        "worktreeGitDirectory": { "type": "string" }, "canonicalWorktreeRoot": { "type": "string" },
        "branch": { "type": "string" }, "baselineRevision": { "type": "string" },
        "expectedProcessRevision": { "type": "integer", "minimum": 0 }, "bindingSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "gvmProgram": {
      "type": "object",
      "required": ["schemaVersion", "kind", "programId", "intentIrSha256", "workflowSha256", "ratificationSha256", "policySnapshotSha256", "registrySnapshotSha256", "storageProfileSha256", "taskTemplates", "edges", "joins", "budgets", "recoveryPolicy", "terminalConditions", "compiler", "programSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "gvm-program" },
        "programId": { "type": "string", "pattern": "^PRG-" },
        "intentIrSha256": { "$ref": "#/$defs/sha256" }, "workflowSha256": { "$ref": "#/$defs/sha256" },
        "ratificationSha256": { "$ref": "#/$defs/sha256" }, "policySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "registrySnapshotSha256": { "$ref": "#/$defs/sha256" }, "storageProfileSha256": { "$ref": "#/$defs/sha256" },
        "taskTemplates": { "type": "array" }, "edges": { "type": "array" },
        "joins": { "type": ["array", "object"] }, "budgets": { "type": "object" },
        "recoveryPolicy": { "type": "object" }, "terminalConditions": { "type": "array" },
        "compiler": { "type": "object" }, "programSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "gvmProcess": {
      "type": "object",
      "required": ["schemaVersion", "kind", "processId", "programSha256", "policySnapshotSha256", "processBindingSha256", "status", "taskInstances", "activeExecutions", "openHumanRequests", "activeLeases", "currentCheckpointSha256", "processRevision", "processSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "gvm-process" },
        "processId": { "type": "string", "pattern": "^PROC-" }, "programSha256": { "$ref": "#/$defs/sha256" },
        "policySnapshotSha256": { "$ref": "#/$defs/sha256" }, "processBindingSha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["queued", "running", "waiting-human", "blocked", "paused", "succeeded", "failed", "cancelled", "recovery-required"] },
        "taskInstances": { "type": "object" }, "activeExecutions": { "type": "array" },
        "openHumanRequests": { "type": "array", "items": { "$ref": "#/$defs/sha256" } }, "activeLeases": { "type": "array" },
        "currentCheckpointSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "processRevision": { "type": "integer", "minimum": 0 }, "authorityBinding": { "type": "object" },
        "taskContractSha256": { "$ref": "#/$defs/sha256" }, "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }, "processSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "gvmTaskAttempt": {
      "type": "object",
      "required": ["schemaVersion", "kind", "attemptId", "processId", "taskInstanceId", "attemptNumber", "parentAttemptId", "reason", "taskContractSha256", "executionHandleSha256", "status", "attemptSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "gvm-task-attempt" },
        "attemptId": { "type": "string", "pattern": "^ATT-" }, "processId": { "type": "string", "pattern": "^PROC-" },
        "taskInstanceId": { "type": "string" }, "attemptNumber": { "type": "integer", "minimum": 1 },
        "parentAttemptId": { "type": ["string", "null"] },
        "reason": { "enum": ["initial", "retry", "verification-failed", "execution-failed", "timeout", "lease-lost", "recovery", "invalidated", "manual"] },
        "taskContractSha256": { "$ref": "#/$defs/sha256" }, "executionHandleSha256": { "$ref": "#/$defs/sha256" },
        "status": { "type": "string" }, "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" }, "attemptSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "gvmTaskReceipt": {
      "type": "object",
      "required": ["schemaVersion", "kind", "processId", "taskInstanceId", "attemptId", "inputRefs", "outputRefs", "candidateSha256", "evidenceRefs", "effectRefs", "humanDecisionRefs", "verification", "completedAt", "receiptSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "gvm-task-receipt" },
        "processId": { "type": "string", "pattern": "^PROC-" }, "taskInstanceId": { "type": "string" },
        "attemptId": { "type": "string", "pattern": "^ATT-" }, "inputRefs": { "type": "array" },
        "outputRefs": { "type": "array" }, "candidateSha256": { "$ref": "#/$defs/sha256" },
        "evidenceRefs": { "type": "array" }, "effectRefs": { "type": "array" }, "humanDecisionRefs": { "type": "array" },
        "verification": { "$ref": "#/$defs/verification" }, "completedAt": { "$ref": "#/$defs/timestamp" },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "gvmCheckpoint": {
      "type": "object",
      "required": ["schemaVersion", "kind", "checkpointId", "processId", "processRevision", "programSha256", "policySnapshotSha256", "processBindingSha256", "taskStates", "readyTaskIds", "activeExecutions", "openHumanRequests", "activeLeases", "priorCheckpointSha256", "createdAt", "checkpointSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "gvm-checkpoint" },
        "checkpointId": { "type": "string", "pattern": "^CHK-" }, "processId": { "type": "string", "pattern": "^PROC-" },
        "processRevision": { "type": "integer", "minimum": 0 }, "programSha256": { "$ref": "#/$defs/sha256" },
        "policySnapshotSha256": { "$ref": "#/$defs/sha256" }, "processBindingSha256": { "$ref": "#/$defs/sha256" },
        "taskStates": { "type": "object" }, "readyTaskIds": { "type": "array" }, "activeExecutions": { "type": "array" },
        "openHumanRequests": { "type": "array", "items": { "$ref": "#/$defs/sha256" } }, "activeLeases": { "type": "array" },
        "priorCheckpointSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "createdAt": { "$ref": "#/$defs/timestamp" }, "checkpointSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "humanRequest": {
      "type": "object",
      "required": ["schemaVersion", "kind", "requestId", "requestType", "processId", "taskInstanceId", "checkpointSha256", "requestedBy", "authorityRequired", "prompt", "options", "inputSchema", "sensitiveMode", "externalUrl", "secretBroker", "subjectSha256", "policySnapshotSha256", "status", "createdAt", "expiresAt", "requestSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "human-request" },
        "requestId": { "type": "string", "pattern": "^HRQ-" },
        "requestType": { "enum": ["clarification", "approval", "credential", "exception", "policy-choice", "conflict-resolution", "interpretation", "evidence-review", "scope-expansion", "production-authority", "scientific-judgment", "legal-judgment"] },
        "processId": { "type": "string", "pattern": "^PROC-" }, "taskInstanceId": { "type": "string" },
        "checkpointSha256": { "$ref": "#/$defs/sha256" }, "requestedBy": { "$ref": "#/$defs/principal" },
        "authorityRequired": { "type": "object" }, "prompt": { "type": "object" }, "options": { "type": "array" },
        "inputSchema": { "type": ["object", "null"] }, "sensitiveMode": { "enum": ["none", "external-url", "secret-broker"] },
        "externalUrl": { "type": ["string", "null"] }, "secretBroker": { "type": ["string", "null"] },
        "subjectSha256": { "$ref": "#/$defs/sha256" }, "policySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["open", "answered", "expired", "cancelled"] }, "createdAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "requestSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "humanResponse": {
      "type": "object",
      "required": ["schemaVersion", "kind", "responseId", "requestSha256", "processId", "taskInstanceId", "actor", "decision", "input", "respondedAt", "responseSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "human-response" },
        "responseId": { "type": "string", "pattern": "^HRS-" }, "requestSha256": { "$ref": "#/$defs/sha256" },
        "processId": { "type": "string", "pattern": "^PROC-" }, "taskInstanceId": { "type": "string" },
        "actor": { "$ref": "#/$defs/principal" }, "decision": { "enum": ["approved", "rejected", "selected", "provided", "cancelled"] },
        "input": {}, "respondedAt": { "$ref": "#/$defs/timestamp" }, "responseSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "actionEvidence": {
      "type": "object",
      "required": ["schemaVersion", "kind", "principalSha256", "delegationSha256", "programSha256", "taskContractSha256", "executionUnitManifestSha256", "deviceManifestSha256", "argumentsSha256", "preStateSha256", "rawResultSha256", "postStateSha256", "verification", "cost", "latencyMs", "gaps", "evidenceSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "action-evidence" },
        "processId": { "type": "string", "pattern": "^PROC-" }, "taskInstanceId": { "type": "string" }, "attemptId": { "type": "string", "pattern": "^ATT-" },
        "principalSha256": { "$ref": "#/$defs/sha256" }, "delegationSha256": { "$ref": "#/$defs/sha256" },
        "programSha256": { "$ref": "#/$defs/sha256" }, "taskContractSha256": { "$ref": "#/$defs/sha256" },
        "executionUnitManifestSha256": { "$ref": "#/$defs/sha256" }, "deviceManifestSha256": { "$ref": "#/$defs/sha256" },
        "argumentsSha256": { "$ref": "#/$defs/sha256" }, "preStateSha256": { "$ref": "#/$defs/sha256" },
        "rawResultSha256": { "$ref": "#/$defs/sha256" }, "postStateSha256": { "$ref": "#/$defs/sha256" },
        "verification": { "$ref": "#/$defs/verification" }, "cost": { "type": "object" }, "latencyMs": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "array" }, "evidenceRefs": { "type": "array" }, "effectRefs": { "type": "array" },
        "humanDecisionRefs": { "type": "array" }, "contradictions": { "type": "array" },
        "createdAt": { "$ref": "#/$defs/timestamp" }, "evidenceSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "workObject": {
      "type": "object",
      "required": ["schemaVersion", "kind", "objectId", "processId", "taskInstanceId", "view", "objectSha256"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "work-object" },
        "objectId": { "type": "string", "pattern": "^WKO-" }, "processId": { "type": "string", "pattern": "^PROC-" },
        "taskInstanceId": { "type": ["string", "null"] },
        "view": {
          "type": "object",
          "required": ["type", "schema", "dataRef", "actions"],
          "properties": {
            "type": { "enum": ["form", "table", "timeline", "graph", "comparison", "dashboard", "evidence-matrix", "decision-card", "map", "code-source-diff", "experiment-result"] },
            "schema": { "type": "object" }, "dataRef": { "type": "string" }, "actions": { "type": "array" }
          },
          "additionalProperties": false
        },
        "createdAt": { "$ref": "#/$defs/timestamp" }, "objectSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
