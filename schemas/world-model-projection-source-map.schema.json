{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/world-model-projection-source-map.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "projectionId", "projectionVersion", "projectionSha256", "elements", "sourceMapSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-projection-source-map" },
    "projectionId": { "const": "arch.calm" }, "projectionVersion": { "const": 1 },
    "projectionSha256": { "$ref": "#/$defs/hash" }, "elements": { "type": "array" },
    "sourceMapSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
