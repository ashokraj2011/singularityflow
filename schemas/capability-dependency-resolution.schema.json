{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/capability-dependency-resolution.schema.json",
  "title": "Capability Dependency Resolution v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "sourceCapability", "targetCapability", "requestedReference", "contract", "resolutionSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "capability-dependency-resolution" },
    "sourceCapability": { "type": "string" },
    "targetCapability": { "type": "string" },
    "requestedReference": { "type": "string" },
    "contract": {
      "type": "object",
      "required": ["id", "version", "sha256", "publicationSha256", "publisherAuthority"],
      "properties": {
        "id": { "type": "string" }, "version": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hash" }, "publicationSha256": { "$ref": "#/$defs/hash" },
        "publisherAuthority": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resolutionSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
  "additionalProperties": false
}
