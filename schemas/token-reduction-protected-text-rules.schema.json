{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/token-reduction-protected-text-rules.schema.json",
  "title": "TKR v1 protected-text rules",
  "type": "object",
  "required": ["schemaVersion", "kind", "owner", "contractId", "version", "sourceModes", "normalizationScope", "continuityProofRequired", "verifyAfterComposition", "contractSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "tkr/protected-text-rules" },
    "owner": { "$ref": "#/$defs/id" },
    "contractId": { "$ref": "#/$defs/id" },
    "version": { "const": 1 },
    "sourceModes": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "prefixItems": [{ "const": "verbatim" }, { "const": "lossless-encoded" }],
      "items": false
    },
    "normalizationScope": { "const": "generated-framing-only" },
    "continuityProofRequired": { "const": true },
    "verifyAfterComposition": { "const": true },
    "contractSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
