{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/ast-gate-receipt.schema.json",
  "title": "Singularity Flow AST lifecycle gate receipt",
  "type": "object",
  "required": ["schemaVersion", "workId", "phase", "generation", "policySha256", "repositoryRevision", "coneSha256", "scope", "assurance", "status", "engine", "extractors", "predicates", "diagnostics", "allowed", "evaluatedAt", "integritySha256"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "workId": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repositoryRevision": { "type": ["string", "null"] },
    "coneSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "type": "object", "required": ["kind", "paths", "evaluatedPaths"], "properties": { "kind": { "enum": ["changed", "cone", "paths", "all"] }, "paths": { "type": "array", "items": { "type": "string" } }, "evaluatedPaths": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "assurance": { "enum": ["text", "syntax", "semantic"] },
    "status": { "enum": ["complete", "partial", "disabled", "unsupported", "stale", "failed"] },
    "engine": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "extractors": { "type": "array", "items": { "$ref": "#/$defs/extractor" } },
    "predicates": { "type": "array", "items": { "type": "object", "required": ["id", "mode", "requiredAssurance", "outcome", "extractors"], "properties": { "id": { "type": "string" }, "mode": { "enum": ["required", "advisory"] }, "requiredAssurance": { "enum": ["text", "syntax", "semantic"] }, "outcome": { "enum": ["pass", "fail", "unknown"] }, "extractors": { "type": "array", "items": { "$ref": "#/$defs/extractor" } } }, "additionalProperties": false } },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "adapter": { "type": "string" }, "source": { "type": "string" } }, "additionalProperties": false } },
    "allowed": { "const": true },
    "evaluatedAt": { "type": "string" },
    "integritySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "extractor": {
      "type": "object",
      "required": ["id", "version", "assurance"],
      "properties": { "id": { "type": "string" }, "version": { "type": ["string", "integer"] }, "assurance": { "enum": ["text", "syntax", "semantic"] } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
