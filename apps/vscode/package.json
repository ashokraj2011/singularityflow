{
  "name": "singularity-flow-vscode",
  "displayName": "Singularity Flow",
  "version": "0.9.0",
  "private": true,
  "description": "Run the Product Development Lifecycle from the editor: initiatives, stage gates, artifact packs, Stories, and reconciliation.",
  "author": "Singularity Flow",
  "license": "MIT",
  "type": "module",
  "publisher": "singularityflow",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:singularityFlow.navigation",
    "onView:singularityFlow.lifecycle",
    "onView:singularityFlow.inbox",
    "onView:singularityFlow.configuration",
    "onView:singularityFlow.help",
    "onView:singularityFlow.workspaces",
    "workspaceContains:singularity/workflow.yml",
    "workspaceContains:workspace.json"
  ],
  "contributes": {
    "configuration": {
      "title": "Singularity Flow",
      "properties": {
        "singularityFlow.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the singularity-flow CLI entry point. Leave empty to use the bundled CLI, then the one on PATH."
        },
        "singularityFlow.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node executable used to run the CLI. Leave empty to use the Node running the extension host."
        },
        "singularityFlow.modelMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "disabled"
          ],
          "enumDescriptions": [
            "Allow operations whose declared policy permits or requires a model.",
            "Disable all kernel-owned model invocation; model-required operations fail before their handler loads."
          ],
          "description": "Controls kernel-owned model invocation for every Singularity Flow command launched by this VS Code window."
        },
        "singularityFlow.userName": {
          "type": "string",
          "default": "",
          "description": "Display name used for local guidance. Governed decisions continue to use Git and provider identities."
        },
        "singularityFlow.role": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "product-owner",
            "business-analyst",
            "product-designer",
            "architect",
            "developer",
            "qa",
            "security",
            "delivery-manager",
            "operations",
            "other"
          ],
          "description": "Local role used to simplify guidance. The active governed agent is selected by the workflow phase."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "singularityFlow.gettingStarted",
        "title": "Get started with Singularity Flow",
        "description": "Configure your profile, secure integrations, and first governed workspace.",
        "steps": [
          {
            "id": "profile",
            "title": "Set your name and role",
            "description": "Choose the local guidance appropriate for your work.",
            "media": {
              "markdown": "media/walkthrough/profile.md"
            },
            "completionEvents": [
              "onCommand:singularityFlow.configureProfile"
            ]
          },
          {
            "id": "jira",
            "title": "Connect Jira securely",
            "description": "Store the token in the operating-system keychain through VS Code SecretStorage.",
            "media": {
              "markdown": "media/walkthrough/jira.md"
            },
            "completionEvents": [
              "onCommand:singularityFlow.connectJira"
            ]
          },
          {
            "id": "workspace",
            "title": "Choose or create a workspace",
            "description": "Workspaces bind a local directory to capabilities and repositories.",
            "media": {
              "markdown": "media/walkthrough/workspace.md"
            },
            "completionEvents": [
              "onCommand:singularityFlow.switchWorkspace",
              "onCommand:singularityFlow.createWorkspace"
            ]
          },
          {
            "id": "intake",
            "title": "Start intake",
            "description": "Choose the work shape and workflow, then hand governed context to native Copilot.",
            "media": {
              "markdown": "media/walkthrough/intake.md"
            },
            "completionEvents": [
              "onCommand:singularityFlow.startWork"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "singularityFlowNavigator",
          "title": "SINGULARITY FLOW",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "singularityFlowNavigator": [
        {
          "id": "singularityFlow.navigation",
          "name": "Singularity Flow",
          "type": "webview"
        },
        {
          "id": "singularityFlow.workspaces",
          "name": "Workspaces",
          "when": "singularityFlow.legacyNavigation"
        },
        {
          "id": "singularityFlow.lifecycle",
          "name": "Lifecycle",
          "when": "singularityFlow.legacyNavigation"
        },
        {
          "id": "singularityFlow.inbox",
          "name": "Inbox",
          "when": "singularityFlow.legacyNavigation"
        },
        {
          "id": "singularityFlow.configuration",
          "name": "Configuration",
          "when": "singularityFlow.legacyNavigation"
        },
        {
          "id": "singularityFlow.help",
          "name": "Help",
          "when": "singularityFlow.legacyNavigation"
        }
      ]
    },
    "commands": [
      {
        "command": "singularityFlow.openWorkspaces",
        "title": "Singularity Flow: Workspaces",
        "icon": "$(list-unordered)"
      },
      {
        "command": "singularityFlow.openWalkthrough",
        "title": "Singularity Flow: Get Started (Walkthrough)",
        "icon": "$(rocket)"
      },
      {
        "command": "singularityFlow.configureModelMode",
        "title": "Singularity Flow: Configure Model Mode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "singularityFlow.mapCapability",
        "title": "Singularity Flow: Map a Capability",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "singularityFlow.reviewCapabilityProposals",
        "title": "Singularity Flow: Review Capability Proposals",
        "icon": "$(git-merge)"
      },
      {
        "command": "singularityFlow.createWorkspace",
        "title": "Singularity Flow: Create a Workspace",
        "icon": "$(root-folder)"
      },
      {
        "command": "singularityFlow.repairWorkspace",
        "title": "Singularity Flow: Repair Selected Workspace",
        "icon": "$(tools)"
      },
      {
        "command": "singularityFlow.init",
        "title": "Singularity Flow: Initialize This Repository",
        "icon": "$(add)"
      },
      {
        "command": "singularityFlow.startWork",
        "title": "Singularity Flow: Start Work",
        "icon": "$(add)"
      },
      {
        "command": "singularityFlow.continueSafely",
        "title": "Singularity Flow: Continue Safely",
        "icon": "$(play-circle)"
      },
      {
        "command": "singularityFlow.openCopilot",
        "title": "Singularity Flow: Continue Active Story in Copilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "singularityFlow.attachSessionToWorkspace",
        "title": "Singularity Flow: Attach Copilot Session to Workspace",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "singularityFlow.configureProfile",
        "title": "Singularity Flow: Configure User Profile",
        "icon": "$(account)"
      },
      {
        "command": "singularityFlow.connectJira",
        "title": "Singularity Flow: Connect Jira Securely",
        "icon": "$(key)"
      },
      {
        "command": "singularityFlow.resetJira",
        "title": "Singularity Flow: Reset Saved Jira",
        "icon": "$(trash)"
      },
      {
        "command": "singularityFlow.configureTeams",
        "title": "Singularity Flow: Configure Teams Notifications",
        "icon": "$(bell)"
      },
      {
        "command": "singularityFlow.resetTeams",
        "title": "Singularity Flow: Reset Teams Notifications",
        "icon": "$(trash)"
      },
      {
        "command": "singularityFlow.openDashboard",
        "title": "Singularity Flow: Lifecycle Analytics",
        "icon": "$(pulse)"
      },
      {
        "command": "singularityFlow.openVisualAssurance",
        "title": "Singularity Flow: Visual Assurance",
        "icon": "$(preview)"
      },
      {
        "command": "singularityFlow.openConfigurationCenter",
        "title": "Singularity Flow: Configuration Center",
        "icon": "$(settings-gear)"
      },
      {
        "command": "singularityFlow.configurePeople",
        "title": "Singularity Flow: People & Approval Authorities",
        "icon": "$(organization)"
      },
      {
        "command": "singularityFlow.openDesigner",
        "title": "Singularity Flow: Workflow Designer",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "singularityFlow.openInstructionDesigner",
        "title": "Singularity Flow: Agent, Prompt & Skill Designer",
        "icon": "$(hubot)"
      },
      {
        "command": "singularityFlow.publishConfiguration",
        "title": "Singularity Flow: Review & Publish Configuration",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "singularityFlow.openPromptAudit",
        "title": "Singularity Flow: Prompt Audit",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "singularityFlow.openSpecificationTrace",
        "title": "Singularity Flow: Specification Traceability",
        "icon": "$(references)"
      },
      {
        "command": "singularityFlow.expandReference",
        "title": "Singularity Flow: Expand Governed Reference",
        "icon": "$(preview)"
      },
      {
        "command": "singularityFlow.openHarnessReport",
        "title": "Singularity Flow: Open Harness Imports Report",
        "icon": "$(graph)"
      },
      {
        "command": "singularityFlow.inspectCompositionCache",
        "title": "Singularity Flow: Inspect Composition Cache",
        "icon": "$(database)"
      },
      {
        "command": "singularityFlow.checkLedgerDeployment",
        "title": "Singularity Flow: Check Ledger Deployment",
        "icon": "$(shield)"
      },
      {
        "command": "singularityFlow.configureMcp",
        "title": "Singularity Flow: Configure MCP Tools",
        "icon": "$(plug)"
      },
      {
        "command": "singularityFlow.openCapabilities",
        "title": "Singularity Flow: Capabilities",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "singularityFlow.openInbox",
        "title": "Singularity Flow: Inbox (work summary)",
        "icon": "$(inbox)"
      },
      {
        "command": "singularityFlow.openApprovals",
        "title": "Singularity Flow: Approvals",
        "icon": "$(verified)"
      },
      {
        "command": "singularityFlow.openStories",
        "title": "Singularity Flow: Stories",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "singularityFlow.openImpact",
        "title": "Singularity Flow: Impact Analysis",
        "icon": "$(graph)"
      },
      {
        "command": "singularityFlow.openFlowImpact",
        "title": "Singularity Flow: Flow Impact Studies & Reports",
        "icon": "$(pulse)"
      },
      {
        "command": "singularityFlow.attachEvidence",
        "title": "Singularity Flow: Attach Evidence & Designs",
        "icon": "$(files)"
      },
      {
        "command": "singularityFlow.manageEvidence",
        "title": "Singularity Flow: Manage Evidence & Designs",
        "icon": "$(references)"
      },
      {
        "command": "singularityFlow.detachEvidence",
        "title": "Singularity Flow: Detach Evidence",
        "icon": "$(archive)"
      },
      {
        "command": "singularityFlow.addSource",
        "title": "Singularity Flow: Pin a Source",
        "icon": "$(new-file)"
      },
      {
        "command": "singularityFlow.refresh",
        "title": "Singularity Flow: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "singularityFlow.openJourney",
        "title": "Singularity Flow: Open Journey",
        "icon": "$(map)"
      },
      {
        "command": "singularityFlow.openReconciliation",
        "title": "Singularity Flow: Open Reconciliation",
        "icon": "$(git-compare)"
      },
      {
        "command": "singularityFlow.openArtifact",
        "title": "Singularity Flow: Open Artifact"
      },
      {
        "command": "singularityFlow.runAction",
        "title": "Singularity Flow: Run This Action",
        "icon": "$(play)"
      },
      {
        "command": "singularityFlow.reopenCompleted",
        "title": "Singularity Flow: Request Changes to Completed Story",
        "icon": "$(git-pull-request-go-to-changes)"
      },
      {
        "command": "singularityFlow.cancelWork",
        "title": "Singularity Flow: Cancel and Archive Story",
        "icon": "$(archive)"
      },
      {
        "command": "singularityFlow.prepareStoryPhase",
        "title": "Singularity Flow: Prepare Current Story Phase",
        "icon": "$(tools)"
      },
      {
        "command": "singularityFlow.publishStoryPhase",
        "title": "Singularity Flow: Publish Current Story Phase",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "singularityFlow.submitStoryPhase",
        "title": "Singularity Flow: Submit Current Story Phase",
        "icon": "$(send)"
      },
      {
        "command": "singularityFlow.approve",
        "title": "Singularity Flow: Approve\u2026",
        "icon": "$(check)"
      },
      {
        "command": "singularityFlow.showImpact",
        "title": "Singularity Flow: Show Computed Impact"
      },
      {
        "command": "singularityFlow.doctor",
        "title": "Singularity Flow: Diagnostics",
        "icon": "$(pulse)"
      },
      {
        "command": "singularityFlow.addCapability",
        "title": "Singularity Flow: Add a Capability",
        "icon": "$(add)"
      },
      {
        "command": "singularityFlow.editCapability",
        "title": "Singularity Flow: Edit This Capability",
        "icon": "$(edit)"
      },
      {
        "command": "singularityFlow.switchWorkspace",
        "title": "Singularity Flow: Work in This Workspace",
        "icon": "$(check)"
      },
      {
        "command": "singularityFlow.openWorkspace",
        "title": "Singularity Flow: Open This Workspace's Lead Repository",
        "icon": "$(folder-opened)"
      },
      {
        "command": "singularityFlow.openHelp",
        "title": "Singularity Flow: Help Center",
        "icon": "$(question)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "singularityFlow.openArtifact",
          "when": "false"
        },
        {
          "command": "singularityFlow.runAction",
          "when": "false"
        },
        {
          "command": "singularityFlow.approve",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  }
}
