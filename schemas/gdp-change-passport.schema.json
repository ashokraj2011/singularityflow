{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/gdp-change-passport.schema.json",
  "title": "GDP Change Passport v1",
  "$comment": "GDP-M2 immutable shadow identity. It grants no authority and is not consumed by gates or publication.",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "passportId", "revision", "priorPassportSha256", "subject",
    "selectionSha256", "candidateSha256", "proofSubjectSha256", "proofSummarySha256",
    "decisionRefs", "publicationRefs", "status", "passportSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "change-passport" },
    "passportId": { "$ref": "#/$defs/boundedId" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "priorPassportSha256": { "$ref": "#/$defs/nullableDigest" },
    "subject": { "$ref": "#/$defs/subject" },
    "selectionSha256": { "$ref": "#/$defs/digest" },
    "candidateSha256": { "$ref": "#/$defs/digest" },
    "proofSubjectSha256": { "$ref": "#/$defs/digest" },
    "proofSummarySha256": { "$ref": "#/$defs/nullableDigest" },
    "decisionRefs": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 256, "uniqueItems": true },
    "publicationRefs": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "maxItems": 256, "uniqueItems": true },
    "status": { "enum": [
      "draft", "contracted", "ready-to-execute", "executing", "candidate-ready",
      "evidence-required", "decision-required", "rejected", "admitted", "publication-pending",
      "published", "production-observation-required", "closed", "rolled-back", "cancelled",
      "recovery-required"
    ] },
    "passportSha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "x-sflow-selfHash": "passportSha256",
  "x-sflow-semanticFields": [
    "schemaVersion", "kind", "passportId", "revision", "priorPassportSha256", "subject",
    "selectionSha256", "candidateSha256", "proofSubjectSha256", "proofSummarySha256",
    "decisionRefs", "publicationRefs", "status"
  ],
  "$defs": {
    "boundedId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "subject": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["story", "outcome", "initiative"] },
        "id": { "$ref": "#/$defs/boundedId" }
      },
      "additionalProperties": false
    }
  }
}
