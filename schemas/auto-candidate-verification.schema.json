{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/auto-candidate-verification.schema.json",
  "title": "Singularity Flow isolated Auto Candidate verification v2",
  "type": "object",
  "required": ["schemaVersion", "integrityVersion", "kind", "flightId", "candidateId", "candidateSha256", "bindingSha256", "status", "commands", "repairEvidence", "candidateTreeUnchanged", "verifiedAt", "verificationReceiptSha256"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "integrityVersion": { "enum": [1, 2] },
    "kind": { "const": "auto-candidate-verification" },
    "flightId": { "type": "string", "pattern": "^AFL-[A-F0-9]{26}$" },
    "candidateId": { "type": "string", "pattern": "^CAN-[A-F0-9]{26}$" },
    "candidateSha256": { "$ref": "#/$defs/hash" },
    "bindingSha256": { "$ref": "#/$defs/hash" },
    "status": { "enum": ["passed", "failed"] },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "argvSha256", "workingDirectory", "status", "signal", "timedOut", "overflow", "outputSha256", "outputBytes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "argvSha256": { "$ref": "#/$defs/hash" },
          "workingDirectory": { "type": "string", "minLength": 1 },
          "status": { "type": "integer" },
          "signal": { "type": ["string", "null"] },
          "timedOut": { "type": "boolean" },
          "overflow": { "type": "boolean" },
          "outputSha256": { "$ref": "#/$defs/hash" },
          "outputBytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "repairEvidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["kind", "source", "commandId", "commandArgvSha256", "adapter", "resultSha256", "resultBytes", "tests", "repairScope"],
        "properties": {
          "kind": { "const": "structured-test-failure" },
          "source": { "const": "registered-verifier" },
          "commandId": { "type": "string", "minLength": 1 },
          "commandArgvSha256": { "$ref": "#/$defs/hash" },
          "adapter": { "enum": ["junit-xml", "jest-json", "vitest-json", "playwright-json", "go-test-json", "node-tap", "dotnet-trx", "cargo-json", "sflow-test-result-v1"] },
          "resultSha256": { "$ref": "#/$defs/hash" },
          "resultBytes": { "type": "integer", "minimum": 1 },
          "tests": {
            "type": "object",
            "required": ["discovered", "passed", "failed", "skipped"],
            "properties": {
              "discovered": { "type": "integer", "minimum": 1 },
              "passed": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 1 },
              "skipped": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "repairScope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "candidateTreeUnchanged": { "type": "boolean" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "verificationReceiptSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
  "allOf": [{
    "if": { "properties": { "integrityVersion": { "const": 1 } }, "required": ["integrityVersion"] },
    "then": { "properties": { "repairEvidence": { "maxItems": 0 } } }
  }],
  "additionalProperties": false
}
