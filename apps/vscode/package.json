        {
          "command": "singularityFlow.previewSelectedImpact",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "singularityFlow.explainTopic",
          "when": "false"
        },
        {
          "command": "singularityFlow.explainError",
          "when": "false"
        },
        {
          "command": "singularityFlow.copyHelpCommand",
