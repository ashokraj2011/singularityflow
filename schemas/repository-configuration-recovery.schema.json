{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/repository-configuration-recovery.schema.json",
  "title": "Singularity Flow Repository Configuration Recovery v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "mode",
    "planId",
    "repositoryIdentity",
    "state",
    "sourceDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "repository-configuration-recovery" },
    "mode": { "enum": ["auto", "migrate", "recreate"] },
    "planId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repositoryIdentity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "state": {
      "type": "object",
      "required": ["branch", "commit", "sourceCommit"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "sourceCommit": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
      },
      "additionalProperties": false
    },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
