{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-grounding-reference.schema.json",
  "title": "WMP immutable Story grounding reference",
  "type": "object",
  "required": ["schemaVersion", "kind", "subject", "source", "model", "views", "inputRefs", "selection", "renderedBlock", "completeness", "budget", "authority", "groundingSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-grounding-reference" },
    "subject": { "$ref": "#/$defs/subject" },
    "source": { "$ref": "#/$defs/source" },
    "model": { "$ref": "#/$defs/model" },
    "views": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/view" } },
    "inputRefs": { "$ref": "#/$defs/objectRefs" },
    "selection": { "$ref": "#/$defs/selection" },
    "renderedBlock": { "$ref": "#/$defs/objectRef" },
    "completeness": { "$ref": "#/$defs/completeness" },
    "budget": { "$ref": "#/$defs/budget" },
    "authority": { "$ref": "#/$defs/authority" },
    "groundingSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "git": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "factId": { "type": "string", "pattern": "^FACT-[a-f0-9]{16,64}$" },
    "subjectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "typeId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$", "maxLength": 128 },
    "objectRef": {
      "type": "object", "required": ["role", "family", "mediaType", "sha256", "bytes"],
      "properties": {
        "role": { "$ref": "#/$defs/typeId" },
        "family": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
        "mediaType": { "enum": ["application/json", "text/markdown"] },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 }
      }, "additionalProperties": false
    },
    "objectRefs": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/objectRef" } },
    "gap": {
      "type": "object", "required": ["code", "required", "subject", "reference"],
      "properties": {
        "code": { "$ref": "#/$defs/reasonCode" }, "required": { "type": "boolean" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 512 },
        "reference": { "oneOf": [{ "$ref": "#/$defs/objectRef" }, { "type": "null" }] }
      }, "additionalProperties": false
    },
    "subject": {
      "type": "object", "required": ["repositoryDomainSha256", "workId", "workflowInstanceId", "phase", "generation", "packetId"],
      "properties": {
        "repositoryDomainSha256": { "$ref": "#/$defs/hash" }, "workId": { "$ref": "#/$defs/subjectId" },
        "workflowInstanceId": { "$ref": "#/$defs/subjectId" }, "phase": { "$ref": "#/$defs/typeId" },
        "generation": { "type": "integer", "minimum": 1 }, "packetId": { "$ref": "#/$defs/subjectId" }
      }, "additionalProperties": false
    },
    "source": {
      "type": "object", "required": ["kind", "bindingSha256", "snapshotSha256", "requestedRevision", "effectiveRevision", "comparisonBase"],
      "properties": {
        "kind": { "enum": ["committed", "candidate"] }, "bindingSha256": { "$ref": "#/$defs/hash" },
        "snapshotSha256": { "$ref": "#/$defs/hash" }, "requestedRevision": { "$ref": "#/$defs/git" },
        "effectiveRevision": { "$ref": "#/$defs/git" },
        "comparisonBase": { "oneOf": [{ "$ref": "#/$defs/git" }, { "type": "null" }] }
      }, "additionalProperties": false
    },
    "model": {
      "type": "object", "required": ["modelKey", "bindingRef", "modelPayloadSha256"],
      "properties": { "modelKey": { "$ref": "#/$defs/hash" }, "bindingRef": { "$ref": "#/$defs/objectRef" }, "modelPayloadSha256": { "$ref": "#/$defs/hash" } },
      "additionalProperties": false
    },
    "view": {
      "type": "object", "required": ["viewKey", "bindingRef", "variant", "renderedRef"],
      "properties": { "viewKey": { "$ref": "#/$defs/hash" }, "bindingRef": { "$ref": "#/$defs/objectRef" }, "variant": { "enum": ["brief", "full"] }, "renderedRef": { "$ref": "#/$defs/objectRef" } },
      "additionalProperties": false
    },
    "selection": {
      "type": "object", "required": ["selectedFactIds", "omittedFactIds", "selectedContentSha256", "omittedContentSha256"],
      "properties": {
        "selectedFactIds": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/factId" } },
        "omittedFactIds": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/factId" } },
        "selectedContentSha256": { "$ref": "#/$defs/hash" }, "omittedContentSha256": { "$ref": "#/$defs/hash" }
      }, "additionalProperties": false
    },
    "completeness": {
      "type": "object", "required": ["status", "gaps"],
      "properties": { "status": { "enum": ["complete", "limited"] }, "gaps": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/gap" } } },
      "additionalProperties": false
    },
    "budget": {
      "type": "object", "required": ["mode", "maximum", "measured", "tokenizerSha256"],
      "properties": { "mode": { "enum": ["tokens", "bytes"] }, "maximum": { "type": "integer", "minimum": 1 }, "measured": { "type": "integer", "minimum": 0 }, "tokenizerSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] } },
      "additionalProperties": false
    },
    "authority": {
      "type": "object", "required": ["repositoryDomainSha256", "stateRef", "authorityCommit", "publicationRef", "validationRefs"],
      "properties": {
        "repositoryDomainSha256": { "$ref": "#/$defs/hash" }, "stateRef": { "type": "string", "pattern": "^refs/[A-Za-z0-9._/-]+$", "maxLength": 512 },
        "authorityCommit": { "$ref": "#/$defs/git" }, "publicationRef": { "$ref": "#/$defs/objectRef" }, "validationRefs": { "$ref": "#/$defs/objectRefs" }
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
