{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-build-plan.schema.json",
  "title": "WMB v4 build plan", "type": "object",
  "required": ["schemaVersion", "kind", "requestSha256", "sourceManifestSha256", "scopeManifestSha256", "views", "extractors", "factRequirements", "bodyAccess", "budgets", "estimatedWork", "planSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-build-plan" },
    "requestSha256": { "$ref": "#/$defs/hash" }, "sourceManifestSha256": { "$ref": "#/$defs/hash" }, "scopeManifestSha256": { "$ref": "#/$defs/hash" },
    "views": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["viewId", "viewVersion", "viewSpecSha256", "required", "cacheStatus"], "properties": { "viewId": { "$ref": "#/$defs/viewId" }, "viewVersion": { "type": "integer", "minimum": 1 }, "viewSpecSha256": { "$ref": "#/$defs/hash" }, "required": { "type": "boolean" }, "cacheStatus": { "enum": ["hit", "miss", "stale", "corrupt"] } }, "additionalProperties": false } },
    "extractors": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" }, "uniqueItems": true }, "factRequirements": { "type": "array", "items": { "$ref": "#/$defs/factType" }, "uniqueItems": true },
    "bodyAccess": { "type": "array", "items": { "$ref": "#/$defs/viewId" }, "uniqueItems": true },
    "budgets": { "type": "object", "required": ["totalMaximumOutputTokens", "maximumViewOutputTokens"], "properties": { "totalMaximumOutputTokens": { "type": "integer", "minimum": 1 }, "maximumViewOutputTokens": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "estimatedWork": { "type": "object", "required": ["sourceFiles", "views", "deterministicExtractors", "maximumCompositionCalls"], "properties": { "sourceFiles": { "type": "integer", "minimum": 0 }, "views": { "type": "integer", "minimum": 1 }, "deterministicExtractors": { "type": "integer", "minimum": 0 }, "maximumCompositionCalls": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "planSha256": { "$ref": "#/$defs/hash" }
  }, "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "viewId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "factType": { "enum": ["file-exists", "language-detected", "symbol-exists", "symbol-index", "signature", "export", "import-dependency", "dependency-edge", "dependency-analysis", "configuration-object", "changed-symbol", "contract-change", "test-impact", "structural-impact", "runtime-frequency", "interface", "implementation", "consumer-dependency", "schema-contract", "protocol-field", "runtime-guarantee", "change-frequency", "dependency-degree", "complexity-metric", "incident-mapping", "ownership-concentration", "rule-definition", "condition-expression", "clause-binding", "test-identity", "maintainer-record", "business-glossary", "business-meaning"] }
  }, "additionalProperties": false
}
