{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://singularity-flow.dev/schemas/gdp-witness-independence.schema.json", "title": "GDP Witness Independence v1", "type": "object",
  "required": ["schemaVersion", "kind", "workId", "proofSubjectSha256", "witnessRefs", "independentRefs", "conflictingRefs", "status", "independenceSha256"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "witness-independence" }, "workId": { "$ref": "#/$defs/id" }, "proofSubjectSha256": { "$ref": "#/$defs/digest" }, "witnessRefs": { "$ref": "#/$defs/digests" }, "independentRefs": { "$ref": "#/$defs/digests" }, "conflictingRefs": { "$ref": "#/$defs/digests" }, "status": { "enum": ["independent", "conflicting", "unavailable"] }, "independenceSha256": { "$ref": "#/$defs/digest" } }, "additionalProperties": false, "x-sflow-selfHash": "independenceSha256",
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "digests": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } } }
}
