{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/harness-checker-result.schema.json", "type": "object",
  "required": ["schemaVersion", "checkerId", "checkerVersion", "coverage", "verdict", "reasons"],
