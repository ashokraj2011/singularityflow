{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-refusal.schema.json",
  "title": "WMB v4 refusal", "type": "object",
  "required": ["schemaVersion", "kind", "code", "view", "preserved", "failures", "nextAction", "refusalSha256"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-refusal" }, "code": { "type": "string", "pattern": "^WMB_[A-Z0-9_]+$" }, "view": { "type": ["string", "null"] }, "preserved": { "type": "object", "required": ["evidenceCatalogSha256", "factLedgerSha256", "validViewIds"], "properties": { "evidenceCatalogSha256": { "$ref": "#/$defs/hash" }, "factLedgerSha256": { "$ref": "#/$defs/hash" }, "validViewIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } }, "additionalProperties": false }, "failures": { "type": "array", "minItems": 1, "items": { "type": "object" } }, "nextAction": { "type": "object", "required": ["operation"], "properties": { "operation": { "enum": ["world-model.regenerate-view", "world-model.migrate", "world-model.inspect"] }, "view": { "type": "string" }, "reuseFacts": { "type": "boolean" } }, "additionalProperties": false }, "refusalSha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }, "additionalProperties": false
}
