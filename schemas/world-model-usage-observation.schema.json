{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-usage-observation.schema.json",
  "title": "WMB v4 usage observation", "type": "object",
  "required": ["schemaVersion", "kind", "viewId", "promptBytes", "estimatedInputTokens", "providerInputTokens", "providerCachedTokens", "outputBytes", "estimatedOutputTokens", "providerOutputTokens", "cost", "assurance", "observationSha256"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-usage-observation" }, "viewId": { "type": "string" }, "promptBytes": { "type": "integer", "minimum": 0 }, "estimatedInputTokens": { "type": "integer", "minimum": 0 }, "providerInputTokens": { "type": ["integer", "null"], "minimum": 0 }, "providerCachedTokens": { "type": ["integer", "null"], "minimum": 0 }, "outputBytes": { "type": "integer", "minimum": 0 }, "estimatedOutputTokens": { "type": "integer", "minimum": 0 }, "providerOutputTokens": { "type": ["integer", "null"], "minimum": 0 }, "cost": { "type": "object", "required": ["currency", "amount", "assurance"], "properties": { "currency": { "const": "USD" }, "amount": { "type": ["number", "null"], "minimum": 0 }, "assurance": { "enum": ["provider-reported", "unavailable"] } }, "additionalProperties": false }, "assurance": { "type": "object", "required": ["promptBytes", "estimatedTokens", "providerTokens"], "properties": { "promptBytes": { "const": "exact" }, "estimatedTokens": { "const": "estimated" }, "providerTokens": { "enum": ["provider-reported", "unavailable"] } }, "additionalProperties": false }, "observationSha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }, "additionalProperties": false
}
