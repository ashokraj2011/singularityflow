{
  "name": "singularity-flow",
  "version": "0.9.0",
  "description": "Singularity Flow: direct sf-* Copilot skills with YAML-configured work profiles, governed agents, human approval authorities, templates, Git state transfer, and deterministic governance.",
  "type": "module",
  "bin": {
    "singularity-flow": "bin/singularity-flow.mjs",
    "sflow": "bin/singularity-flow.mjs",
    "sflow-about": "bin/sflow-about.mjs",
    "sflow-inbox": "bin/sflow-inbox.mjs",
    "sflow-next": "bin/sflow-next.mjs",
    "sflow-agent": "bin/sflow-agent.mjs",
    "sf-reset-all": "bin/sf-reset-all.mjs",
    "sflow-wm-minimal": "bin/sflow-wm-minimal.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "plugin/",
    "templates/",
    "schemas/",
    "examples/",
    "docs/",
    "README.md",
    "HELP.md",
    "HOW-TO.md",
    "LOCAL-RUNBOOK.md",
    "ARCHITECTURE.md",
    "CAPABILITY-LEDGER.md",
    "VERIFICATION.md",
    "RELEASE-PHASE-INPUTS.md",
    "RELEASE-EPIC-STORY-LINEAGE.md",
    "DISTRIBUTION.md",
    "INITIATIVE-ORCHESTRATION.md",
    "NATIVE-COPILOT.md",
    "WORKSPACES.md",
    "RELEASE-INITIATIVE-ORCHESTRATION.md",
    "scripts/worldmodel-minimal.sh",
    "LICENSE"
  ],
  "workspaces": [
    "apps/vscode"
  ],
  "scripts": {
    "test": "npm run test:all",
    "test:cli": "node scripts/run-test-suite.mjs cli",
    "test:vscode": "node scripts/run-test-suite.mjs vscode",
    "test:all": "node scripts/run-test-suite.mjs all",
    "test:no-model": "node --test test/model-boundary.test.mjs test/no-model-operations.test.mjs test/no-model-lifecycle.test.mjs",
    "test:manual-authorship": "node --test test/manual-authorship.test.mjs test/manual-import.test.mjs",
    "check": "node scripts/check.mjs",
    "audit:skills": "node scripts/audit-skills.mjs",
    "audit:skills:write": "node scripts/audit-skills.mjs --write",
    "audit:model-boundary": "node scripts/audit-model-boundary.mjs",
    "operation-catalog:generate": "node scripts/generate-operation-catalog.mjs --write",
    "operation-catalog:check": "node scripts/generate-operation-catalog.mjs",
    "codeowners:generate": "node scripts/generate-codeowners.mjs --write",
    "codeowners:check": "node scripts/generate-codeowners.mjs",
    "gate": "node scripts/gate.mjs",
    "wm:minimal": "./scripts/worldmodel-minimal.sh",
    "pack:dry": "npm pack --dry-run",
    "install:local": "bash ./install.sh",
    "vscode:build": "npm run build --workspace singularity-flow-vscode",
    "vscode:watch": "npm run watch --workspace singularity-flow-vscode",
    "vscode:typecheck": "npm run typecheck --workspace singularity-flow-vscode",
    "vscode:dev": "node scripts/vscode-dev.mjs",
    "vscode:demo": "node scripts/vscode-dev.mjs --demo-only",
    "vscode:demo:github": "node scripts/vscode-dev.mjs --github",
    "vscode:demo:clean": "node scripts/vscode-dev.mjs --clean-github",
    "vscode:package": "node scripts/vscode-dev.mjs --package",
    "vscode:visual-fixtures": "node --experimental-strip-types scripts/render-vscode-visual-fixtures.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "benchmark:dx": "node scripts/dx-benchmark.mjs",
    "benchmark:dx:enforce": "node scripts/dx-benchmark.mjs --enforce"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github-copilot",
    "agent-skills",
    "sdlc",
    "workflow",
    "git",
    "jira",
    "singularity-flow",
    "copilot-plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
