{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/capabilities.schema.json",
  "title": "Singularity Flow capability tree",
  "type": "object",
  "required": [
    "version",
    "capabilities"
  ],
  "properties": {
    "version": {
      "enum": [1, 2]
    },
    "management": {
      "type": "object"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "description": "Structural responsibility: collections group capabilities; deliveries ship from repositories.",
            "enum": [
              "collection",
              "delivery"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "owns": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "policy": {
            "type": "object",
            "properties": {
              "gateSeverity": {
                "enum": [
                  "off",
                  "warn",
                  "block"
                ]
              },
              "approvalMinimum": {
                "type": "integer",
                "minimum": 1
              },
              "allowSelfApproval": {
                "type": "boolean"
              },
              "maxDocumentBytes": {
                "type": "integer",
                "minimum": 1
              },
              "allowedPhases": {
                "$ref": "#/$defs/stringSet"
              },
              "requiredChecks": {
                "$ref": "#/$defs/stringSet"
              },
              "requiredAuthorityGroups": {
                "$ref": "#/$defs/stringSet"
              },
              "jiraProjects": {
                "$ref": "#/$defs/stringSet"
              },
              "jiraHosts": {
                "$ref": "#/$defs/stringSet"
              },
              "jiraOperations": {
                "$ref": "#/$defs/stringSet"
              },
              "jiraFields": {
                "$ref": "#/$defs/stringSet"
              },
              "protectedPaths": {
                "$ref": "#/$defs/stringSet"
              },
              "worldModelGrounding": {
                "enum": [
                  "off",
                  "warn",
                  "enforce"
                ]
              },
              "worldModelStaleness": {
                "enum": [
                  "ignore",
                  "warn",
                  "fail"
                ]
              },
              "requiredWorldModelViews": {
                "$ref": "#/$defs/stringSet"
              },
              "writeScopes": {
                "$ref": "#/$defs/stringSet"
              },
              "qualityCommands": {
                "$ref": "#/$defs/stringSet"
              },
              "storageProviders": {
                "$ref": "#/$defs/stringSet"
              },
              "allowedMimeTypes": {
                "$ref": "#/$defs/stringSet"
              },
              "tokenBudget": {
                "type": "integer",
                "minimum": 1
              },
              "gitPublication": {
                "enum": [
                  "off",
                  "warn",
                  "required"
                ]
              },
              "contextBoundary": {
                "enum": [
                  "keep",
                  "compact",
                  "new"
                ]
              },
              "contextMaxBytes": {
                "type": "integer",
                "minimum": 1
              },
              "auto": {
                "type": "object",
                "properties": {
                  "eligibility": { "enum": ["disabled", "plan-only", "bounded"] },
                  "forbiddenWhenProtectedScopePredicted": { "type": "boolean" },
                  "maximumTouchedPaths": { "type": "integer", "minimum": 1 },
                  "maximumConcurrentFlights": { "type": "integer", "minimum": 1 },
                  "ceilings": { "type": "object" }
                },
                "additionalProperties": false
              },
              "localIntegrationEvidence": {
                "description": "Whether an environment-linked quality command may run on the person's machine with its private values and count as local-integration evidence. Inherited parent to child; a child may turn it off but never allowed under an off parent.",
                "enum": ["off", "allowed"]
              },
              "staticAnalysis": {
                "description": "enforce holds a code step for a person while lint, static-analysis or security findings on new code remain; warn leaves the workflow's codeDelivery.staticAnalysis as it is. A child may enforce under a warn parent, never warn under an enforce one [CQF decision 6].",
                "enum": ["enforce", "warn"]
              }
            },
            "additionalProperties": false
          },
          "application": {
            "description": "How this delivery capability's application starts locally and which quality commands are its tests. Edited through the reviewed capability proposal.",
            "type": "object",
            "properties": {
              "start": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "required": ["id", "url", "ready"],
                  "if": { "anyOf": [{ "not": { "required": ["type"] } }, { "required": ["type"], "properties": { "type": { "const": "command" } } }] },
                  "then": { "required": ["argv"] },
                  "else": { "not": { "required": ["argv"] } },
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
                    "repository": { "description": "Required when the capability has several repositories.", "type": "string", "minLength": 1 },
                    "dependsOn": { "description": "Start-entry IDs whose services must be ready first.", "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 } },
                    "argv": {
                      "description": "Shell-free argument list; no shell runs it.",
                      "type": "array", "minItems": 1, "maxItems": 256,
                      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    },
                    "workingDirectory": { "description": "Repository-relative, without '..'.", "type": "string", "minLength": 1 },
                    "url": { "description": "http or https on 127.0.0.1, localhost or [::1]; no credentials, query or fragment.", "type": "string", "format": "uri" },
                    "ready": {
                      "type": "object",
                      "properties": {
                        "http": { "description": "Ready when this path answers below 500.", "type": "string", "pattern": "^/(?!/)" },
                        "log": { "description": "Ready when this literal text appears in the output.", "type": "string", "minLength": 1, "maxLength": 200 },
                        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
                      },
                      "oneOf": [{ "required": ["http"] }, { "required": ["log"] }],
                      "additionalProperties": false
                    },
                    "environments": { "$ref": "#/$defs/environmentList" },
                    "arguments": {
                      "description": "A map: arguments appended for one environment, each key one of the entry's environments. A list, for types maven, gradle, npm and dotnet: the type's own arguments.",
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array", "minItems": 1, "maxItems": 64,
                            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                          }
                        },
                        { "$ref": "#/$defs/argumentList" }
                      ]
                    },
                    "name": { "description": "Display name; defaults to id.", "type": "string", "minLength": 1, "maxLength": 128 },
                    "type": {
                      "description": "How the entry starts (docs/topics/run-and-test.md, Run configuration types); command, the default, runs argv as written.",
                      "enum": ["spring-boot", "jar", "application", "maven", "gradle", "python", "django", "fastapi", "flask", "node", "npm", "go", "dotnet", "command"]
                    },
                    "launcher": { "description": "spring-boot: maven | gradle; application: maven-exec | gradle-run. Defaults from the nearest build file.", "enum": ["maven", "gradle", "maven-exec", "gradle-run"] },
                    "mainClass": { "description": "spring-boot, application: the Java main class.", "type": "string", "pattern": "^[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*$" },
                    "vmOptions": { "description": "spring-boot, jar, application: JVM options.", "$ref": "#/$defs/argumentList" },
                    "programArguments": { "description": "spring-boot, jar, application, go: the program's own arguments.", "$ref": "#/$defs/argumentList" },
                    "activeProfiles": { "description": "spring-boot: active profiles.", "$ref": "#/$defs/nameList" },
                    "jar": { "description": "jar: the jar to run.", "$ref": "#/$defs/repositoryPath" },
                    "goals": { "description": "maven: goals; options go in arguments.", "$ref": "#/$defs/goalList" },
                    "tasks": { "description": "gradle: tasks; options go in arguments.", "$ref": "#/$defs/goalList" },
                    "profiles": { "description": "maven: profiles (-P).", "$ref": "#/$defs/nameList" },
                    "properties": {
                      "description": "maven: -Dname=value; gradle: -Pname=value. Never a secret.",
                      "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z_][\\w.-]{0,127}$" },
                      "additionalProperties": { "type": ["string", "number", "boolean"] }
                    },
                    "script": { "description": "python, node: the script (repository-relative); npm: the package.json script.", "type": "string", "minLength": 1 },
                    "module": { "description": "python: the module run with -m.", "type": "string", "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$" },
                    "interpreter": { "description": "python types: a command on PATH or a repository-relative path; defaults to .venv/bin/python, then python3.", "type": "string", "minLength": 1 },
                    "interpreterOptions": { "description": "python types: interpreter options.", "$ref": "#/$defs/argumentList" },
                    "parameters": { "description": "python types: script, module or server parameters.", "$ref": "#/$defs/argumentList" },
                    "manage": { "description": "django: manage.py; defaults to the working directory's.", "$ref": "#/$defs/repositoryPath" },
                    "host": { "description": "django, fastapi, flask: loopback only; defaults to the url's host.", "enum": ["127.0.0.1", "localhost", "::1"] },
                    "port": { "description": "django, fastapi, flask: defaults to, and must equal, the url's port.", "type": "integer", "minimum": 1, "maximum": 65535 },
                    "settings": { "description": "django: --settings module.", "type": "string", "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$" },
                    "noReload": { "description": "django: --noreload.", "type": "boolean" },
                    "app": { "description": "fastapi: module:attribute; flask: module, module:attribute or module:factory().", "type": "string", "minLength": 1 },
                    "reload": { "description": "fastapi, flask: --reload (left off under the debugger).", "type": "boolean" },
                    "nodeOptions": { "description": "node: Node options.", "$ref": "#/$defs/argumentList" },
                    "applicationParameters": { "description": "node: the script's arguments.", "$ref": "#/$defs/argumentList" },
                    "nodeInterpreter": { "description": "node: a command on PATH or a repository-relative path; defaults to node.", "type": "string", "minLength": 1 },
                    "packageManager": { "description": "npm: defaults from the nearest lock file, else npm.", "enum": ["npm", "pnpm", "yarn"] },
                    "kind": { "description": "go: what target names; defaults to package.", "enum": ["package", "file", "directory"] },
                    "target": { "description": "go: a package, or a repository-relative file or directory.", "type": "string", "minLength": 1 },
                    "goToolArguments": { "description": "go: go run flags.", "$ref": "#/$defs/argumentList" },
                    "project": { "description": "dotnet: the project file or directory.", "$ref": "#/$defs/repositoryPath" },
                    "launchProfile": { "description": "dotnet: --launch-profile.", "type": "string", "minLength": 1 },
                    "configuration": { "description": "dotnet: -c.", "type": "string", "minLength": 1 },
                    "env": {
                      "description": "Literal variables for the application only: UPPER_CASE, not reserved, never a secret (secrets stay in environments.yml).",
                      "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
                      "additionalProperties": { "type": ["string", "number", "boolean"] }
                    },
                    "beforeLaunch": {
                      "description": "Steps run in order before the application, like IntelliJ's Before launch; a failing step stops the start.",
                      "type": "array", "maxItems": 8,
                      "items": {
                        "type": "object", "required": ["argv"],
                        "properties": {
                          "argv": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
                          "workingDirectory": { "$ref": "#/$defs/repositoryPath" },
                          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 1800000 }
                        },
                        "additionalProperties": false
                      }
                    },
                    "perEnvironment": {
                      "description": "Per environment (one of environments): the type's fields it replaces, env it merges by name and beforeLaunch it replaces.",
                      "type": "object", "additionalProperties": { "type": "object" }
                    },
                    "debug": {
                      "description": "How app start --debug runs this entry with a debugger listening on 127.0.0.1 only. runtime is required for type command; a typed entry's follows from its type.",
                      "type": "object",
                      "properties": {
                        "runtime": { "enum": ["java", "python", "node", "go", "dotnet"] },
                        "port": { "description": "Loopback port; defaults java 5005, python 5678, node 9229, go 2345. dotnet has none.", "type": "integer", "minimum": 1024, "maximum": 65535 },
                        "suspend": { "description": "java and node only: wait for the debugger before running.", "type": "boolean" },
                        "argv": {
                          "description": "A full replacement argv for the debug start; it must start one loopback listener.",
                          "type": "array", "minItems": 1, "maxItems": 256,
                          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                        },
                        "arguments": {
                          "description": "Arguments appended for the debug start instead of the runtime's own injection.",
                          "type": "array", "minItems": 1, "maxItems": 64,
                          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                        },
                        "environment": {
                          "description": "Exactly one of NODE_OPTIONS, JAVA_TOOL_OPTIONS or JDK_JAVA_OPTIONS, set to the debugger flag alone.",
                          "type": "object", "minProperties": 1, "maxProperties": 1,
                          "properties": {
                            "NODE_OPTIONS": { "type": "string", "pattern": "^--inspect(?:-brk|-wait)?(?:=[^\\s\"']+)?$" },
                            "JAVA_TOOL_OPTIONS": { "type": "string", "pattern": "^-agentlib:jdwp=[^\\s\"']+$" },
                            "JDK_JAVA_OPTIONS": { "type": "string", "pattern": "^-agentlib:jdwp=[^\\s\"']+$" }
                          },
                          "additionalProperties": false
                        }
                      },
                      "not": { "required": ["argv", "arguments"] },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "tests": {
                "description": "Absent means what the code step runs.",
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "required": ["use"],
                  "properties": {
                    "use": { "description": "A qualityCommands ID from workflow.yml.", "type": "string", "minLength": 1 },
                    "environments": { "$ref": "#/$defs/environmentList" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "jira": {
            "type": "object",
            "properties": {
              "projectKey": { "type": "string" },
              "board": { "type": "string" },
              "component": { "type": "string" }
            }
          },
          "teams": {
            "$ref": "#/$defs/stringSet"
          },
          "sourceHashExcludedRoots": {
            "description": "Repository-relative directories hashed as separate test inputs rather than source.",
            "$ref": "#/$defs/sourceRoots"
          },
          "testConfigurationPaths": {
            "description": "Exact repository-relative test configuration files hashed as separate test inputs.",
            "$ref": "#/$defs/sourceRoots"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capability", "contract"],
              "properties": {
                "capability": { "type": "string", "minLength": 1 },
                "contract": { "type": "object" }
              },
              "additionalProperties": false
            }
          },
          "type": {
            "description": "Optional domain classification, separate from the collection/delivery structural kind.",
            "enum": [
              "tech",
              "business"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "description": "Single-repository shorthand. Reads the same as a one-entry repositories list.",
            "type": "string",
            "minLength": 1
          },
          "repositories": {
            "description": "Every repository this capability ships from.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "leadRepository": {
            "description": "Which of them holds this capability's governed state and world model.",
            "type": "string",
            "minLength": 1
          },
          "sourceRoots": {
            "description": "Repository-relative source directories for this capability's lead-repository world model. The nearest explicit descendant scope wins.",
            "$ref": "#/$defs/sourceRoots"
          },
          "sharedRoots": {
            "description": "Repository-relative shared directories included with this capability and inherited additively from ancestors.",
            "$ref": "#/$defs/sourceRoots"
          },
          "appId": {
            "description": "The organisation's own application identifier (an app registry or CMDB entry). Recorded and shown only; nothing routes, approves or names a branch by it.",
            "oneOf": [
              { "type": "string", "pattern": "^\\S{1,64}$" },
              { "type": "integer", "minimum": 0 }
            ]
          },
          "metadata": {
            "description": "Organisation-defined key/value attributes such as cost centre, owner code, or service tier.",
            "type": "object",
            "propertyNames": { "minLength": 1 },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "documentation": {
            "description": "Confluence pages, design docs, anything written about this capability. Free-form key/value, because every organisation names these differently.",
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "resources": {
            "description": "Cloud accounts, dashboards, queues \u2014 anything it runs on or against. Free-form key/value, because every organisation names these differently.",
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "collection" } },
              "required": ["kind"]
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["repository"] },
                  { "required": ["repositories"] },
                  { "required": ["leadRepository"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "delivery" } },
              "required": ["kind"]
            },
            "then": {
              "anyOf": [
                { "required": ["repository"] },
                {
                  "required": ["repositories"],
                  "properties": { "repositories": { "minItems": 1 } }
                }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "argumentList": {
      "description": "Shell-free arguments; no shell runs them.",
      "type": "array", "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "nameList": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[A-Za-z0-9][\\w.-]{0,63}$" } },
    "goalList": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "pattern": "^[^\\s-][^\\s]*$" } },
    "repositoryPath": { "description": "Repository-relative, without '..'.", "type": "string", "minLength": 1 },
    "environmentList": {
      "description": "Environments declared in singularity/environments.yml; the first is the default.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64 }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceRoots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}]).+$"
      }
    }
  },
  "additionalProperties": false
}
