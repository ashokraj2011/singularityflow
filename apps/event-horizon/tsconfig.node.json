{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@flow/*": [
        "src/shared/*"
      ],
      "@shared/*": [
        "../../vendor/event-horizon/src/shared/*"
      ],
      "event-horizon/core": [
        "../../vendor/event-horizon/src/main/core.ts"
      ],
      "event-horizon/providers/singularity-flow": [
        "../../vendor/event-horizon/src/main/providers/singularityFlow.ts"
      ]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/shared/**/*",
    "../../vendor/event-horizon/src/main/**/*",
    "../../vendor/event-horizon/src/shared/**/*"
  ]
}
