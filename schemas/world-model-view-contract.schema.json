{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-view-contract.schema.json",
  "title": "WMB v4 view contract", "type": "object",
  "required": ["schemaVersion", "kind", "id", "version", "title", "publisher", "sections", "factPolicy", "bodyAccess", "crossViewReferences", "narrative", "facts", "model", "budgets", "risk", "validity", "contractSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-view-contract" }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" }, "version": { "type": "integer", "minimum": 1 }, "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" } }, "additionalProperties": false },
    "sections": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "title", "required", "sectionKind"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }, "title": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" }, "sectionKind": { "enum": ["factual", "unavailable", "contradiction"] } }, "additionalProperties": false } },
    "factPolicy": { "type": "object", "required": ["requiredFactTypes", "optionalFactTypes", "allowedStatus", "allowedAssurance", "requiredUnavailableSubjects"], "properties": { "requiredFactTypes": { "$ref": "#/$defs/factTypes" }, "optionalFactTypes": { "$ref": "#/$defs/factTypes" }, "allowedStatus": { "type": "array", "uniqueItems": true, "items": { "enum": ["available", "partial", "unavailable", "contradicted"] } }, "allowedAssurance": { "type": "array", "uniqueItems": true, "items": { "enum": ["source-exact", "structurally-derived", "deterministically-derived", "human-confirmed", "runtime-observed", "heuristic", "model-advisory", "not-applicable"] } }, "requiredUnavailableSubjects": { "$ref": "#/$defs/factTypes" } }, "additionalProperties": false },
    "bodyAccess": { "type": "object", "required": ["allowed", "maximumBytes"], "properties": { "allowed": { "type": "boolean" }, "maximumBytes": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "crossViewReferences": { "type": "object", "required": ["allowed"], "properties": { "allowed": { "type": "boolean" } }, "additionalProperties": false },
    "narrative": { "type": "object", "required": ["tldrMaximumWords", "sectionMaximumWords", "totalMaximumWords", "factualUnitsRequireFactRefs"], "properties": { "tldrMaximumWords": { "type": "integer", "minimum": 1 }, "sectionMaximumWords": { "type": "integer", "minimum": 1 }, "totalMaximumWords": { "type": "integer", "minimum": 1 }, "factualUnitsRequireFactRefs": { "const": true } }, "additionalProperties": false },
    "facts": { "type": "object", "required": ["maximumSelectedFacts", "canonicalBlock"], "properties": { "maximumSelectedFacts": { "type": "integer", "minimum": 1 }, "canonicalBlock": { "const": "kernel-materialized" } }, "additionalProperties": false },
    "model": { "type": "object", "required": ["mode", "outputSchema"], "properties": { "mode": { "enum": ["never", "optional", "required"] }, "outputSchema": { "const": "world-model-composition-candidate-v1" } }, "additionalProperties": false },
    "budgets": { "type": "object", "required": ["maximumInputTokens", "maximumOutputTokens"], "properties": { "maximumInputTokens": { "type": "integer", "minimum": 1 }, "maximumOutputTokens": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "risk": { "type": "object", "required": ["class"], "properties": { "class": { "enum": ["low", "medium", "high"] } }, "additionalProperties": false },
    "validity": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["active", "revoked"] } }, "additionalProperties": false }, "contractSha256": { "$ref": "#/$defs/hash" }
  }, "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "factType": { "enum": ["file-exists", "language-detected", "symbol-exists", "symbol-index", "signature", "export", "import-dependency", "dependency-edge", "dependency-analysis", "configuration-object", "changed-symbol", "contract-change", "test-impact", "structural-impact", "runtime-frequency", "interface", "implementation", "consumer-dependency", "schema-contract", "protocol-field", "runtime-guarantee", "change-frequency", "dependency-degree", "complexity-metric", "incident-mapping", "ownership-concentration", "rule-definition", "condition-expression", "clause-binding", "test-identity", "maintainer-record", "business-glossary", "business-meaning"] },
    "factTypes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/factType" } }
  }, "additionalProperties": false
}
