{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/capabilities.schema.json",
  "title": "Singularity Flow capability tree",
  "type": "object",
  "required": [
    "version",
    "capabilities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "description": "Structural responsibility: collections group capabilities; deliveries ship from repositories.",
            "enum": [
              "collection",
              "delivery"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "owns": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "policy": {
            "type": "object",
            "properties": {
              "gateSeverity": {
                "enum": [
                  "off",
                  "warn",
                  "block"
                ]
              },
              "approvalMinimum": {
                "type": "integer",
                "minimum": 1
              },
              "allowSelfApproval": {
                "type": "boolean"
              },
              "maxDocumentBytes": {
                "type": "integer",
                "minimum": 1
              },
              "allowedPhases": {
                "$ref": "#/$defs/stringSet"
              },
              "requiredChecks": {
                "$ref": "#/$defs/stringSet"
              },
              "requiredAuthorityGroups": {
                "$ref": "#/$defs/stringSet"
              },
              "jiraProjects": {
                "$ref": "#/$defs/stringSet"
              },
              "jiraHosts": {
                "$ref": "#/$defs/stringSet"
              },
              "jiraOperations": {
                "$ref": "#/$defs/stringSet"
              },
              "jiraFields": {
                "$ref": "#/$defs/stringSet"
              },
              "protectedPaths": {
                "$ref": "#/$defs/stringSet"
              },
              "worldModelGrounding": {
                "enum": [
                  "off",
                  "warn",
                  "enforce"
                ]
              },
              "worldModelStaleness": {
                "enum": [
                  "ignore",
                  "warn",
                  "fail"
                ]
              },
              "requiredWorldModelViews": {
                "$ref": "#/$defs/stringSet"
              },
              "writeScopes": {
                "$ref": "#/$defs/stringSet"
              },
              "qualityCommands": {
                "$ref": "#/$defs/stringSet"
              },
              "storageProviders": {
                "$ref": "#/$defs/stringSet"
              },
              "allowedMimeTypes": {
                "$ref": "#/$defs/stringSet"
              },
              "tokenBudget": {
                "type": "integer",
                "minimum": 1
              },
              "gitPublication": {
                "enum": [
                  "off",
                  "warn",
                  "required"
                ]
              },
              "contextBoundary": {
                "enum": [
                  "keep",
                  "compact",
                  "new"
                ]
              },
              "contextMaxBytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "type": {
            "description": "Optional domain classification, separate from the collection/delivery structural kind.",
            "enum": [
              "tech",
              "business"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "description": "Single-repository shorthand. Reads the same as a one-entry repositories list.",
            "type": "string",
            "minLength": 1
          },
          "repositories": {
            "description": "Every repository this capability ships from.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "leadRepository": {
            "description": "Which of them holds this capability's governed state and world model.",
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "description": "Organisation-defined key/value attributes such as application ID, cost centre, owner code, or service tier.",
            "type": "object",
            "propertyNames": { "minLength": 1 },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "documentation": {
            "description": "Confluence pages, design docs, anything written about this capability. Free-form key/value, because every organisation names these differently.",
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "resources": {
            "description": "Cloud accounts, dashboards, queues \u2014 anything it runs on or against. Free-form key/value, because every organisation names these differently.",
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "collection" } },
              "required": ["kind"]
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["repository"] },
                  { "required": ["repositories"] },
                  { "required": ["leadRepository"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "delivery" } },
              "required": ["kind"]
            },
            "then": {
              "anyOf": [
                { "required": ["repository"] },
                {
                  "required": ["repositories"],
                  "properties": { "repositories": { "minItems": 1 } }
                }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
