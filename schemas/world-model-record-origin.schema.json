{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/world-model-record-origin.schema.json",
  "title": "FWM record origin",
  "type": "object",
  "required": ["schemaVersion", "kind", "originClass", "sourceRef", "producerRef", "validationRef", "limitations", "originSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "world-model-record-origin" },
    "originClass": { "enum": ["parsed", "declared", "signed", "computed"] },
    "sourceRef": { "$ref": "#/$defs/hash" },
    "producerRef": { "type": "string", "minLength": 1 },
    "validationRef": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "originSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
  "additionalProperties": false
}
