{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/calm/enforcement-control-v1.json",
  "title": "Singularity Flow governed-path enforcement",
  "type": "object",
  "additionalProperties": false,
  "required": ["control-id", "enforced-by", "gate-id", "mode", "policy-sha256", "paths"],
  "properties": {
    "control-id": { "const": "protected-configuration" },
    "enforced-by": { "const": "singularity-flow" },
    "gate-id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["hard", "advisory"] },
    "policy-sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
