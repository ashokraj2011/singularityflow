{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.invalid/singularity-flow/world-model-source-snapshot.schema.json",
  "title": "WMB v4 exact source snapshot", "type": "object",
  "required": ["schemaVersion", "kind", "subject", "revision", "files", "lineEndingPolicy", "pathNormalization", "sourceManifestSha256"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "world-model-source-snapshot" },
    "subject": { "type": "object", "required": ["kind", "id"], "properties": { "kind": { "const": "repository" }, "id": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "revision": { "type": "object", "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/git" }, "tree": { "$ref": "#/$defs/git" } }, "additionalProperties": false },
    "authority": { "type": "object", "required": ["kind", "repositorySha256", "baseRevision", "scopeManifestSha256", "candidateSha256"], "properties": { "kind": { "const": "candidate-snapshot" }, "repositorySha256": { "$ref": "#/$defs/hash" }, "baseRevision": { "type": "object", "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/git" }, "tree": { "$ref": "#/$defs/git" } }, "additionalProperties": false }, "scopeManifestSha256": { "$ref": "#/$defs/hash" }, "candidateSha256": { "$ref": "#/$defs/hash" } }, "additionalProperties": false },
    "files": { "type": "array", "items": { "type": "object", "required": ["path", "type", "mode", "contentSha256", "bytes"], "properties": { "path": { "$ref": "#/$defs/path" }, "type": { "enum": ["regular", "symlink"] }, "mode": { "enum": ["100644", "100755", "120000"] }, "contentSha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 0 }, "objectId": { "$ref": "#/$defs/git" } }, "additionalProperties": false } },
    "lineEndingPolicy": { "const": "preserve-source" }, "pathNormalization": { "const": "posix-relative" }, "sourceManifestSha256": { "$ref": "#/$defs/hash" }
  }, "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "git": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" } }, "additionalProperties": false
}
