{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/singularity-flow/smart-init-policy.schema.json",
  "title": "Accepted smart initialization policy",
  "type": "object",
  "required": ["schemaVersion", "preset", "delivery", "proof", "governance", "capability", "commands", "acceptedProtections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "preset": { "type": "object", "required": ["id", "version"] },
    "delivery": { "type": "object", "required": ["allowedModes", "defaultMode", "workflowProfile", "executionPace"] },
    "proof": { "type": "object", "required": ["profile", "readiness", "gaps"] },
    "governance": { "type": "object", "required": ["preset"] },
    "capability": { "type": "object", "required": ["id", "mode"] },
    "commands": { "type": "object", "required": ["verification", "quality", "build"] },
    "acceptedProtections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
