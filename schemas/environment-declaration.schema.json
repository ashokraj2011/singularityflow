{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularity-flow.dev/schemas/environment-declaration.schema.json",
  "title": "Singularity Flow execution-environment declaration v1",
  "type": "object",
  "required": ["schemaVersion", "environments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/environment" }
    },
    "checks": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["environment"],
        "properties": { "environment": { "$ref": "#/$defs/id" } },
        "additionalProperties": false
      }
    },
    "neverCommit": { "$ref": "#/$defs/globs" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^(?=.{1,64}$)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "variable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "glob": { "type": "string", "minLength": 1, "maxLength": 256 },
    "globs": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": { "$ref": "#/$defs/glob" }
    },
    "secret": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/variable" },
        "kind": { "const": "secret" }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/variable" },
        "kind": { "const": "endpoint" },
        "value": {
          "type": "string", "format": "uri", "maxLength": 2048,
          "pattern": "^https?://(?![^/?#]*@)[^?#]+$"
        }
      },
      "additionalProperties": false
    },
    "flag": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/variable" },
        "kind": { "const": "flag" },
        "default": {
          "oneOf": [
            { "type": "string", "maxLength": 256, "pattern": "^[^\\u0000]*$" },
            { "type": "boolean" },
            { "type": "number" }
          ]
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "oneOf": [
        { "$ref": "#/$defs/secret" },
        { "$ref": "#/$defs/endpoint" },
        { "$ref": "#/$defs/flag" }
      ]
    },
    "environment": {
      "type": "object",
      "required": ["requires"],
      "properties": {
        "requires": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "localFiles": { "$ref": "#/$defs/globs" }
      },
      "additionalProperties": false
    }
  }
}
